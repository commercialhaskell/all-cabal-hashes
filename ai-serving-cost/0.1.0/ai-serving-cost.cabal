cabal-version:      2.2
name:               ai-serving-cost
version:            0.1.0
synopsis:           Restate an AI API bill from tokens, rates, and cache share
description:
  An API bill is a token count times a rate, minus whatever the cache
  knocks off, plus a per-request floor. These functions compute that
  math directly: price a single request from its input and output
  tokens, price the cache discount at a given volume, and scale a
  per-request cost to a 30-day monthly bill. An audit can restate the
  invoice line by line instead of trusting the provider's summary.
  .
  Companion to Pastagi, which publishes AI cost audits and serving
  math. Five pure functions, no dependencies beyond base.
license:            MIT
author:             Poket Dev
maintainer:         hello@poketdev.com
homepage:           https://pastagi.com
bug-reports:        https://github.com/scrapertweeter3-prog/ai-serving-cost-hs/issues
copyright:          2026 Poket Dev LLC
category:           Math
build-type:         Simple
extra-doc-files:    README.md
                  , CHANGELOG.md

source-repository head
  type:     git
  location: https://github.com/scrapertweeter3-prog/ai-serving-cost-hs

library
  exposed-modules:  AiServing.Cost
  hs-source-dirs:   src
  build-depends:    base >=4 && <5
  default-language: Haskell2010
  ghc-options:      -Wall
