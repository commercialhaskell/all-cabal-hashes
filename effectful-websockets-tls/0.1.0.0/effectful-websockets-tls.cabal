cabal-version:   3.12
name:            effectful-websockets-tls
version:         0.1.0.0
synopsis:        The WebSocket effect of effectful-websockets, over TLS too
description:
  Interpreters for the WebSocket effect of effectful-websockets that open
  secure WebSockets, through streamly-websockets-tls. A package apart, so
  that programs that only speak in clear need not build a TLS stack.

homepage:        https://github.com/GuillaumedeVolpiano/effectful-websockets-tls
license:         BSD-3-Clause
license-file:    LICENSE
author:          Xavier Dectot
maintainer:      Xavier Dectot <xavier@wheredoibegin.fr>
category:        Network, Web, Control
build-type:      Simple
tested-with:     GHC ==9.8.4 || ==9.10.3 || ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  test/fixtures/README.md
  test/fixtures/localhost-cert.pem
  test/fixtures/localhost-key.pem

source-repository head
  type:     git
  location: https://github.com/GuillaumedeVolpiano/effectful-websockets-tls.git

common shared
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies
    DisambiguateRecordFields
    DuplicateRecordFields
    ExplicitNamespaces
    GADTs
    LambdaCase
    MonoLocalBinds
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    RoleAnnotations
    TypeFamilies

  ghc-options:
    -Wall -Wcompat -Wredundant-constraints -Wmissing-deriving-strategies
    -Wunused-packages

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Effectful.WebSocket.Client.TLS
  build-depends:
    , base                     >=4.19 && <4.22
    , bytestring               ^>=0.12
    , effectful-core           ^>=2.7.1
    , effectful-websockets       ^>=0.1
    , streamly-core            ^>=0.3.3
    , streamly-http            ^>=0.1
    , streamly-network-tls     ^>=0.1
    , streamly-websockets      ^>=0.1
    , streamly-websockets-tls  ^>=0.1
    , tls                      ^>=2.5

test-suite effectful-websockets-tls-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , async                     ^>=2.2
    , base
    , bytestring
    , effectful-core
    , effectful-websockets
    , effectful-websockets-tls
    , network                   ^>=3.2
    , streamly-core
    , streamly-websockets
    , streamly-websockets-tls
    , tasty                     ^>=1.5
    , tasty-hunit               ^>=0.10
