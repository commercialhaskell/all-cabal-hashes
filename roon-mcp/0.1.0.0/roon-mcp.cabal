cabal-version:   3.12
name:            roon-mcp
version:         0.1.0.0
synopsis:        An MCP server that plays music on Roon
description:
  A Model Context Protocol server, over stdio, that lets an assistant play
  music on a Roon system: list the zones and their queues, search and
  browse the library, queue or play tracks, albums, playlists and radios,
  control playback, volume and playback options, move what plays to
  another zone, and fetch images such as covers. Built on roon-api and
  effectful-mcp. Not affiliated with Roon Labs.

homepage:        https://github.com/GuillaumedeVolpiano/roon_mcp
license:         BSD-3-Clause
license-file:    LICENSE
author:          Xavier Dectot
maintainer:      Xavier Dectot <xavier@wheredoibegin.fr>
category:        Sound, AI
build-type:      Simple
tested-with:     GHC ==9.8.4 || ==9.10.3 || ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://github.com/GuillaumedeVolpiano/roon_mcp.git

common shared
  default-language: GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies
    DisambiguateRecordFields
    DuplicateRecordFields
    ExplicitNamespaces
    GADTs
    LambdaCase
    MonoLocalBinds
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    RoleAnnotations

  ghc-options:
    -Wall -Wcompat -Wredundant-constraints -Wmissing-deriving-strategies
    -Wunused-packages

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    RoonMcp.Plan
    RoonMcp.Tools

  other-modules:   Paths_roon_mcp
  autogen-modules: Paths_roon_mcp

  build-depends:
    , aeson          ^>=2.3
    , base           >=4.19 && <4.22
    , effectful      ^>=2.7
    , effectful-core ^>=2.7.1
    , effectful-mcp    ^>=0.1
    , roon-api           ^>=0.1
    , streamly-core  ^>=0.3.3
    , text           ^>=2.1
    , time           >=1.12 && <1.15

executable roon-mcp
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , base
    , effectful
    , effectful-mcp
    , roon-api
    , roon-mcp
    , text

test-suite roon-mcp-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , aeson
    , base
    , effectful
    , effectful-core
    , effectful-mcp
    , roon-api
    , roon-mcp
    , tasty          ^>=1.5
    , tasty-hunit    ^>=0.10
    , text
