cabal-version: 3.12
name: unkai
version: 0.1.0.1
synopsis: Google Cloud client runtime: authentication, environment and HTTP.
description:
  Request, response and authentication logic for communicating with Google
  Cloud APIs using the types supplied by the generated @unkai-*@ service
  libraries (for example @unkai-storage@).
  .
  Unkai is a maintained fork of <https://github.com/brendanhay/gogol gogol>.

homepage: https://github.com/shinzui/unkai
bug-reports: https://github.com/shinzui/unkai/issues
license: MPL-2.0
license-file: LICENSE
author: Brendan Hay, Nadeem Bitar
maintainer: Nadeem Bitar <nadeem@gmail.com>
copyright: Copyright (c) 2015-2025 Brendan Hay, (c) 2026 Nadeem Bitar
category: Google
build-type: Simple
tested-with: ghc ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/shinzui/unkai.git
  subdir: lib/unkai

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -Wunused-packages
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies
    -fhide-source-paths
    -funbox-strict-fields

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Unkai
    Unkai.Auth
    Unkai.Auth.ApplicationDefault
    Unkai.Auth.Scope
    Unkai.Auth.ServiceAccount
    Unkai.Auth.TokenFile
    Unkai.Compute.Metadata
    Unkai.Env

  other-modules:
    Unkai.Internal.Auth
    Unkai.Internal.Body
    Unkai.Internal.HTTP
    Unkai.Internal.Logger
    Unkai.Internal.Multipart

  build-depends:
    aeson ^>=2.2,
    base >=4.21 && <5,
    bytestring ^>=0.12,
    crypton >=1.0 && <1.1,
    crypton-x509 ^>=1.7,
    crypton-x509-store ^>=1.6,
    directory ^>=1.3,
    exceptions ^>=0.10,
    filepath >=1.5 && <1.6,
    http-client ^>=0.7,
    http-client-tls ^>=0.4,
    http-media ^>=0.8,
    http-types ^>=0.12,
    lens ^>=5.3,
    memory ^>=0.18,
    mime-types ^>=0.1,
    mtl ^>=2.3,
    resourcet ^>=1.3,
    streamly-core ^>=0.3,
    text ^>=2.1,
    time >=1.12 && <1.15,
    unix,
    unkai-core ^>=0.1.0.1,

test-suite unkai-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    Test.Unkai.MockServer
    Test.Unkai.Streaming

  ghc-options: -threaded
  build-depends:
    aeson,
    base >=4.21 && <5,
    bytestring,
    directory,
    filepath,
    generic-lens,
    http-client,
    http-types,
    lens,
    resourcet,
    streamly-core,
    tasty,
    tasty-hunit,
    text,
    unix,
    unkai,
    unkai-storage,
    unordered-containers,
    wai,
    warp,
