cabal-version:   3.12
name:            streamly-http-tls
version:         0.1.0.0
synopsis:        Fetch http and https URLs with Streamly
description:
  The convenient face of streamly-http: give a URL, get the response. The
  scheme chooses between plain TCP and TLS (through streamly-network-tls),
  and redirects are followed.

homepage:        https://github.com/GuillaumedeVolpiano/streamly-http-tls
license:         BSD-3-Clause
license-file:    LICENSE
author:          Xavier Dectot
maintainer:      Xavier Dectot <xavier@wheredoibegin.fr>
category:        Network, Web, Streamly
build-type:      Simple
tested-with:     GHC ==9.8.4 || ==9.10.3 || ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  test/fixtures/README.md
  test/fixtures/localhost-cert.pem
  test/fixtures/localhost-key.pem

source-repository head
  type:     git
  location: https://github.com/GuillaumedeVolpiano/streamly-http-tls.git

common shared
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies
    DisambiguateRecordFields
    DuplicateRecordFields
    ExplicitNamespaces
    GADTs
    LambdaCase
    MonoLocalBinds
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    RoleAnnotations

  ghc-options:
    -Wall -Wcompat -Wredundant-constraints -Wmissing-deriving-strategies
    -Wunused-packages

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Streamly.External.Network.HTTP.TLS
  build-depends:
    , base                  >=4.19 && <4.22
    , bytestring            ^>=0.12
    , streamly-core         ^>=0.3.3
    , streamly-http         ^>=0.1
    , streamly-network-tls  ^>=0.1

test-suite streamly-http-tls-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , async                 ^>=2.2
    , base
    , bytestring
    , network               ^>=3.2
    , streamly-bytestring   ^>=0.2.3
    , streamly-core
    , streamly-http
    , streamly-http-tls
    , streamly-network-tls
    , tasty                 ^>=1.5
    , tasty-hunit           ^>=0.10
    , tls                   ^>=2.5
