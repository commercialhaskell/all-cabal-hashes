cabal-version: 3.0
name: polytropos-rel8
version: 0.1.0.2
synopsis: rel8 Rel8able table schemas and queries over polytropos open rows
description:
  High-level type-safe PostgreSQL database mapping connecting <https://hackage.haskell.org/package/polytropos polytropos> open rows
  to Oliver Charles' <https://hackage.haskell.org/package/rel8 rel8> framework.

  Exposes 'Polytropos.Rel8.PolyRow', a higher-kinded 'Rel8.Rel8able' schema representation whose columns
  are derived directly from the row's type-level field specification into an @HProduct@
  tree. Conversions between @rel8@'s columnar representation and the flat 'Data.Primitive.SmallArray.SmallArray'
  payload execute slot-by-slot in row order without intermediate tuples or arity limits.

  Start at the front door module "Polytropos.Rel8" for complete documentation,
  schema definitions, and worked query examples.
license: EUPL-1.2 OR Apache-2.0
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Database, PostgreSQL
homepage: https://github.com/NadiaYvette/polytropos
bug-reports: https://github.com/NadiaYvette/polytropos/issues
extra-doc-files:
    README.md
  , CHANGELOG.md
build-type: Simple

source-repository head
  type:     git
  location: https://github.com/NadiaYvette/polytropos
  subdir:   packages/polytropos-rel8

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.Rel8
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    primitive >= 0.7 && < 0.10,
    text >= 1.2 && < 2.2,
    rel8 >= 1.8 && < 1.9,
    rel8-internal >= 1.8 && < 1.9,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2

test-suite polytropos-rel8-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -fplugin=Polytropos.Plugin
  build-depends:
    base,
    primitive,
    text,
    rel8,
    rel8-internal,
    polytropos-core,
    polytropos-rel8,
    polytropos-plugin,
    tasty,
    tasty-hunit
