cabal-version: 3.0
name: polytropos-quickcheck
version: 0.1.0.2
synopsis: QuickCheck generators and slot-indexed shrinkers for polytropos open rows
description:
  Property-based testing integration connecting <https://hackage.haskell.org/package/polytropos polytropos> open records and variants
  to <https://hackage.haskell.org/package/QuickCheck QuickCheck>.

  Provides 'Test.QuickCheck.Arbitrary' instances for 'Polytropos.Record' and 'Polytropos.Variant': records generate values
  heterogeneously via 'Polytropos.Core.AllFields' and shrink slot-by-slot (avoiding Cartesian product blowup);
  variants pick uniformly across constructor tags and shrink strictly within the active
  constructor branch.

  Start at the front door module "Polytropos.QuickCheck" for complete documentation,
  shrink semantics, and worked examples.
license: EUPL-1.2 OR Apache-2.0
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Testing
homepage: https://github.com/NadiaYvette/polytropos
bug-reports: https://github.com/NadiaYvette/polytropos/issues
extra-doc-files:
    README.md
  , CHANGELOG.md
build-type: Simple

source-repository head
  type:     git
  location: https://github.com/NadiaYvette/polytropos
  subdir:   packages/polytropos-quickcheck

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.QuickCheck
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    QuickCheck >= 2.14 && < 2.19,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2

test-suite polytropos-quickcheck-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -fplugin=Polytropos.Plugin
  build-depends:
    base,
    QuickCheck,
    polytropos-core,
    polytropos-quickcheck,
    polytropos-plugin,
    tasty,
    tasty-hunit
