    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-tool-depends:
    hspec-discover:hspec-discover >=2.10 && <3

  build-depends:
    hspec >=2.10 && <3,
    megaparsec >=9.2 && <10,
    postgresql-syntax:internal,
    QuickCheck >=2.17 && <3,
