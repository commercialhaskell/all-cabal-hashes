benchmark keyword-bench
  import: base-settings
  type: exitcode-stdio-1.0
  hs-source-dirs:
    bench

  main-is: Main.hs
  ghc-options: -O2
  build-depends:
    containers >=0.4 && <1,
    criterion >=1.6 && <1.7,
    headed-megaparsec >=0.2.0.1 && <0.3,
    megaparsec >=9.2 && <10,
    postgresql-syntax,
    QuickCheck >=2.17 && <3,
    rerebase >=1.6.1 && <2,

benchmark nesting-bench
  import: base-settings
  type: exitcode-stdio-1.0
  hs-source-dirs: nesting-bench
  main-is: Main.hs
  ghc-options:
    -O2
    -threaded

  build-depends:
    clock >=0.8 && <1,
    postgresql-syntax,
    rerebase >=1.6.1 && <2,
