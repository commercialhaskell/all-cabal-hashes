    base >=4.12 && <5,
    bytestring >=0.10 && <0.13,
    case-insensitive >=1.2.1 && <2,
    hashable >=1.3.5 && <2,
    headed-megaparsec >=0.2.0.1 && <0.3,
    megaparsec >=9.2 && <10,
    parser-combinators >=1.3 && <1.4,
    QuickCheck >=2.17 && <3,
    text >=1 && <3,
    text-builder >=1 && <1.1,
    unordered-containers >=0.2.16 && <0.3,

