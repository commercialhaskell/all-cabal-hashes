cabal-version: 2.4
name: virustotal
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
synopsis: A simple Haskell client for the VirusTotal API
description:
  A small VirusTotal API client using ordinary records and explicit IO functions.
  Includes IP reputation response types and JSON parsing.
  Supports IP report requests with explicit error handling.
category: Network
author: Joonkyu Park
maintainer: vpark45@gmail.com
homepage: https://github.com/nattybear/virustotal
bug-reports: https://github.com/nattybear/virustotal/issues
build-type: Simple
tested-with: GHC == 9.8.4
extra-source-files: README.md, CHANGELOG.md, .stylish-haskell.yaml

source-repository head
  type: git
  location: https://github.com/nattybear/virustotal.git

library
  exposed-modules: VirusTotal
  hs-source-dirs: src
  build-depends:
    base >= 4.19 && < 5,
    aeson >= 2.1 && < 2.3,
    text >= 2.1 && < 2.2,
    http-client >= 0.7 && < 0.8,
    http-client-tls >= 0.3 && < 0.4,
    http-types >= 0.12 && < 0.13,
    iproute >= 1.7 && < 1.8
  default-language: Haskell2010
  ghc-options: -Wall


test-suite virustotal-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules: HttpTests
  hs-source-dirs: test
  build-depends:
    base >= 4.19 && < 5,
    aeson >= 2.1 && < 2.3,
    virustotal,
    bytestring >= 0.12 && < 0.13,
    http-client >= 0.7 && < 0.8,
    http-types >= 0.12 && < 0.13,
    wai >= 3.2 && < 3.3,
    warp >= 3.3 && < 3.5
  default-language: Haskell2010
  ghc-options: -Wall -threaded
