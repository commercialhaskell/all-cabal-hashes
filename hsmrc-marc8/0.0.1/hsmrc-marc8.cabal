cabal-version:      >=1.10
name:               hsmrc-marc8
version:            0.0.1
synopsis:           MARC-8 charset decoding library for hsmrc
license:            BSD3
license-file:       LICENSE
copyright:          2026
author:             NatLibFi Brunberg J
homepage:           https://codeberg.org/brunberg/hsmrc-marc8/
category:           Data
build-type:         Simple
extra-source-files: Changelog.md

library
  hs-source-dirs:   src
  build-depends:
                    base >= 4.13.0 && < 4.20,
                    bytestring >= 0.10.10 && < 0.13,
                    utf8-string >= 1.0.2 && < 1.1,
                    hsmrc >= 0.1.5 && < 0.2
  ghc-options:      -Wall
  exposed-modules:  Data.Marc21.MARC8
  other-modules:
                    Data.Marc21.MARC8.ANSEL
                    Data.Marc21.MARC8.EACC
                    Data.Marc21.MARC8.Arabic
                    Data.Marc21.MARC8.Cyrillic
                    Data.Marc21.MARC8.Greek
                    Data.Marc21.MARC8.Hebrew
                    Data.Marc21.MARC8.LegacySets
                    Data.Marc21.MARC8.Helpers
  default-language: Haskell2010
