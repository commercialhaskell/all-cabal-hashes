cabal-version: 3.12
-- SPDX-FileCopyrightText: 2026 Progmasoft <support@progmasoft.com>
-- SPDX-License-Identifier: MPL-2.0 WITH AdditionRef-Progmasoft-Exception-1.1
name: tala-syntax
version: 0.1.0
synopsis: Tala source model, lexer, parser, and diagnostics
description:
    The source model of Tala: source text and positions, the lexer, the
    parser, the parsed syntax tree and diagnostics.
    .
    This is an implementation package of the Tala compiler. Its modules may
    change in any release; tools should depend on tala-tooling instead.
    .
    The source is also offered under the Progmasoft Linking Exception 1.1
    (LICENSE-EXCEPTION), an additional permission to MPL-2.0 for works that
    combine this package with independent code.
license: MPL-2.0
license-files:
    LICENSE
    LICENSE-EXCEPTION
author: Progmasoft
maintainer: support@progmasoft.com
homepage: https://tala.run/
bug-reports: https://github.com/Progmasoft/tala/issues
category: Language, Compiler
tested-with: GHC ==9.10.3
build-type: Simple

library
    exposed-modules:
        Progmasoft.Tala.AST
        Progmasoft.Tala.CharacterLiteral
        Progmasoft.Tala.Diagnostic
        Progmasoft.Tala.Diagnostic.Protocol
        Progmasoft.Tala.FloatingLiteral
        Progmasoft.Tala.Lexer
        Progmasoft.Tala.Completion
        Progmasoft.Tala.NestingLimits
        Progmasoft.Tala.NumericLiteral
        Progmasoft.Tala.Parser
        Progmasoft.Tala.RuntimeCall
        Progmasoft.Tala.SourceText
        Progmasoft.Tala.SourceWarnings
    other-modules:
        Progmasoft.Tala.Parser.Cursor
        Progmasoft.Tala.Parser.Match
        Progmasoft.Tala.Parser.Token
    hs-source-dirs: src
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.12 && <0.14
    default-language: GHC2024

source-repository head
    type: git
    location: https://github.com/Progmasoft/tala
    subdir: Talac/Haskell/Syntax
