cabal-version:      2.4
name:               ajmd
version:            0.0.1
synopsis:           Markdown that is data
description:        One language that people read, agents write and code parses. Placeholder; the first release is in preparation.
homepage:           https://github.com/simplex-chat/ajmd
bug-reports:        https://github.com/simplex-chat/ajmd/issues
license:            MIT
license-file:       LICENSE
author:             SimpleX Chat
maintainer:         chat@simplex.chat
copyright:          2026 SimpleX Chat
category:           Text, Data
build-type:         Simple
extra-doc-files:    README.md

source-repository head
  type:     git
  location: https://github.com/simplex-chat/ajmd
  subdir:   haskell

library
  exposed-modules:  Data.Ajmd
  hs-source-dirs:   src
  build-depends:    base >=4.14 && <5
  default-language: Haskell2010
