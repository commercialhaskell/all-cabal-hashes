cabal-version:      3.0
name:               mc
version:            0.1.0.0
synopsis:           Master of Ceremonies
homepage:           https://github.com/dopamane/mc
license:            MIT
license-file:       LICENSE
author:             dopamane
maintainer:         dwc1295@gmail.com
copyright:          David Cox
category:           Concurrency
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md

library
  default-language: Haskell2010
  ghc-options:      -Wall -O2
  hs-source-dirs:   lib
  exposed-modules:  Control.Concurrent.MC
  build-depends:
    async,
    base < 5,
    stm

executable mc
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded
  hs-source-dirs:   exe
  main-is:          Main.hs
  other-modules:    Paths_mc
  autogen-modules:  Paths_mc
  build-depends:
    base < 5,
    optparse-applicative,
    process,
    mc,
    stm
