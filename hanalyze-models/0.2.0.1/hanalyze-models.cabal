  build-depends:
      base                 >= 4.14 && < 5
    , containers           >= 0.6  && < 0.8
    , hmatrix              >= 0.20 && < 0.22
    , mwc-random           >= 0.15 && < 0.16
    , primitive            >= 0.7  && < 0.10
    , statistics           >= 0.16 && < 0.17
    , text                 >= 1.2  && < 2.2
    , vector               >= 0.12 && < 0.14
    , dataframe-core        ^>= 1.1
    , vector-algorithms    >= 0.9  && < 0.10
    , megaparsec           >= 9.0  && < 9.7
    , parser-combinators   >= 1.3  && < 1.4
    , hanalyze-core == 0.2.0.1
    , hanalyze-frame == 0.2.0.1
    , hanalyze-bayes == 0.2.0.1
