cabal-version: 3.0
name: polytropos-aeson
version: 0.1.0.2
synopsis: High-performance aeson JSON codecs for polytropos open records and variants
description:
  Linear O(N) 'Data.Aeson.ToJSON' and 'Data.Aeson.FromJSON' serialization codecs for
  <https://hackage.haskell.org/package/polytropos polytropos> open records and variants
  via <https://hackage.haskell.org/package/aeson aeson>.

  Unlike "GHC.Generics" which builds intermediate binary tree nodes during serialization,
  @polytropos-aeson@ unrolls the flat contiguous 'Data.Primitive.SmallArray.SmallArray' payload
  directly into a JSON object and back. Variants serialize into tagged JSON objects with O(1) tag dispatch.

  Start at the front door module "Polytropos.Aeson" for complete documentation,
  codec options, and worked examples.
license: EUPL-1.2 OR Apache-2.0
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Data, JSON
homepage: https://github.com/NadiaYvette/polytropos
bug-reports: https://github.com/NadiaYvette/polytropos/issues
extra-doc-files:
    README.md
  , CHANGELOG.md
build-type: Simple

source-repository head
  type:     git
  location: https://github.com/NadiaYvette/polytropos
  subdir:   packages/polytropos-aeson

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.Aeson
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    aeson >= 2.0 && < 2.3,
    bytestring >= 0.10 && < 0.13,
    text >= 1.2 && < 2.2,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2

test-suite polytropos-aeson-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -fplugin=Polytropos.Plugin
  build-depends:
    base,
    aeson,
    bytestring,
    text,
    polytropos-core,
    polytropos-aeson,
    polytropos-plugin,
    tasty,
    tasty-hunit
