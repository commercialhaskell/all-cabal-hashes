cabal-version:      2.4
name:               ntfs
version:            0.1.0.1
synopsis:           Pure Haskell library for reading NTFS disk images
description:
  Low-level parsers for NTFS volume geometry, MFT records, attributes and
  runlists, with a high-level file system API built on top.

license:            BSD-3-Clause
license-file:       LICENSE
author:             Joonkyu Park
maintainer:         vpark45@gmail.com
homepage:           https://github.com/nattybear/ntfs
bug-reports:        https://github.com/nattybear/ntfs/issues
category:           System
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md

source-repository head
  type:              git
  location:          https://github.com/nattybear/ntfs

library
  exposed-modules:    NTFS
                      NTFS.Attribute.Data
                      NTFS.Attribute.FileName
                      NTFS.Attribute.StandardInformation
                      NTFS.BootSector
                      NTFS.MFT.Attribute
                      NTFS.MFT.Record
                      NTFS.Runlist
                      NTFS.Types
                      NTFS.Volume
  hs-source-dirs:     src
  build-depends:      base       >= 4.14 && < 5
                    , bytestring >= 0.10 && < 0.13
  default-language:   Haskell2010
  ghc-options:        -Wall

test-suite ntfs-test
  type:               exitcode-stdio-1.0
  main-is:            Spec.hs
  hs-source-dirs:     test
  build-depends:      base       >= 4.14 && < 5
                    , bytestring >= 0.10 && < 0.13
                    , directory  >= 1.3  && < 1.4
                    , ntfs
  default-language:   Haskell2010
  ghc-options:        -Wall
