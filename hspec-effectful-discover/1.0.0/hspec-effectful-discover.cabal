license-file: LICENCE
author: IDA
maintainer: IDA
homepage: https://digital-autonomy.institute
bug-reports: https://issues.digital-autonomy.institute
build-type: Simple
extra-doc-files:
  CHANGELOG.md

executable hspec-effectful-discover
  default-language: Haskell2010
  default-extensions:
    BlockArguments
    LambdaCase

  hs-source-dirs: .
  main-is: Main.hs
  build-depends:
    base >=4.16 && <5,
    directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6,
