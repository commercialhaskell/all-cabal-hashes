cabal-version:   3.12
name:            streamly-websockets-tls
version:         0.1.0.0
synopsis:        Secure WebSockets, and WebSockets by URL, with Streamly
description:
  The convenient face of streamly-websockets: open a WebSocket from its
  URL, the scheme (ws or wss) choosing between plain TCP and TLS through
  streamly-network-tls, and serve WebSockets over TLS.

homepage:        https://github.com/GuillaumedeVolpiano/streamly-websockets-tls
license:         BSD-3-Clause
license-file:    LICENSE
author:          Xavier Dectot
maintainer:      Xavier Dectot <xavier@wheredoibegin.fr>
category:        Network, Web, Streamly
build-type:      Simple
tested-with:     GHC ==9.8.4 || ==9.10.3 || ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  test/fixtures/README.md
  test/fixtures/localhost-cert.pem
  test/fixtures/localhost-key.pem

source-repository head
  type:     git
  location: https://github.com/GuillaumedeVolpiano/streamly-websockets-tls.git

common shared
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies
    DisambiguateRecordFields
    DuplicateRecordFields
    ExplicitNamespaces
    GADTs
    LambdaCase
    MonoLocalBinds
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    RoleAnnotations

  ghc-options:
    -Wall -Wcompat -Wredundant-constraints -Wmissing-deriving-strategies
    -Wunused-packages

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Streamly.External.Network.WebSocket.TLS
  build-depends:
    , base                  >=4.19 && <4.22
    , bytestring            ^>=0.12
    , network               ^>=3.2
    , streamly-http         ^>=0.1
    , streamly-network-tls  ^>=0.1
    , streamly-websockets   ^>=0.1

test-suite streamly-websockets-tls-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , async                    ^>=2.2
    , base
    , bytestring
    , network
    , stm                      ^>=2.5
    , streamly-core            ^>=0.3.3
    , streamly-http
    , streamly-websockets
    , streamly-websockets-tls
    , tasty                    ^>=1.5
    , tasty-hunit              ^>=0.10
    , tls                      ^>=2.5
