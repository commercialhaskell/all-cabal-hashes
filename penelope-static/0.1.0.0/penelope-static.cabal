cabal-version: 3.0
name: penelope-static
version: 0.1.0.0
synopsis: Static Reflection and Cayley Analysis for Penelope Effect Engine
description:
  Static analysis substrate and Cayley representation for the Penelope
  polycategorical effect engine. Provides effect dependency graph
  extraction, algebraic circuit simplification, pipeline scheduling,
  and formal verification of institutional satisfaction properties.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Control
homepage: https://github.com/NadiaYvette/penelope
bug-reports: https://github.com/NadiaYvette/penelope/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with: GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/penelope
  subdir: packages/penelope-static

library
  exposed-modules:
    Penelope.Static
    Penelope.Static.Analysis
  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    AllowAmbiguousTypes
    BangPatterns
    DataKinds
    DerivingStrategies
    FlexibleContexts
    GADTs
    KindSignatures
    MagicHash
    OverloadedStrings
    PolyKinds
    RankNTypes
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators
    UnboxedTuples
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    primitive >= 0.9 && < 0.10,
    polytropos-core >= 0.1 && < 0.2,
    penelope-core >= 0.1 && < 0.2

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  default-extensions:
    AllowAmbiguousTypes
    DataKinds
    GADTs
    MagicHash
    OverloadedStrings
    PolyKinds
    RankNTypes
    TypeApplications
    TypeOperators
  ghc-options: -Wall -Wcompat -Wredundant-constraints -threaded -rtsopts
  build-depends:
    base >= 4.14 && < 5,
    hspec >= 2.10 && < 2.12,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    primitive >= 0.9 && < 0.10,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2,
    penelope-core >= 0.1 && < 0.2,
    penelope-static

test-suite properties
  type: exitcode-stdio-1.0
  main-is: Properties.hs
  hs-source-dirs: test
  default-language: Haskell2010
  default-extensions:
    AllowAmbiguousTypes
    BangPatterns
    DataKinds
    DerivingStrategies
    FlexibleContexts
    GADTs
    MagicHash
    OverloadedStrings
    PolyKinds
    RankNTypes
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators
  ghc-options: -Wall -Wcompat -Wredundant-constraints -threaded -rtsopts
  build-depends:
    base >= 4.14 && < 5,
    hspec >= 2.10 && < 2.12,
    QuickCheck >= 2.14 && < 2.16,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    primitive >= 0.9 && < 0.10,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2,
    penelope-core >= 0.1 && < 0.2,
    penelope-static
