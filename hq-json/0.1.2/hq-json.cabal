copyright:      Damian Franco Alvarez, 2026
license:        MIT
license-file:   LICENSE
build-type:     Simple
tested-with:
    GHC == 9.8.4
  , GHC == 9.10.3
extra-source-files:
    docs/LANG.md
extra-doc-files:
    README.md
    docs/LANG.md

