cabal-version: 3.0
name: gargamelle-core
version: 0.1.0.0
synopsis: Core Institution class and categorical colimits for Gargamelle
description:
  Foundational categorical macro-architecture and Institution class for
  Gargamelle. Provides universal categorical pushouts, Grothendieck
  topologies, institutional satisfaction conditions, and CEGIS loops.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Logic
homepage: https://github.com/NadiaYvette/gargamelle
bug-reports: https://github.com/NadiaYvette/gargamelle/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with:
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/gargamelle
  subdir: packages/gargamelle-core

library
  exposed-modules:
    Institution
    Gargamelle.Core.Institution
    Gargamelle.Core.Weaving
    Gargamelle.Core.Discovery
    Gargamelle.Core.Colimit
    Propositional
    SessionTypes
    Sheaf
    CEGIS
    Core.AST
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.18 && < 5,
    containers >= 0.6 && < 0.9,
    polytropos-core >= 0.1.0.1 && < 0.2,
    proarrow >= 0.2 && < 0.3,
    proarrow-equipment >= 0 && < 0.1,
    gargamelle-logic >= 0.1 && < 0.2,
    gargamelle-model >= 0.1 && < 0.2,
    lattices >= 2.2 && < 2.3,
    contravariant >= 1.5 && < 1.6

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.18 && < 5,
    gargamelle-core,
    gargamelle-logic >= 0.1 && < 0.2,
    gargamelle-model >= 0.1 && < 0.2,
    containers >= 0.6 && < 0.9,
    proarrow >= 0.2 && < 0.3,
    hspec >= 2.10 && < 2.12
