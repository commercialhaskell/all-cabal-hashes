cabal-version: 3.0
name: fluent-lint
version: 1.0.0
synopsis: Static analysis tool for validating Project Fluent translation files
description:
  A command-line tool that parses Project Fluent translation files and checks
  for syntax errors and consistency issues.

license: EUPL-1.2
license-file: LICENCE
author: IDA
maintainer: IDA
homepage: https://digital-autonomy.institute
bug-reports: https://issues.digital-autonomy.institute
category: Language
build-type: Simple
extra-doc-files:
  CHANGELOG.md

common common
  default-language: GHC2021
  ghc-options:
    -Weverything
    -Wno-all-missed-specialisations
    -Wno-missing-export-lists
    -Wno-missing-import-lists
    -Wno-missing-kind-signatures
    -Wno-missing-local-signatures
    -Wno-missing-safe-haskell-mode
    -Wno-name-shadowing
    -Wno-unsafe

  default-extensions:
    ApplicativeDo
    BlockArguments
    DerivingStrategies
    LambdaCase
    NoImplicitPrelude
    OverloadedRecordDot
    OverloadedStrings
    RecordWildCards
    ViewPatterns

executable fluent-lint
  import: common
  hs-source-dirs: app
  main-is: Main.hs
  autogen-modules:
    Paths_fluent_lint

  other-modules:
    Config
    Document
    Lint
    Paths_fluent_lint

  build-depends:
    base >=4.19 && <5,
    containers >=0.6 && <0.9,
    effectful >=2.6 && <2.7,
    fluent-syntax >=1.1 && <1.2,
    hspec-effectful >=1.1 && <1.2,
    optparse-applicative >=0.18 && <0.20,
    text >=2.1 && <2.3,
