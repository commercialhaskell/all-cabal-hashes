    directory >=1.3 && <1.4,
    process >=1.6 && <1.7,
    shomei-core ^>=0.3.0.0,
    shomei-postgres ^>=0.3.0.0,
    shomei-server ^>=0.3.0.0,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    text >=2.0 && <2.2,

