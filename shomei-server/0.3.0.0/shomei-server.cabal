    contravariant-extras >=0.3 && <0.4,
    effectful >=2.5 && <2.8,
    effectful-core >=2.5 && <2.8,
    hasql >=1.10 && <1.11,
    http-client >=0.7 && <0.8,
    http-client-tls >=0.3 && <0.5,
    jose >=0.13 && <0.14,
    optparse-applicative >=0.19 && <0.20,
