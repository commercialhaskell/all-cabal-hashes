    shomei-core ^>=0.3.0.0,
    shomei-jwt ^>=0.3.0.0,
    shomei-migrations ^>=0.2.0.1,
    shomei-migrations:test-support ^>=0.2.0.1,
    shomei-postgres ^>=0.3.0.0,
