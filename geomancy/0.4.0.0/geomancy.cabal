  hs-source-dirs:
      src
  ghc-options: -Wall
  c-sources:
      cbits/mat4.c
      cbits/dmat4.c
  build-depends:
      base >=4.7 && <5
    , containers
    , deepseq
    , gl-block
    , mono-traversable
    , ptrdiff
    , simple-affine-space
    , webcolor-labels
  default-language: Haskell2010
  if flag(th-lift)
    cpp-options: -DTH_LIFT
    build-depends:
        template-haskell
  if flag(serialise)
    cpp-options: -DSERIALISE
    build-depends:
        serialise

test-suite geomancy-test
