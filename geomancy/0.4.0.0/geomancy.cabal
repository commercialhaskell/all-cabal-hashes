  hs-source-dirs:
      test
  ghc-options: -Wall -threaded -rtsopts "-with-rtsopts=-N -qn1 -A128m"
  build-depends:
      base >=4.7 && <5
    , deepseq
    , geomancy
    , gl-block
    , hedgehog
    , linear
    , simple-affine-space
    , tasty
    , tasty-hedgehog
    , vector
  default-language: Haskell2010

benchmark geomancy-bench
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
      Bench.Common
      Bench.DMat4
      Bench.DQuaternion
      Bench.Mat4
      Bench.Quaternion
      Paths_geomancy
