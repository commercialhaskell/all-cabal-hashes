Name: libmagic
Version: 1.2
Cabal-Version: >= 1.10
License: BSD3
Maintainer: Joey Hess <id@joeyh.name>
Author: John Goerzen
Stability: Stable
Copyright: Copyright (c) 2005-2009 John Goerzen
Build-Type: Simple
license-file: COPYING
Category: Text
Synopsis: Interface to C file/magic library
Description:  This package provides a Haskell interface to the C libmagic library.
 With it, you can determine the type of a file by examining its contents
 rather than its name.  The Haskell interface provides a full-featured
 binding.
Extra-Source-Files: CHANGELOG

Library
  Extra-Libraries: magic
  Exposed-Modules:
    Magic,
    Magic.Data,
    Magic.Types,
    Magic.Init,
    Magic.Operations
  Other-Modules:
    Magic.Utils,
    Magic.TypesLL
  Build-Depends:
    base >= 3 && < 5,
    filepath >= 1.4.100 && < 1.6,
    os-string >= 2.0.0 && < 2.1,
    bytestring < 0.13
  GHC-Options: -O2 -Wall
  Default-Language: Haskell2010
  Default-Extensions: ForeignFunctionInterface, TypeSynonymInstances,
              EmptyDataDecls

source-repository head
  type: git
  location: https://git.joeyh.name/git/haskell-libmagic.git
