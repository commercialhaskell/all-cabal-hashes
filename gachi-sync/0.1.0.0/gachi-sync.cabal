cabal-version: 3.0
name: gachi-sync
version: 0.1.0.0
synopsis: Cross-repository standardization matrix and configuration synchronization for Gachi
description:
  Implements the 9-dimensional ecosystem standardization matrix (~/src/PLAN.md §1.A),
  canonical shared asset catalog, repository audit engine, and harmonic configuration
  propagation across ecosystem checkouts ('gachi sync').
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Development, Tools
build-type: Simple
tested-with:
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

library
  exposed-modules:
    Gachi.Sync
    Gachi.Sync.Audit
    Gachi.Sync.Catalog
    Gachi.Sync.CI
    Gachi.Sync.Engine
    Gachi.Sync.Hash
    Gachi.Sync.Matrix
    Gachi.Sync.Remote
    Gachi.Sync.Sheaf
    Gachi.Sync.Types
  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
    ScopedTypeVariables
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    bytestring >= 0.10,
    text >= 2.0,
    containers >= 0.6,
    directory >= 1.3,
    filepath >= 1.4,
    process >= 1.6,
    gachi-core >= 0.1,
    gachi-schema >= 0.1,
    gachi-scaffold >= 0.1

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
    ScopedTypeVariables
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints
    -threaded
  build-depends:
    base >= 4.14 && < 5,
    gachi-sync,
    gachi-core,
    gachi-schema,
    gachi-scaffold,
    bytestring >= 0.10,
    text >= 2.0,
    containers >= 0.6,
    directory >= 1.3,
    filepath >= 1.4,
    process >= 1.6,
    time >= 1.9,
    hspec >= 2.10
