cabal-version:   3.12
name:            effectful-streamly-http
version:         0.1.0.0
synopsis:        HTTP requests as an Effectful effect
description:
  An HTTP effect for Effectful: send a request, get the whole response.
  The interpreter of this package runs over streamly-http, in clear;
  effectful-streamly-http-tls adds https. An interpreter from a function
  serves tests, which then need no server.

homepage:        https://github.com/GuillaumedeVolpiano/effectful-streamly-http
license:         BSD-3-Clause
license-file:    LICENSE
author:          Xavier Dectot
maintainer:      Xavier Dectot <xavier@wheredoibegin.fr>
category:        Network, Web, Control
build-type:      Simple
tested-with:     GHC ==9.8.4 || ==9.10.3 || ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://github.com/GuillaumedeVolpiano/effectful-streamly-http.git

common shared
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies
    DisambiguateRecordFields
    DuplicateRecordFields
    ExplicitNamespaces
    GADTs
    LambdaCase
    MonoLocalBinds
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    RoleAnnotations
    TypeFamilies

  ghc-options:
    -Wall -Wcompat -Wredundant-constraints -Wmissing-deriving-strategies
    -Wunused-packages

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Effectful.HTTP
  build-depends:
    , base                 >=4.19 && <4.22
    , bytestring           ^>=0.12
    , effectful-core       ^>=2.7.1
    , streamly-bytestring  ^>=0.2.3
    , streamly-http        ^>=0.1
    , text                 ^>=2.1

test-suite effectful-streamly-http-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , async                    ^>=2.2
    , base
    , bytestring
    , effectful-core
    , effectful-streamly-http
    , network                  ^>=3.2
    , tasty                    ^>=1.5
    , tasty-hunit              ^>=0.10
