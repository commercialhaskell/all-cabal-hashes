cabal-version: 3.0
name: polytropos-persistent
version: 0.1.0.2
synopsis: persistent database marshalling and entity wrappers for polytropos
description:
  Integration bridging <https://hackage.haskell.org/package/polytropos polytropos> open records
  with the Yesod ecosystem's <https://hackage.haskell.org/package/persistent persistent> relational database library.

  Provides fast zero-tuple marshalling of records to and from @['Database.Persist.Class.PersistField.PersistValue']@ rows
  via 'Polytropos.Persistent.PersistRow' ('Polytropos.Persistent.toPersistFieldsRecord', 'Polytropos.Persistent.fromPersistValuesRecord'),
  whole-record column storage as 'Database.Persist.Class.PersistField.PersistList' via
  'Database.Persist.Class.PersistField.PersistField' and 'Database.Persist.Sql.Class.PersistFieldSql',
  and entity wrappers via 'Polytropos.Persistent.PolyRowEntity'.

  Start at the front door module "Polytropos.Persistent" for complete documentation,
  schema mappings, and worked examples.
license: EUPL-1.2 OR Apache-2.0
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Database
homepage: https://github.com/NadiaYvette/polytropos
bug-reports: https://github.com/NadiaYvette/polytropos/issues
extra-doc-files:
    README.md
  , CHANGELOG.md
build-type: Simple

source-repository head
  type:     git
  location: https://github.com/NadiaYvette/polytropos
  subdir:   packages/polytropos-persistent

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.Persistent
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    persistent >= 2.14 && < 2.19,
    text >= 1.2 && < 2.2,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2

test-suite polytropos-persistent-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -fplugin=Polytropos.Plugin
  build-depends:
    base,
    persistent,
    text,
    polytropos-core,
    polytropos-persistent,
    polytropos-plugin,
    tasty,
    tasty-hunit
