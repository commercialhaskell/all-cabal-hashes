cabal-version:   3.12
name:            effectful-mcp
version:         0.1.0.0
synopsis:        Model Context Protocol servers in Effectful
description:
  A server of the Model Context Protocol (MCP) for Effectful: declare tools
  as Eff actions, and serve them over stdio, concurrently, with
  cancellation. It speaks revision 2026-07-28 of the protocol and, to the
  clients that only know them, the earlier ones.

homepage:        https://github.com/GuillaumedeVolpiano/effectful-mcp
license:         BSD-3-Clause
license-file:    LICENSE
author:          Xavier Dectot
maintainer:      Xavier Dectot <xavier@wheredoibegin.fr>
category:        AI, Network, Control
build-type:      Simple
tested-with:     GHC ==9.8.4 || ==9.10.3 || ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://github.com/GuillaumedeVolpiano/effectful-mcp.git

common shared
  default-language: GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies
    DisambiguateRecordFields
    DuplicateRecordFields
    ExplicitNamespaces
    GADTs
    LambdaCase
    MonoLocalBinds
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    RoleAnnotations

  ghc-options:
    -Wall -Wcompat -Wredundant-constraints -Wmissing-deriving-strategies
    -Wunused-packages

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Effectful.MCP.JsonRpc
    Effectful.MCP.Server
    Effectful.MCP.Tool

  build-depends:
    , aeson              ^>=2.3
    , base               >=4.19 && <4.22
    , base64-bytestring  ^>=1.2
    , bytestring         ^>=0.12
    , containers         >=0.6.7 && <0.8
    , effectful          ^>=2.7
    , effectful-core     ^>=2.7.1
    , scientific         ^>=0.3
    , streamly-core      ^>=0.3.3
    , text               ^>=2.1

test-suite effectful-mcp-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , aeson
    , base
    , bytestring
    , effectful
    , effectful-core
    , effectful-mcp
    , stm            ^>=2.5
    , tasty          ^>=1.5
    , tasty-hunit    ^>=0.10
    , text
