cabal-version:       3.0
name:                ansiform
version:             1.1.0.0
synopsis:            Display formatting for command line interfaces.
description:         Basic format DSL for building an ANSI command line interface
                     with colors, alignment, tables, paragraphs and more.
license:             MIT
license-file:        LICENSE
author:              Tunai Raiol
maintainer:          Tralen <dev@tralen.cc>
copyright:           2018-2026 Tunai Raiol
category:            User Interfaces
homepage:            https://github.com/Tralen/ansiform
bug-reports:         https://github.com/Tralen/ansiform/issues
tested-with:         GHC == 9.2.8 || == 9.14.1
extra-doc-files:     CHANGELOG.md
                     README.md
                     docs/architecture.md
                     docs/content.md
                     docs/demo.md
                     docs/input.md
                     docs/naming.md
                     docs/number.md
                     docs/pages.md
                     docs/platforms.md
                     docs/ports.md
                     docs/printers.md
                     docs/quality.md
                     docs/releasing.md
                     docs/render.md
                     docs/roadmap.md
                     docs/sections.md
                     docs/settings.md
                     docs/style.md
                     docs/table-format.md
                     docs/theme.md
                     docs/tutorial.md
extra-source-files:  fourmolu.yaml

flag werror
  description:         Treat compiler warnings as errors.
  default:             False
  manual:              True

common shared
  default-language:    Haskell2010
  ghc-options:         -Wall -Wcompat -Wincomplete-patterns
                       -Wincomplete-uni-patterns
  if flag(werror)
    ghc-options:       -Werror
  build-depends:       base >= 4.10 && < 5

common directory-dep
  build-depends:       directory >= 1.3 && < 1.4

library
  import:              shared
                     , directory-dep

  exposed-modules:     Ansiform
                     , Ansiform.Content
                     , Ansiform.Draw
                     , Ansiform.Input
                     , Ansiform.Line
                     , Ansiform.Number
                     , Ansiform.Page
                     , Ansiform.Printer
                     , Ansiform.Render
                     , Ansiform.Sample
                     , Ansiform.Section
                     , Ansiform.Settings
                     , Ansiform.Style
                     , Ansiform.Table
                     , Ansiform.Theme
                     , Ansiform.Width

  other-modules:       Ansiform.Internal
                     , Ansiform.Internal.Content
                     , Ansiform.Internal.Draw
                     , Ansiform.Internal.Input
                     , Ansiform.Internal.Line
                     , Ansiform.Internal.Number
                     , Ansiform.Internal.Output
                     , Ansiform.Internal.Page
                     , Ansiform.Internal.Printer
                     , Ansiform.Internal.Render
                     , Ansiform.Internal.Sample
                     , Ansiform.Internal.Section
                     , Ansiform.Internal.Settings
                     , Ansiform.Internal.State
                     , Ansiform.Internal.Style
                     , Ansiform.Internal.Table
                     , Ansiform.Internal.Terminal
                     , Ansiform.Internal.Theme
                     , Ansiform.Internal.Utils
                     , Ansiform.Internal.Width

  build-depends:       ansi-terminal >= 0.8 && < 1.2
                     , split >= 0.2 && < 0.3
                     , terminal-size >= 0.3 && < 0.4
                     , text >= 1.2 && < 2.3
                     , transformers >= 0.5 && < 0.7

  hs-source-dirs:      src

executable ansiform-demo
  import:              shared

  main-is:             Demo.hs
  hs-source-dirs:      examples
  other-modules:       Paths_ansiform
  autogen-modules:     Paths_ansiform
  build-depends:       ansiform
  if os(windows)
    ghc-options:       -with-rtsopts=--io-manager=winio

executable ansiform-tutorial
  import:              shared

  main-is:             Tutorial.hs
  hs-source-dirs:      examples
  build-depends:       ansiform
  if os(windows)
    ghc-options:       -with-rtsopts=--io-manager=winio

test-suite ansiform-test
  import:              shared
                     , directory-dep

  type:                exitcode-stdio-1.0
  main-is:             Spec.hs
  hs-source-dirs:      test
  build-depends:       ansiform
                     , QuickCheck >= 2.14 && < 2.15

source-repository head
  type:                git
  location:            https://github.com/Tralen/ansiform.git
