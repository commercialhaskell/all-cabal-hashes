cabal-version:      3.0
name:               mjml-hamlet
version:            0.1.0.0
synopsis:           MJML email templates in Hamlet syntax, checked at compile time
description:
  A quasiquoter for MJML documents written with Hamlet's indentation-based
  syntax and interpolation. Unknown elements, misplaced elements, undeclared
  attributes and attribute values of the wrong type are compile errors.
license:            MIT
license-file:       LICENSE
author:             José Lorenzo Rodríguez
maintainer:         lorenzo@kronor.io
copyright:          2026 Kronor
category:           Text, Web, Email
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md
tested-with:        GHC ==9.10.3 || ==9.12.4 || ==9.14.1

common warnings
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
               -Wincomplete-uni-patterns -Wredundant-constraints

library
  import:           warnings
  hs-source-dirs:   src
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
    LambdaCase
    MultiWayIf
    DerivingStrategies
    OverloadedRecordDot
  exposed-modules:
    Text.Mjml.Hamlet
    Text.Mjml.Hamlet.Check
    Text.Mjml.Hamlet.Runtime
    Text.Mjml.Hamlet.Syntax
    Text.Mjml.Hamlet.TH
  build-depends:
      base >=4.20 && <5
    , blaze-markup >=0.8 && <0.9
    , containers >=0.6 && <0.9
    , megaparsec >=9.6 && <9.9
    , mjml ==0.1.*
    , parsec >=3.1 && <3.2
    , shakespeare >=2.1 && <2.3
    , template-haskell >=2.22 && <2.25
    , text >=2.0 && <2.2

test-suite spec
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:    Readme
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
    QuasiQuotes
    OverloadedRecordDot
  build-depends:
      base
    , blaze-markup
    , containers
    , mjml
    , mjml-hamlet
    , text
