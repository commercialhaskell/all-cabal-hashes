  location:         https://gitlab.com/system-f/code/casa-reoc.git

flag doctest
  description:      Build the doctest test suite, which runs doctest through cabal. It is enabled in cabal.project, and disabled by default so that builds from the source distribution do not need cabal or doctest at test time.
  default:          False
  manual:           True

flag examples
  description:      Build reoc-examples, which writes the documents of the examples into the examples directory of the repository. It is enabled in cabal.project, and disabled by default so that installing the package does not install it.
  default:          False
  manual:           True

