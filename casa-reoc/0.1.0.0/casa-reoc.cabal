-- Example applications of made-up operators.
library examples
  default-language:
                    Haskell2010

  build-depends:
                      base              >= 4.18      && < 5
                    , lens              >= 5.2.1     && < 6
                    , casa-reoc
                    , text              >= 2.0.2     && < 2.2
                    , time              >= 1.12.2    && < 2

  ghc-options:
                    -Wall
                    -Wcompat
                    -Wincomplete-record-updates
                    -Wincomplete-uni-patterns
                    -Wredundant-constraints
                    -Werror=incomplete-patterns

  hs-source-dirs:
                    examples/src

  exposed-modules:
                    ReOC.Example.Aircraft
                    ReOC.Example.BanksiaPoint
                    ReOC.Example.Draft
                    ReOC.Example.Ironbark
                    ReOC.Example.Policies
                    ReOC.Example.Risk
                    ReOC.Example.Saltbush
                    ReOC.Example.WattleCreek
                    ReOC.Examples

-- Writes the documents of each example into examples.
executable reoc-examples
  if !flag(examples)
    buildable:      False

  main-is:
                    write-examples.hs

  default-language:
                    Haskell2010

  build-depends:
                      base              >= 4.18      && < 5
                    , examples
                    , filepath          >= 1.4.301.0 && < 1.6
                    , casa-reoc
                    , text              >= 2.0.2     && < 2.2

  ghc-options:
                    -Wall
                    -Wcompat
                    -Wincomplete-record-updates
                    -Wincomplete-uni-patterns

  hs-source-dirs:
                    examples

test-suite hedgehog
  type:
                    exitcode-stdio-1.0

  main-is:
                    hedgehog_tests.hs

  other-modules:
                    DataGens
                    FormFields
                    Laws
                    OpticsTests
                    PrimitiveGens
                    RenderTests

  default-language:
                    Haskell2010

  build-depends:
                      base              >= 4.18      && < 5
                    , containers        >= 0.6.7     && < 0.9
                    , bytestring        >= 0.11.5.4  && < 0.13
                    , directory         >= 1.3.8.5   && < 2
                    , examples
                    , filepath          >= 1.4.301.0 && < 1.6
                    , hedgehog          >= 1.2       && < 2
                    , lens              >= 5.2.1     && < 6
                    , casa-reoc
                    , text              >= 2.0.2     && < 2.2
                    , time              >= 1.12.2    && < 2
                    , xml-conduit       >= 1.9       && < 1.11

  ghc-options:
                    -Wall
                    -threaded
                    -rtsopts
                    "-with-rtsopts=-N"

  hs-source-dirs:
                    test

test-suite doctest
  type:
                    exitcode-stdio-1.0

  if !flag(doctest)
    buildable:      False

  main-is:
                    doctest_tests.hs

  default-language:
                    Haskell2010

  build-depends:
                      base    >= 4.18     && < 5
                    , process >= 1.6.19.0 && < 2
                    , casa-reoc

  ghc-options:
                    -Wall
                    -threaded

  hs-source-dirs:
                    test
