cabal-version: 3.0
name: polytropos-openapi3
version: 0.1.0.2
synopsis: OpenAPI 3.0 schema generation for polytropos open records and variants
description:
  Automatic OpenAPI 3.0 specification and JSON Schema generation for <https://hackage.haskell.org/package/polytropos polytropos>
  open records and variants via <https://hackage.haskell.org/package/openapi3 openapi3>.

  Generates 'Data.OpenApi.Schema.ToSchema' instances without "GHC.Generics" tree explosion: open records
  yield schema objects with typed properties and required lists, while open variants
  yield 'Data.OpenApi.Lens.oneOf' tagged-union schemas.

  Start at the front door module "Polytropos.OpenApi" for complete documentation,
  schema customizing options, and worked examples.
license: EUPL-1.2 OR Apache-2.0
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Web
homepage: https://github.com/NadiaYvette/polytropos
bug-reports: https://github.com/NadiaYvette/polytropos/issues
extra-doc-files:
    README.md
  , CHANGELOG.md
build-type: Simple

source-repository head
  type:     git
  location: https://github.com/NadiaYvette/polytropos
  subdir:   packages/polytropos-openapi3

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.OpenApi
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    openapi3 >= 3.2 && < 3.3,
    text >= 1.2 && < 2.2,
    lens >= 5.2 && < 5.4,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2

test-suite polytropos-openapi3-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -fplugin=Polytropos.Plugin
  build-depends:
    base,
    aeson,
    openapi3,
    text,
    lens,
    polytropos-core,
    polytropos-openapi3,
    polytropos-plugin,
    tasty,
    tasty-hunit
