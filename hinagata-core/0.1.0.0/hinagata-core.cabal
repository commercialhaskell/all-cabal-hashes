cabal-version: 3.12
name: hinagata-core
version: 0.1.0.0
synopsis: Pure fixture plans and configuration for Hinagata
description: Deterministic fixture planning for PostgreSQL test databases.
category: Testing
license: BSD-3-Clause
license-file: LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
homepage: https://github.com/shinzui/hinagata
bug-reports: https://github.com/shinzui/hinagata/issues
extra-doc-files: CHANGELOG.md
build-type: Simple

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options: -Wall

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Hinagata.Config
    Hinagata.Connection
    Hinagata.Error
    Hinagata.Fixture.Bundle
    Hinagata.Fixture.Graph
    Hinagata.Fixture.Manifest
    Hinagata.Fixture.SqlPolicy
    Hinagata.Fixture.Types
    Hinagata.Hook.Revision
    Hinagata.Prelude
    Hinagata.Types

  build-depends:
    aeson >=2.2 && <2.4,
    base >=4.21 && <5,
    bytestring >=0.12 && <0.14,
    containers >=0.7 && <0.9,
    cryptohash-sha256 >=0.11.102.1 && <0.12,
    directory >=1.3 && <1.5,
    filepath >=1.5 && <1.7,
    lens >=5.3 && <5.4,
    settei >=0.2 && <0.3,
    settei-env >=0.2 && <0.3,
    temporary >=1.3 && <1.4,
    text >=2.1 && <2.3,
    time >=1.14 && <1.16,
    transformers >=0.6 && <0.8,
    unix >=2.8 && <2.9,
    yaml >=0.11.11.2 && <0.12,

test-suite hinagata-core-test
  import: common
  ghc-options: -rtsopts
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    base >=4.21 && <5,
    bytestring >=0.12 && <0.14,
    directory >=1.3 && <1.5,
    filepath >=1.5 && <1.7,
    hinagata-core ^>=0.1.0.0,
    settei >=0.2 && <0.3,
    settei-env >=0.2 && <0.3,
    temporary >=1.3 && <1.4,
    text >=2.1 && <2.3,
    unix >=2.8 && <2.9,

source-repository head
  type: git
  location: https://github.com/shinzui/hinagata.git
  subdir: hinagata-core
