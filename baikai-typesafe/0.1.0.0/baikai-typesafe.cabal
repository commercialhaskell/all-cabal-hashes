cabal-version: 3.4
name: baikai-typesafe
version: 0.1.0.0
synopsis: TypeSafe judgment provider for Baikai
description:
  Submit closed-set judgments to TypeSafe System One using Baikai's explicit
  provider registry. Preserve structured answers, probabilities and confidence
  through synthetic streams, response persistence and call evidence, with strict
  request/reply validation, scoped HTTP cancellation and no internal retries.

homepage: https://github.com/shinzui/baikai
bug-reports: https://github.com/shinzui/baikai/issues
license: BSD-3-Clause
license-file: LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
category: AI
build-type: Simple
tested-with: ghc ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files: test/fixtures/*.json

common common-options
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies

  -- Exhaustiveness is an error, not a warning. A non-exhaustive match
  -- is a crash the compiler already found: it fails at runtime, on
  -- whichever input reaches the missing branch, usually in front of a
  -- user. This is not hypothetical here — adding a constructor to
  -- AgentRunFailure left `failureExitCode` non-exhaustive and shipped a
  -- pattern-match failure on `baikai agent run --require-evidence`,
  -- because the warning scrolled past in a build log.
  --
  -- Promoted individually rather than through -Werror, which would also
  -- fail the build on warnings that are stylistic or that a future GHC
  -- invents, and would push people toward blanket suppression.
  ghc-options:
    -Werror=incomplete-patterns
    -Werror=incomplete-uni-patterns
    -Werror=incomplete-record-updates

  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    Baikai.Provider.TypeSafe.Api
    Baikai.Provider.TypeSafe.Internal.Request
    Baikai.Provider.TypeSafe.Internal.Response

  other-modules: Paths_baikai_typesafe
  autogen-modules: Paths_baikai_typesafe
  build-depends:
    aeson ^>=2.2,
    baikai ^>=0.9.0,
    base >=4.20 && <5,
    bytestring ^>=0.12,
    case-insensitive ^>=1.2,
    containers ^>=0.7,
    generic-lens ^>=2.3,
    http-client ^>=0.7,
    http-types ^>=0.12,
    lens ^>=5.3,
    scientific ^>=0.3,
    servant-client ^>=0.20,
    streamly >=0.11 && <0.13,
    streamly-core >=0.3 && <0.5,
    text ^>=2.1,
    time ^>=1.14,
    typesafe-hs ^>=0.1.0.0,
    vector ^>=0.13,

test-suite baikai-typesafe-test
  import: common-options
  ghc-options: -threaded
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules: HttpFixture
  build-depends:
    aeson,
    baikai,
    baikai-typesafe,
    base,
    bytestring,
    containers,
    directory,
    filepath,
    generic-lens,
    http-types,
    lens,
    streamly,
    streamly-core,
    tasty,
    tasty-hunit,
    temporary,
    text,
    time,
    typesafe-hs,
    vector,
    wai ^>=3.2,
    warp ^>=3.4,
