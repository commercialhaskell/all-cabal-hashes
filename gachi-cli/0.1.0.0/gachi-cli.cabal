cabal-version: 3.0
name: gachi-cli
version: 0.1.0.0
synopsis: Unified command-line interface for the gachi ecosystem engine
description:
  Turnkey command-line interface providing declarative project initialization ('gachi init'),
  harmonic configuration propagation ('gachi sync'), non-destructive codebase retrofitting
  ('gachi retrofit'), and ecosystem roadmap governance ('gachi plan').
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Development, CLI, Tools
build-type: Simple
tested-with: GHC == 9.14.1

library
  exposed-modules:
    Gachi.CLI
    Gachi.CLI.Doctor
    Gachi.CLI.Init
    Gachi.CLI.Options
    Gachi.CLI.Retrofit
    Gachi.CLI.Sync
  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    text >= 2.0,
    directory >= 1.3,
    filepath >= 1.4,
    process >= 1.6,
    optparse-applicative >= 0.17,
    gachi-core >= 0.1,
    gachi-schema >= 0.1,
    gachi-scaffold >= 0.1,
    gachi-sync >= 0.1,
    gachi-retrofit >= 0.1

executable gachi
  main-is: Main.hs
  hs-source-dirs: app
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints
    -threaded
    -rtsopts
    -with-rtsopts=-N
  build-depends:
    base >= 4.14 && < 5,
    gachi-cli

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints
    -threaded
  build-depends:
    base >= 4.14 && < 5,
    gachi-cli,
    gachi-schema,
    gachi-scaffold,
    gachi-sync,
    gachi-retrofit,
    text >= 2.0,
    directory >= 1.3,
    filepath >= 1.4,
    process >= 1.6,
    optparse-applicative >= 0.17,
    time >= 1.9,
    hspec >= 2.10
