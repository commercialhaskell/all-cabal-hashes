cabal-version: 3.0
name: gachi-cli
version: 0.1.0.1
synopsis: Unified command-line interface for the gachi ecosystem engine
description:
  Turnkey command-line interface providing declarative project initialization
  ('gachi init'), harmonic configuration propagation ('gachi sync'),
  non-destructive codebase retrofitting ('gachi retrofit'), ecosystem roadmap
  governance ('gachi plan'), and repository diagnostics ('gachi doctor').
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Development
homepage: https://github.com/NadiaYvette/gachi
bug-reports: https://github.com/NadiaYvette/gachi/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with: GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/gachi
  subdir: packages/gachi-cli

library
  exposed-modules:
    Gachi.CLI
    Gachi.CLI.Doctor
    Gachi.CLI.Init
    Gachi.CLI.Options
    Gachi.CLI.Retrofit
    Gachi.CLI.Sync
  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    text >= 2.0 && < 2.2,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    process >= 1.6 && < 1.7,
    optparse-applicative >= 0.17 && < 0.20,
    gachi-core >= 0.1 && < 0.2,
    gachi-schema >= 0.1 && < 0.2,
    gachi-scaffold >= 0.1 && < 0.2,
    gachi-sync >= 0.1 && < 0.2,
    gachi-retrofit >= 0.1 && < 0.2

executable gachi
  main-is: Main.hs
  hs-source-dirs: app
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints
    -threaded
    -rtsopts
    -with-rtsopts=-N
  build-depends:
    base >= 4.14 && < 5,
    gachi-cli

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints
    -threaded
  build-depends:
    base >= 4.14 && < 5,
    gachi-cli,
    gachi-schema,
    gachi-scaffold,
    gachi-sync,
    gachi-retrofit,
    text >= 2.0 && < 2.2,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    process >= 1.6 && < 1.7,
    optparse-applicative >= 0.17 && < 0.20,
    time >= 1.9 && < 1.16,
    hspec >= 2.10 && < 2.12
