cabal-version:      3.0
name:               gongju-text
version:            0.1.0.0
synopsis:           Structured text utilities, non-empty text collections, and layout parsing
description:
    Gongju-Text provides robust text processing utilities leveraging non-empty
    refinements, polymorphic container targets, and layout-aware block/stanza parsing.
license:            EUPL-1.2 OR Apache-2.0
license-files:      LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
homepage:           https://github.com/NadiaYvette/gongju
bug-reports:        https://github.com/NadiaYvette/gongju/issues
category:           Text, Parsing, Utilities
build-type:         Simple
extra-doc-files:
    README.md
  , CHANGELOG.md
  , LICENSE

tested-with:
    GHC == 9.6.7
  , GHC == 9.8.4
  , GHC == 9.10.3
  , GHC == 9.12.4
  , GHC == 9.14.1

source-repository head
    type:     git
    location: https://github.com/NadiaYvette/gongju.git
    subdir:   packages/gongju-text

common commons
    default-language:   Haskell2010
    default-extensions:
        DerivingStrategies
        OverloadedStrings
        ScopedTypeVariables
        StandaloneDeriving
        UndecidableInstances
    ghc-options:        -Wall -Wcompat -Wredundant-constraints

library
    import:             commons
    hs-source-dirs:     src
    exposed-modules:
        Gongju.Text.NonEmpty
        Gongju.Text.Stanza
        Gongju.Text.Layout
    build-depends:
        base              >= 4.18 && < 5
      , text              >= 2     && < 3
      , mono-traversable  >= 1     && < 2
      , containers        >= 0.6   && < 1
      , vector            >= 0.12  && < 1

test-suite gongju-text-test
    import:             commons
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test
    main-is:            Main.hs
    build-depends:
        base              >= 4.18 && < 5
      , text              >= 2     && < 3
      , gongju-text
      , hspec             >= 2.11  && < 3
      , containers        >= 0.6   && < 1
