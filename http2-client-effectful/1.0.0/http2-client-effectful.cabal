cabal-version: 3.0
name: http2-client-effectful
version: 1.0.0
synopsis: Effectful bindings for the http2-client library
description:
  Adaptation of the @<https://hackage.haskell.org/package/http2-client http2-client>@ library for the @<https://hackage.haskell.org/package/effectful effectful>@ ecosystem.

homepage: https://digital-autonomy.institute
license: EUPL-1.2
license-file: LICENCE
author: IDA
maintainer: IDA
bug-reports: https://issues.digital-autonomy.institute
category: Web
build-type: Simple
extra-source-files:
  CHANGELOG.md

common common
  default-language: Haskell2010
  ghc-options:
    -Weverything
    -Wno-unsafe
    -Wno-missing-safe-haskell-mode
    -Wno-missing-export-lists
    -Wno-missing-import-lists
    -Wno-missing-kind-signatures
    -Wno-all-missed-specialisations
    -Wno-missing-role-annotations

  default-extensions:
    BlockArguments
    DataKinds
    ExplicitNamespaces
    FlexibleContexts
    ImportQualifiedPost
    NamedFieldPuns
    NoImplicitPrelude
    OverloadedStrings
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    TypeApplications
    TypeFamilies
    TypeOperators

library
  import: common
  hs-source-dirs: src
  build-depends:
    base >=4.10 && <5,
    bytestring >=0.12 && <0.13,
    effectful >=2.6 && <2.7,
    http-types >=0.12 && <0.13,
    http2 >=5.3 && <5.4,
    http2-client >=0.10 && <0.11,
    mtl >=2.3 && <2.4,

  exposed-modules:
    Effectful.Http2Client
