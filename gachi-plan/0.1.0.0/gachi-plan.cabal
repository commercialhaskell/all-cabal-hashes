cabal-version: 3.0
name: gachi-plan
version: 0.1.0.0
synopsis: Isolated detached Git store architecture and snapshot ledger for ecosystem plan governance
description:
  Implements Milestone 5.1 of Phase 5 (Ecosystem Plan Governance & Rollback per ~/src/PLAN.md §1.A).
  Establishes an isolated, detached Git store tracking ecosystem-wide governance documents
  (PLAN.md, STATE.md, INDEX.md, and docs/INDEX.md) across ~/src/ without interfering with child git checkouts.
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Development, VersionControl, Tools
build-type: Simple
tested-with:
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

common commons
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
    ScopedTypeVariables
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints

library
  import: commons
  exposed-modules:
    Gachi.Plan
    Gachi.Plan.Rollback
    Gachi.Plan.Snapshot
    Gachi.Plan.Store
    Gachi.Plan.Types
  hs-source-dirs: src
  build-depends:
    base >= 4.14 && < 5,
    bytestring >= 0.10,
    text >= 2.0,
    containers >= 0.6,
    directory >= 1.3,
    filepath >= 1.4,
    process >= 1.6,
    time >= 1.9,
    gachi-sync >= 0.1

test-suite tests
  import: commons
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  ghc-options:
    -threaded
  build-depends:
    base >= 4.14 && < 5,
    gachi-plan,
    bytestring >= 0.10,
    text >= 2.0,
    containers >= 0.6,
    directory >= 1.3,
    filepath >= 1.4,
    process >= 1.6,
    time >= 1.9,
    hspec >= 2.10
