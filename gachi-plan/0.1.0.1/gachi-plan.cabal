cabal-version: 3.0
name: gachi-plan
version: 0.1.0.1
synopsis: Isolated detached Git store and ledger for ecosystem plan governance
description:
  Implements Milestone 5.1 of Phase 5 (Ecosystem Plan Governance & Rollback
  per ~/src/PLAN.md §1.A). Establishes an isolated, detached Git store tracking
  ecosystem-wide governance documents (PLAN.md, STATE.md, INDEX.md, and
  docs/INDEX.md) across ~/src/ without interfering with child git checkouts.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Development
homepage: https://github.com/NadiaYvette/gachi
bug-reports: https://github.com/NadiaYvette/gachi/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with:
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/gachi
  subdir: packages/gachi-plan

common commons
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
    ScopedTypeVariables
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints

library
  import: commons
  exposed-modules:
    Gachi.Plan
    Gachi.Plan.Rollback
    Gachi.Plan.Snapshot
    Gachi.Plan.Store
    Gachi.Plan.Types
  hs-source-dirs: src
  build-depends:
    base >= 4.14 && < 5,
    bytestring >= 0.10 && < 0.13,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    process >= 1.6 && < 1.7,
    time >= 1.9 && < 1.16,
    gachi-sync >= 0.1 && < 0.2

test-suite tests
  import: commons
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  ghc-options:
    -threaded
  build-depends:
    base >= 4.14 && < 5,
    gachi-plan,
    bytestring >= 0.10 && < 0.13,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    process >= 1.6 && < 1.7,
    time >= 1.9 && < 1.16,
    hspec >= 2.10 && < 2.12
