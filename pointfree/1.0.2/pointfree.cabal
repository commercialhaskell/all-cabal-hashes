cabal-version: >=1.0
name:                pointfree
version:             1.0.2
x-revision: 1
synopsis:            Pointfree refactoring tool
description:         Stand-alone command-line version of the point-less plugin for lambdabot.
license:             OtherLicense
license-file:        LICENSE
author:              Thomas Jäger
