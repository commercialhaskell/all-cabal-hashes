license:        MIT
license-file:   LICENSE
build-type:     Simple
tested-with:
    GHC == 9.6.6, GHC == 9.8.4, GHC == 9.10.1
extra-doc-files:
    README.md
    CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/jarlah/tower-hs

library
