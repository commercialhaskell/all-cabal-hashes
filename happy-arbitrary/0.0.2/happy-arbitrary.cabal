name:          happy-arbitrary
version:       0.0.2
synopsis:      Random programs for testing parsers made with Happy and Alex
homepage:      https://toktok.ltd/
license:       GPL-3
license-file:  LICENSE
author:        Iphigenia Df <iphydf@gmail.com>
maintainer:    Iphigenia Df <iphydf@gmail.com>
copyright:     Copyright (c) 2024-2026, Iphigenia Df
category:      Testing
stability:     Experimental
cabal-version: >=1.10
build-type:    Simple
description:
  Makes random programs from a parser's own Happy grammar and Alex lexer, of a
  given size in tokens, and checks their text with the language's lexer. For
  QuickCheck properties of parsers and pretty-printers.

extra-source-files:
    README.md
    doc/design.md
    doc/development.md
    test/examples/Cimple/Lexer.x
    test/examples/Cimple/Parser.y

source-repository head
  type:     git
  location: https://github.com/TokTok/hs-happy-arbitrary

library
  default-language: Haskell2010
  hs-source-dirs:   src
  ghc-options:      -Wall
  build-tools:      alex >=0, happy >=0
  exposed-modules:
    Language.Alex.Arbitrary
    Language.Alex.Ast
    Language.Alex.Parser
    Language.Happy.Arbitrary
    Language.Happy.Ast
    Language.Happy.GenTree
    Language.Happy.Grammar
    Language.Happy.Lexer
    Language.Happy.Linker
    Language.Happy.Parser
    Language.Happy.Sized
    Language.Happy.Tokens
    Language.Happy

  build-depends:
      QuickCheck
    , aeson
    , array
    , attoparsec
    , base                 <5
    , containers
    , bytestring
    , data-fix
    , file-embed
    , mtl
    , text
    , transformers-compat

test-suite testsuite
  type:               exitcode-stdio-1.0
  default-language:   Haskell2010
  hs-source-dirs:     test
  main-is:            testsuite.hs
  other-modules:
      Examples.CimpleSpec
      Examples.Files
      Examples.Mini.Lexer
      Examples.Mini.Parser
      Examples.MiniSpec
      Language.Alex.ParserSpec
      Language.Happy.ArbitrarySpec
      Language.Happy.LinkerSpec
      Language.Happy.SizedSpec
  ghc-options:        -Wall
  build-tool-depends:
      alex:alex
    , happy:happy
    , hspec-discover:hspec-discover
  build-depends:
      array
    , base        <5
    , bytestring
    , containers
    , directory
    , hspec
    , QuickCheck
    , happy-arbitrary
    , text
