cabal-version: 3.0
name: mono-hash
version: 0.1.0.0
synopsis: Hashing for monomorphic containers.
description:
  FNV, SipHash, and HalfSipHash hashing for monomorphic containers.
license: BSD-3-Clause
license-file: LICENSE
author: Philipp Hagenlocher
maintainer: me@philipphagenlocher.de
category: Data
build-type: Simple
homepage: https://github.com/phagenlocher/mono-hash#readme
bug-reports: https://github.com/phagenlocher/mono-hash/issues
extra-doc-files:
  CHANGELOG.md
  README.md
tested-with:
  ghc ==8.10.7 || ==9.0.2 || ==9.2.8 || ==9.4.8 || ==9.6.7
    || ==9.8.4 || ==9.10.3 || ==9.12.4 || ==9.14.1

source-repository head
  type: git
  location: https://github.com/phagenlocher/mono-hash

common warnings
  ghc-options: -Wall

library
  import: warnings
  ghc-options: -O2

  exposed-modules:
    Data.Hash.Mono.FNV
    Data.Hash.Mono.HalfSipHash
    Data.Hash.Mono.Internal.ByteFoldable
    Data.Hash.Mono.SipHash

  other-modules:
    Data.Hash.Mono.Internal

  build-depends:
    base >=4.14.3.0 && <5,
    mono-traversable >=1.0.21 && <1.1,
    wide-word >=0.1.7 && <0.2

  hs-source-dirs: src

  default-language: Haskell2010

  default-extensions:
    ConstraintKinds
    FlexibleContexts
    ImportQualifiedPost
    InstanceSigs
    ScopedTypeVariables

test-suite mono-hash-test
  import: warnings

  default-language: Haskell2010

  other-modules:
    Test.Data.ByteFoldable
    Test.Data.FNV
    Test.Data.SipHash
    Test.Data.HalfSipHash

  type: exitcode-stdio-1.0

  hs-source-dirs: test

  main-is: Main.hs

  build-depends:
    base >=4.14.3.0 && <5,
    bytestring >=0.10 && <0.13,
    mono-hash,
    tasty >=1.4 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    text >=1.2 && <2.2,
    wide-word >=0.1.7 && <0.2,

benchmark mono-hash-bench
  type: exitcode-stdio-1.0

  hs-source-dirs: bench

  default-language: Haskell2010

  ghc-options: -O2

  main-is: Main.hs

  build-depends:
    base >=4.14.3.0 && <5,
    bytestring >=0.10 && <0.13,
    criterion >=1.5 && <1.7,
    deepseq >=1.4 && <1.6,
    mono-hash,
    text >=1.2 && <2.2,
    wide-word >=0.1.7 && <0.2,
