cabal-version: 3.0
name: polytropos-cassava
version: 0.1.0.2
synopsis: Fast CSV codecs for polytropos open records via cassava
description:
  CSV tabular serialization and deserialization connecting <https://hackage.haskell.org/package/polytropos polytropos> open records
  to the standard Haskell CSV library <https://hackage.haskell.org/package/cassava cassava> without intermediate nominal data conversions.

  Supports both named records ('Data.Csv.FromNamedRecord', 'Data.Csv.ToNamedRecord') and ordered positional
  records ('Data.Csv.FromRecord', 'Data.Csv.ToRecord') with genuine heterogeneous field decoding via 'Polytropos.Core.AllFields'.
  Marshals directly to and from the flat contiguous 'Data.Primitive.SmallArray.SmallArray' payload without tuple arity
  restrictions.

  Start at the front door module "Polytropos.Cassava" for complete documentation,
  streaming guidance, and worked examples.
license: EUPL-1.2 OR Apache-2.0
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Text, CSV
homepage: https://github.com/NadiaYvette/polytropos
bug-reports: https://github.com/NadiaYvette/polytropos/issues
extra-doc-files:
    README.md
  , CHANGELOG.md
build-type: Simple

source-repository head
  type:     git
  location: https://github.com/NadiaYvette/polytropos
  subdir:   packages/polytropos-cassava

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.Cassava
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    cassava >= 0.5 && < 0.6,
    bytestring >= 0.10 && < 0.13,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2

test-suite polytropos-cassava-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -fplugin=Polytropos.Plugin
  build-depends:
    base,
    cassava,
    bytestring,
    vector,
    polytropos-core,
    polytropos-cassava,
    polytropos-plugin,
    tasty,
    tasty-hunit
