cabal-version: 3.0
name: cek-mercury
version: 0.1.0.2
synopsis: Demonstrative Prolog/Mercury relational engine for CEK machines
description:
  An educational and demonstrative reference engine showcasing Prolog and Mercury
  relational unification, Warren Abstract Machine (WAM) conditional trailing,
  and nondeterministic search over unrolled KontStack choice points.

  Notice: This package is provided primarily as an executable architectural example
  and documentation case study within the @cek@ ecosystem.
license: EUPL-1.2 OR Apache-2.0
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Language, Compilers/Interpreters
homepage: https://github.com/NadiaYvette/cek
bug-reports: https://github.com/NadiaYvette/cek/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with: GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/cek
  subdir: packages/cek-mercury

library
  exposed-modules:
    Cek.Mercury
    Cek.Examples.Mercury
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.18 && < 5,
    ghc-prim >= 0.10 && < 0.14,
    primitive >= 0.9 && < 0.10,
    cek-core >= 0.1.0.0 && < 0.2,
    cek-pykinos >= 0.1.0.0 && < 0.2,
    pykinos-core >= 0.1.0.0 && < 0.2

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints -threaded
  build-depends:
    base >= 4.18 && < 5,
    cek-core >= 0.1.0.0 && < 0.2,
    cek-pykinos >= 0.1.0.0 && < 0.2,
    pykinos-core >= 0.1.0.0 && < 0.2,
    cek-mercury >= 0.1.0.0 && < 0.2,
    primitive >= 0.9 && < 0.10,
    hspec >= 2.10 && < 2.12
