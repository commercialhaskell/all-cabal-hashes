cabal-version: 3.0
name: cek-scheme
version: 0.1.0.2
synopsis: Demonstrative Call-by-Value Scheme reference interpreter for CEK machines
description:
  An educational and demonstrative reference interpreter showcasing Call-by-Value
  Scheme with automatic Generic1 polynomial functor dissection, first-class call/cc
  continuations with O(1) Copy-on-Write capture, and mutable lexical variables
  over the CEK abstract machine architecture.

  Notice: This package is provided primarily as an executable architectural example
  and documentation case study within the @cek@ ecosystem.
license: EUPL-1.2 OR Apache-2.0
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Language, Compilers/Interpreters
homepage: https://github.com/NadiaYvette/cek
bug-reports: https://github.com/NadiaYvette/cek/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with: GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/cek
  subdir: packages/cek-scheme

library
  exposed-modules:
    Cek.Scheme
    Cek.Examples.Scheme
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.18 && < 5,
    ghc-prim >= 0.10 && < 0.14,
    primitive >= 0.9 && < 0.10,
    cek-core >= 0.1.0.0 && < 0.2,
    cek-pykinos >= 0.1.0.0 && < 0.2,
    pykinos-core >= 0.1.0.0 && < 0.2

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints -threaded
  build-depends:
    base >= 4.18 && < 5,
    cek-core >= 0.1.0.0 && < 0.2,
    cek-pykinos >= 0.1.0.0 && < 0.2,
    pykinos-core >= 0.1.0.0 && < 0.2,
    cek-scheme >= 0.1.0.0 && < 0.2,
    primitive >= 0.9 && < 0.10,
    hspec >= 2.10 && < 2.12
