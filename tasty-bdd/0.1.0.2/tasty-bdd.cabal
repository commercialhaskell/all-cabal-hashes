cabal-version:      3.0
name:               tasty-bdd
version:            0.1.0.2
synopsis:           BDD tests language and tasty provider
description:
  A typed Given/When/Then language and a free-monad interface for Tasty,
  with ordered setup, reverse-order teardown, recursive test decorators
  and structural equality diagnostics.

category:           Test
stability:          experimental
homepage:           https://github.com/lambdasistemi/tasty-bdd
bug-reports:        https://github.com/lambdasistemi/tasty-bdd/issues
author:             Paolo Veronelli, Pavlo Kerestey
maintainer:         paolo.veronelli@gmail.com
copyright:          2017 Paolo Veronelli
license:            BSD-3-Clause
license-file:       LICENSE
build-type:         Simple
tested-with:        GHC ==9.12.3
extra-doc-files:
  .specify/memory/constitution.md
  CHANGELOG.md
  docs/*.md
  docs/architecture/*.md
  docs/stories/*.md
  README.md
  specs/001-modernization/*.md

extra-source-files:
  .github/actionlint.yaml
  .github/pull_request_template.md
  .github/workflows/*.yml
  .specify/scripts/bash/*.sh
  .specify/templates/*.md
  cabal.project
  flake.lock
  flake.nix
  fourmolu.yaml
  justfile
  mkdocs.yml
  nix/*.nix
  tools/*.py
  tools/*.sh

flag werror
  description: Treat compiler warnings as errors during development and CI
  default:     False
  manual:      True

common warnings
  default-language: Haskell2010
  ghc-options:
    -Wall -Wunused-imports -Wunused-packages -Wmissing-export-lists
    -Wname-shadowing -Wdeferred-out-of-scope-variables
    -Wpartial-type-signatures

  if flag(werror)
    ghc-options: -Werror

library
  import:          warnings
  exposed-modules:
    System.CaptureStdout
    Test.BDD.Language
    Test.BDD.LanguageFree
    Test.Tasty.Bdd

  hs-source-dirs:  src
  build-depends:
    , base             >=4.7   && <5
    , exceptions       >=0.10  && <0.11
    , free             >=5     && <6
    , microlens        >=0.4   && <0.5
    , mtl              >=2.2   && <2.4
    , tagged           >=0.8   && <0.9
    , tasty            >=1.2   && <1.6
    , tasty-fail-fast  >=0.0.3 && <0.1
    , temporary        >=1.3   && <1.4
    , text             >=1.2   && <2.2
    , tree-diff        >=0.2   && <0.5

test-suite test
  import:         warnings
  type:           exitcode-stdio-1.0
  main-is:        Main.hs
  hs-source-dirs: tests
  build-depends:
    , base                    >=4.7  && <5
    , HUnit                   >=1.6  && <1.7
    , tasty                   >=1.2  && <1.6
    , tasty-bdd
    , tasty-expected-failure  >=0.12 && <0.13
    , tasty-hunit             >=0.10 && <0.11

test-suite example
  import:         warnings
  type:           exitcode-stdio-1.0
  main-is:        Main.hs
  hs-source-dirs: examples
  build-depends:
    , base       >=4.7 && <5
    , tasty      >=1.2 && <1.6
    , tasty-bdd

source-repository head
  type:     git
  location: https://github.com/lambdasistemi/tasty-bdd
