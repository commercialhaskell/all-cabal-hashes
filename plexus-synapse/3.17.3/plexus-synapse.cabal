test-suite reconnect-test
  -- SYNAPSE-20: a lost connection is noticed (a close, a drop before any
  -- answer, a silent peer by its keepalive) and synapse rides out the
  -- outage — a read sent again, a stream resumed with since, a write that
  -- went out never repeated, one that never left sent when the backend is
  -- back, the window run out — against a flaky service on ports of its own.
  type:             exitcode-stdio-1.0
  main-is:          ReconnectSpec.hs
  build-depends:
    base >= 4.17 && < 5,
    plexus-protocol,
    plexus-synapse,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    unix >= 2.7 && < 2.9,
    aeson >= 2.2 && < 2.3,
    text >= 2.0 && < 2.2,
    network >= 3.1 && < 3.3,
    websockets >= 0.13 && < 0.14,
    hspec >= 2.10 && < 2.12
  hs-source-dirs:   test
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
  ghc-options:      -threaded

test-suite hold-test
  -- SYNAPSE-28: a call costs one round trip and the server's time — the
  -- multiplexer and the holder carry every call on one connection (counted
  -- at the mock service), a stream abandoned is unsubscribed, the holder exits
  -- idle; and the built synapse, end to end: cold fills the cache on one
  -- connection, warm opens none and fetches nothing, --no-hold opens one,
  -- a renamed method falls back and answers.
  type:             exitcode-stdio-1.0
  main-is:          HoldSpec.hs
  other-modules:    MockService
  build-tool-depends: plexus-synapse:synapse
  build-depends:
    base >= 4.17 && < 5,
    plexus-protocol,
    plexus-synapse,
    aeson >= 2.2 && < 2.3,
    async >= 2.2 && < 2.3,
    bytestring >= 0.11 && < 0.13,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    network >= 3.1 && < 3.3,
    process >= 1.6 && < 1.7,
    temporary >= 1.3 && < 1.4,
    text >= 2.0 && < 2.2,
    vector >= 0.12 && < 0.14,
    websockets >= 0.13 && < 0.14,
    hspec >= 2.10 && < 2.12
  hs-source-dirs:   test
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
  ghc-options:      -threaded

test-suite pipe-test
  -- SYNAPSE-26: a closed stdout is not an outage — the built synapse, its
  -- stdout a pipe whose reader closes early (… | head -1): a write sent
  -- once and exit 141, a stream ended (unsubscribed) and exit 141, with no
  -- reconnect; a socket dropping with stdout open still reconnects (a read
  -- resent, a write that went out exit 75).
  type:             exitcode-stdio-1.0
  main-is:          PipeSpec.hs
  other-modules:    MockService
  build-tool-depends: plexus-synapse:synapse
  build-depends:
    base >= 4.17 && < 5,
    aeson >= 2.2 && < 2.3,
    bytestring >= 0.11 && < 0.13,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    network >= 3.1 && < 3.3,
    process >= 1.6 && < 1.7,
    temporary >= 1.3 && < 1.4,
    text >= 2.0 && < 2.2,
    vector >= 0.12 && < 0.14,
    websockets >= 0.13 && < 0.14,
    hspec >= 2.10 && < 2.12
  hs-source-dirs:   test
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
  ghc-options:      -threaded

test-suite output-test
  -- SYNAPSE-39: synapse -o FILE — the built synapse against the mock
  -- service: an answer in FILE is what stdout would have had (plain and
  -- -j) and stdout is empty; a failed call leaves no FILE and nothing
  -- beside it, with its own exit code; a stream's items land as they come;
  -- FILE is 0600; -o - is stdout; a FILE that cannot be made: exit 73,
  -- nothing sent.
  type:             exitcode-stdio-1.0
  main-is:          OutputSpec.hs
  other-modules:    MockService
  build-tool-depends: plexus-synapse:synapse
  build-depends:
    base >= 4.17 && < 5,
