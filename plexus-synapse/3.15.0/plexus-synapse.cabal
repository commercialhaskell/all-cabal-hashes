  -- their groups; a method's page with its usage line, aligned options,
  -- values and examples; an older hub's schema still rendered.
  type:             exitcode-stdio-1.0
  main-is:          RenderSpec.hs
  build-depends:
    base >= 4.17 && < 5,
    plexus-protocol,
    plexus-synapse,
    aeson >= 2.2 && < 2.3,
    aeson-qq >= 0.8 && < 0.9,
    containers >= 0.6 && < 0.8,
    text >= 2.0 && < 2.2,
