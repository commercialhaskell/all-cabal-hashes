test-suite identity-test
  -- IDENTITY-43: the canonical message, the fixed proof vector the Rust
  -- side cross-checks, and the key and session stores' order (env, a
  -- mocked keychain, files in a directory of the test's own).
  type:             exitcode-stdio-1.0
  main-is:          IdentitySpec.hs
  build-depends:
    base >= 4.17 && < 5,
    async >= 2.2 && < 2.3,
    plexus-synapse,
    text >= 2.0 && < 2.2,
    bytestring >= 0.11 && < 0.13,
    base64-bytestring >= 1.2 && < 1.3,
    aeson >= 2.2 && < 2.3,
    containers >= 0.6 && < 0.8,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    hspec >= 2.10 && < 2.12,
    temporary >= 1.3 && < 1.4,
    unix >= 2.7 && < 2.9
  hs-source-dirs:   test
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
  ghc-options:      -threaded

