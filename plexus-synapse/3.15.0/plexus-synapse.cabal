    hspec >= 2.10 && < 2.12
  hs-source-dirs:   test
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
  ghc-options:      -threaded

test-suite keychain-test
  -- SELF-8 keychain tests. Opt-in via `-f build-keychain-tests` because
  -- they shell out to macOS `security` and touch the real keychain.
  type:             exitcode-stdio-1.0
  main-is:          KeychainSpec.hs
  build-depends:
    base >= 4.17 && < 5,
    plexus-synapse,
    text >= 2.0 && < 2.2,
    hspec >= 2.10 && < 2.12,
    uuid >= 1.3 && < 1.4
  hs-source-dirs:   test
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
  ghc-options:      -threaded
  if !flag(build-keychain-tests)
    buildable: False

test-suite auth-test
  -- AUTH-8: the auth shapes plexus-protocol parses (and their absence),
  -- the anonymous page, the caller's header and grant columns, the refusal
  -- block, the loopback's state check, and the flows end to end against a
  -- hub in miniature (test/MockHub.hs) on ports of their own.
  type:             exitcode-stdio-1.0
  main-is:          AuthSpec.hs
  other-modules:    MockHub
  build-depends:
    base >= 4.17 && < 5,
    plexus-protocol,
    plexus-synapse,
    aeson >= 2.2 && < 2.3,
    aeson-qq >= 0.8 && < 0.9,
    bytestring >= 0.11 && < 0.13,
    containers >= 0.6 && < 0.8,
    text >= 2.0 && < 2.2,
    katip >= 0.8 && < 0.9,
    network >= 3.1 && < 3.3,
    websockets >= 0.13 && < 0.14,
    vector >= 0.12 && < 0.14,
    hspec >= 2.10 && < 2.12
  hs-source-dirs:   test
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
  ghc-options:      -threaded

test-suite find-test
  -- SYNAPSE-17: _find's matcher (exact, prefix, typo at both thresholds,
  -- snake_case subsequence, every word, ranking) and its renders against
  -- the mock hub's catalog (menger's schema as it was, test/fixtures), on a
  -- terminal and piped; a caller's view; the IR cache's hash check.
  type:             exitcode-stdio-1.0
  main-is:          FindSpec.hs
  other-modules:    MockHub
  build-depends:
    base >= 4.17 && < 5,
    plexus-synapse,
    aeson >= 2.2 && < 2.3,
    bytestring >= 0.11 && < 0.13,
    containers >= 0.6 && < 0.8,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    text >= 2.0 && < 2.2,
    katip >= 0.8 && < 0.9,
    network >= 3.1 && < 3.3,
    websockets >= 0.13 && < 0.14,
    vector >= 0.12 && < 0.14,
    hspec >= 2.10 && < 2.12
  hs-source-dirs:   test
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
  ghc-options:      -threaded

test-suite reconnect-test
  -- SYNAPSE-20: a lost connection is noticed (a close, a drop before any
  -- answer, a silent peer by its keepalive) and synapse rides out the
  -- outage — a read sent again, a stream resumed with since, a write that
  -- went out never repeated, one that never left sent when the backend is
  -- back, the window run out — against a flaky hub on ports of its own.
  type:             exitcode-stdio-1.0
  main-is:          ReconnectSpec.hs
  build-depends:
    base >= 4.17 && < 5,
    plexus-protocol,
    plexus-synapse,
    aeson >= 2.2 && < 2.3,
    text >= 2.0 && < 2.2,
    network >= 3.1 && < 3.3,
    websockets >= 0.13 && < 0.14,
    hspec >= 2.10 && < 2.12
  hs-source-dirs:   test
  default-language: GHC2021
  default-extensions:
    OverloadedStrings
  ghc-options:      -threaded

test-suite endpoint-test
  -- SCAFFOLD-21: --url and -H/-P with --tls/--path read into one address,
  -- and every key derived from it — the session store's (a plain address
  -- keyed exactly as before), the proof's audience, the options messages
  -- tell the reader to type, the plexus-protocol config.
  type:             exitcode-stdio-1.0
  main-is:          EndpointSpec.hs
  build-depends:
    base >= 4.17 && < 5,
    plexus-protocol,
    plexus-synapse,
    text >= 2.0 && < 2.2,
    hspec >= 2.10 && < 2.12
  hs-source-dirs:   test
  default-language: GHC2021
  default-extensions:
    OverloadedStrings

test-suite tls-test
  -- SCAFFOLD-21: synapse speaks wss — the probe, a call and a key login
  -- through a TLS terminator of the test's own (a CA openssl makes for the
  -- run, in front of the mock hub), at a path; an unknown CA and a wrong
  -- name refused at the handshake. Pending without openssl.
  type:             exitcode-stdio-1.0
  main-is:          TlsSpec.hs
  other-modules:    MockHub
  build-depends:
    base >= 4.17 && < 5,
    plexus-protocol,
    plexus-synapse,
    aeson >= 2.2 && < 2.3,
    base64-bytestring >= 1.2 && < 1.3,
    bytestring >= 0.11 && < 0.13,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    katip >= 0.8 && < 0.9,
    network >= 3.1 && < 3.3,
    process >= 1.6 && < 1.7,
    temporary >= 1.3 && < 1.4,
    text >= 2.0 && < 2.2,
    tls >= 2.1 && < 2.5,
    vector >= 0.12 && < 0.14,
    websockets >= 0.13 && < 0.14,
    hspec >= 2.10 && < 2.12
  hs-source-dirs:   test
  default-language: GHC2021
  default-extensions:
