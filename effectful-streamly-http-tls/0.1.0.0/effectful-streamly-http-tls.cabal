cabal-version:   3.12
name:            effectful-streamly-http-tls
version:         0.1.0.0
synopsis:        The HTTP effect of effectful-streamly-http, over TLS too
description:
  An interpreter for the HTTP effect of effectful-streamly-http that
  speaks in clear and over TLS, through streamly-http-tls. It is apart so
  that programs that only speak in clear need not build a TLS stack.

homepage:        https://github.com/GuillaumedeVolpiano/effectful-streamly-http-tls
license:         BSD-3-Clause
license-file:    LICENSE
author:          Xavier Dectot
maintainer:      Xavier Dectot <xavier@wheredoibegin.fr>
category:        Network, Web, Control
build-type:      Simple
tested-with:     GHC ==9.8.4 || ==9.10.3 || ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  test/fixtures/README.md
  test/fixtures/localhost-cert.pem
  test/fixtures/localhost-key.pem

source-repository head
  type:     git
  location: https://github.com/GuillaumedeVolpiano/effectful-streamly-http-tls.git

common shared
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies
    DisambiguateRecordFields
    DuplicateRecordFields
    ExplicitNamespaces
    GADTs
    LambdaCase
    MonoLocalBinds
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    RoleAnnotations
    TypeFamilies

  ghc-options:
    -Wall -Wcompat -Wredundant-constraints -Wmissing-deriving-strategies
    -Wunused-packages

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Effectful.HTTP.TLS
  build-depends:
    , base                     >=4.19 && <4.22
    , bytestring               ^>=0.12
    , effectful-core           ^>=2.7.1
    , effectful-streamly-http  ^>=0.1
    , streamly-bytestring      ^>=0.2.3
    , streamly-core            ^>=0.3.3
    , streamly-http            ^>=0.1
    , streamly-http-tls        ^>=0.1
    , streamly-network-tls     ^>=0.1
    , text                     ^>=2.1
    , tls                      ^>=2.5

test-suite effectful-streamly-http-tls-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , async                        ^>=2.2
    , base
    , bytestring
    , effectful-core
    , effectful-streamly-http
    , effectful-streamly-http-tls
    , network                      ^>=3.2
    , tasty                        ^>=1.5
    , tasty-hunit                  ^>=0.10
    , tls
