cabal-version:      2.2
name:               cost-per-decade
version:            0.1.0
synopsis:           Buy-it-for-life math: cost per decade and break-even years
description:
  Sticker price compares badly across lifespans: a cheap item replaced
  every couple of years outruns a durable one that lasts decades. These
  functions spread each price over the decades it buys, price a single
  use, count the units a horizon needs, and find the first year the
  cheap stack has spent as much as the durable one. A warranty-coverage
  verdict rounds it out.
  .
  Companion to Durable Picks, which ranks gear by cost-per-decade
  math. Five pure functions, no dependencies beyond base.
license:            MIT
author:             Poket Dev
maintainer:         hello@poketdev.com
homepage:           https://www.durablepicks.com
bug-reports:        https://github.com/scrapertweeter3-prog/cost-per-decade-hs/issues
copyright:          2026 Poket Dev LLC
category:           Math
build-type:         Simple
extra-doc-files:    README.md
                  , CHANGELOG.md

source-repository head
  type:     git
  location: https://github.com/scrapertweeter3-prog/cost-per-decade-hs

library
  exposed-modules:  CostPerDecade
  hs-source-dirs:   src
  build-depends:    base >=4 && <5
  default-language: Haskell2010
  ghc-options:      -Wall
