cabal-version: 3.12
name: clickhouse-migrate
version: 0.1.0.0
synopsis: Core definitions and execution for ClickHouse migrations
description:
  Core definitions and execution for ClickHouse migrations.
  Validated public APIs with explicit application-owned configuration and scope.

license: BSD-3-Clause
license-file: LICENSE
author: shinzui
maintainer: shinzui@users.noreply.github.com
category: Database
build-type: Simple
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  test/public/*.hs
  test/vectors/*.json
  test/vectors/*.tsv

tested-with: ghc ==9.12.4

source-repository head
  type: git
  location: https://github.com/shinzui/clickhouse-migrate.git
  subdir: clickhouse-migrate

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options: -Wall
  build-depends:
    base >=4.21 && <4.22,
    bytestring >=0.12.2 && <0.13,
    containers >=0.7 && <0.9,
    cryptohash-sha256 >=0.11.102.1 && <0.12,
    entropy >=0.4.1.10 && <0.5,
    text >=2.1 && <2.2,
    time >=1.12.2 && <1.17,

  build-depends:
    aeson >=2.2.4.1 && <2.4,
    http-client ==0.7.19,
    http-client-tls >=0.3.6.4 && <0.5,
    http-types >=0.12.4 && <0.13,

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    ClickHouseMigrate
    ClickHouseMigrate.Adoption
    ClickHouseMigrate.Definition
    ClickHouseMigrate.Error
    ClickHouseMigrate.Event
    ClickHouseMigrate.ExclusiveAccess
    ClickHouseMigrate.Inspection
    ClickHouseMigrate.Ledger
    ClickHouseMigrate.Plan
    ClickHouseMigrate.Prelude
    ClickHouseMigrate.Repair
    ClickHouseMigrate.Report
    ClickHouseMigrate.Runner
    ClickHouseMigrate.Target

  other-modules:
    ClickHouseMigrate.Internal.AdoptionTypes
    ClickHouseMigrate.Internal.AdoptionValidation
    ClickHouseMigrate.Internal.Checksum
    ClickHouseMigrate.Internal.EventTypes
    ClickHouseMigrate.Internal.Exclusive
    ClickHouseMigrate.Internal.ExclusiveTypes
    ClickHouseMigrate.Internal.Execution
    ClickHouseMigrate.Internal.Http
    ClickHouseMigrate.Internal.Identity
    ClickHouseMigrate.Internal.LedgerCodec
    ClickHouseMigrate.Internal.LedgerSchema
    ClickHouseMigrate.Internal.LedgerStore
    ClickHouseMigrate.Internal.LedgerTypes
    ClickHouseMigrate.Internal.LedgerValidation
    ClickHouseMigrate.Internal.Preflight
    ClickHouseMigrate.Internal.Projection
    ClickHouseMigrate.Internal.RepairTypes
    ClickHouseMigrate.Internal.Reporting
    ClickHouseMigrate.Internal.RuntimeTypes
    ClickHouseMigrate.Internal.ServerPolicy
    ClickHouseMigrate.Internal.SqlEnvelope
    ClickHouseMigrate.Internal.TargetTypes
    ClickHouseMigrate.Internal.Transport
    ClickHouseMigrate.Internal.Types

flag internal-test-driver
  description: Build private runtime qualification driver (supplied by EP-4)
  default: False
  manual: True

executable clickhouse-migrate-test-driver
  import: common
  ghc-options: -threaded
  hs-source-dirs:
    test-driver
    src

  main-is: Main.hs
  other-modules:
    ClickHouseMigrate
    ClickHouseMigrate.Adoption
    ClickHouseMigrate.Definition
    ClickHouseMigrate.Error
    ClickHouseMigrate.Event
    ClickHouseMigrate.ExclusiveAccess
    ClickHouseMigrate.Inspection
    ClickHouseMigrate.Internal.AdoptionTypes
    ClickHouseMigrate.Internal.AdoptionValidation
    ClickHouseMigrate.Internal.Checksum
    ClickHouseMigrate.Internal.EventTypes
    ClickHouseMigrate.Internal.Exclusive
    ClickHouseMigrate.Internal.ExclusiveTypes
    ClickHouseMigrate.Internal.Execution
    ClickHouseMigrate.Internal.Http
    ClickHouseMigrate.Internal.Identity
    ClickHouseMigrate.Internal.LedgerCodec
    ClickHouseMigrate.Internal.LedgerSchema
    ClickHouseMigrate.Internal.LedgerStore
    ClickHouseMigrate.Internal.LedgerTypes
    ClickHouseMigrate.Internal.LedgerValidation
    ClickHouseMigrate.Internal.Preflight
    ClickHouseMigrate.Internal.Projection
    ClickHouseMigrate.Internal.RepairTypes
    ClickHouseMigrate.Internal.Reporting
    ClickHouseMigrate.Internal.RuntimeTypes
    ClickHouseMigrate.Internal.ServerPolicy
    ClickHouseMigrate.Internal.SqlEnvelope
    ClickHouseMigrate.Internal.TargetTypes
    ClickHouseMigrate.Internal.Transport
    ClickHouseMigrate.Internal.Types
    ClickHouseMigrate.Ledger
    ClickHouseMigrate.Plan
    ClickHouseMigrate.Prelude
    ClickHouseMigrate.Repair
    ClickHouseMigrate.Report
    ClickHouseMigrate.Runner
    ClickHouseMigrate.Target

  if !flag(internal-test-driver)
    buildable: False

test-suite clickhouse-migrate-unit
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs:
    test
    src

  main-is: Main.hs
  other-modules:
    AdoptionTests
    ClickHouseMigrate
    ClickHouseMigrate.Adoption
    ClickHouseMigrate.Definition
    ClickHouseMigrate.Error
    ClickHouseMigrate.Event
    ClickHouseMigrate.ExclusiveAccess
    ClickHouseMigrate.Inspection
    ClickHouseMigrate.Internal.AdoptionTypes
    ClickHouseMigrate.Internal.AdoptionValidation
    ClickHouseMigrate.Internal.Checksum
    ClickHouseMigrate.Internal.EventTypes
    ClickHouseMigrate.Internal.Exclusive
    ClickHouseMigrate.Internal.ExclusiveTypes
    ClickHouseMigrate.Internal.Execution
    ClickHouseMigrate.Internal.Http
    ClickHouseMigrate.Internal.Identity
    ClickHouseMigrate.Internal.LedgerCodec
    ClickHouseMigrate.Internal.LedgerSchema
    ClickHouseMigrate.Internal.LedgerStore
    ClickHouseMigrate.Internal.LedgerTypes
    ClickHouseMigrate.Internal.LedgerValidation
    ClickHouseMigrate.Internal.Preflight
    ClickHouseMigrate.Internal.Projection
    ClickHouseMigrate.Internal.RepairTypes
    ClickHouseMigrate.Internal.Reporting
    ClickHouseMigrate.Internal.RuntimeTypes
    ClickHouseMigrate.Internal.ServerPolicy
    ClickHouseMigrate.Internal.SqlEnvelope
    ClickHouseMigrate.Internal.TargetTypes
    ClickHouseMigrate.Internal.Transport
    ClickHouseMigrate.Internal.Types
    ClickHouseMigrate.Ledger
    ClickHouseMigrate.Plan
    ClickHouseMigrate.Prelude
    ClickHouseMigrate.Repair
    ClickHouseMigrate.Report
    ClickHouseMigrate.Runner
    ClickHouseMigrate.Target
    ExclusiveTests
    LedgerTests
