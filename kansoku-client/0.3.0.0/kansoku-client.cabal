cabal-version: 3.0
name: kansoku-client
version: 0.3.0.0
synopsis: Haskell server SDK for Kansoku analytics.
description:
  A lightweight client package for emitting Kansoku analytics events from
  Haskell backend services.

license: BSD-3-Clause
author: Nadeem Bitar
maintainer: nadeem@gmail.com
category: Web
build-type: Simple
extra-source-files: CHANGELOG.md

common common
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints
    -Werror=missing-fields

  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    MultilineStrings
    OverloadedLabels
    OverloadedStrings

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Kansoku.Client
    Kansoku.Client.Metrics

  build-depends:
    aeson,
    async,
    base >=4.21 && <5,
    bytestring,
    containers,
    generic-lens >=2.2 && <2.4,
    http-client,
    http-client-tls,
    http-types,
    kansoku-api ^>=0.3.0.0,
    lens ^>=5.3,
    servant,
    servant-client,
    servant-client-core,
    stm,
    text,
    time,
    uuid,

executable kansoku-client-example
  import: common
  hs-source-dirs: example
  main-is: Main.hs
  build-depends:
    aeson,
    base >=4.21 && <5,
    kansoku-client,
    text,

test-suite kansoku-client-test
  import: common
  ghc-options: -threaded
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
    aeson,
    base >=4.21 && <5,
    bytestring,
    containers,
    generic-lens,
    hspec,
    http-client,
    http-types,
    kansoku-api ^>=0.3.0.0,
    kansoku-client,
    process,
    relay-pagination,
    relay-pagination-servant,
    servant,
    servant-client,
    stm,
    text,
    time,
    wai,
    warp,
