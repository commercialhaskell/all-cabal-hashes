name:                 is-list
version:              0.0.1
synopsis:             Fix IsList
description:          IsList in GHC is broken, use this instead. You don't get the list syntax though.
license:              BSD3
license-file:         LICENCE
author:               Tony Morris <ʇǝu˙sıɹɹoɯʇ@ןןǝʞsɐɥ>
maintainer:           Tony Morris <ʇǝu˙sıɹɹoɯʇ@ןןǝʞsɐɥ>
copyright:            Copyright (C) 2026 Tony Morris
category:             Test
build-type:           Simple
extra-source-files:   changelog.md
cabal-version:        >=1.10
homepage:             https://gitlab.com/tonymorris/is-list
bug-reports:          https://gitlab.com/tonymorris/is-list/issues
tested-with:          GHC == 9.6.7

source-repository     head
  type:               git
  location:           git@gitlab.com:tonymorris/is-list.git

library
  exposed-modules:
                      Data.List.FromList
                      Data.List.IsList

  build-depends:        base >= 4.8 && < 6
                      , lens >= 4 && < 6
                      , mtl >= 2.2 && < 3

  hs-source-dirs:     src

  default-language:   Haskell2010

  ghc-options:        -Weverything
