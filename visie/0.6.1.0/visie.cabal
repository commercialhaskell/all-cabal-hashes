-- Initial visie.cabal generated by cabal init.  For further 
-- documentation, see http://haskell.org/cabal/users-guide/

name:                visie
version:             0.6.1.0
synopsis:            generate D3 visualisations from Haskell
-- description:         
license:             PublicDomain
license-file:        LICENSE
author:              danse
maintainer:          f.occhipinti@gmail.com
-- copyright:           
-- category:            
build-type:          Simple
-- extra-source-files:  
cabal-version:       >=1.10
data-files: data/d3.v4.js,
            data/d3.v3.js,
            data/d3.v2.js,
            data/style.css,
            data/script.js
            
library
  hs-source-dirs:      src
  exposed-modules:     Visie
                       Visie.ToTimeSeries
                       Visie.Data
                       Visie.Index
  other-modules:       Paths_visie
  -- other-extensions:    
  build-depends:       aeson >= 2.3.0 && < 2.4,
                       base >= 4.19.2 && < 4.20,
                       text >= 2.1.1 && < 2.2,
                       scientific >= 0.3.8 && < 0.4,
                       vector >= 0.13.2 && < 0.14,
                       time >= 1.12.2 && < 1.13,
                       browse >= 0.5.0 && < 0.6
  default-language:    Haskell2010

Test-Suite test
           type: exitcode-stdio-1.0
           hs-source-dirs:      test
           main-is: main.hs
           build-depends: base, text, visie
           default-language:    Haskell2010
