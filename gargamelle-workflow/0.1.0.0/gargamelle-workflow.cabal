cabal-version: 3.0
name: gargamelle-workflow
version: 0.1.0.0
synopsis: Synthesis workflow, Crem state machine, and end-to-end integration
description:
  Synthesis workflow orchestration, Crem verified state machine integration,
  and end-to-end CEGIS execution for Gargamelle. Connects logical reasoning,
  models, evidence, effects, and sandboxes into an automated synthesizer.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Development
homepage: https://github.com/NadiaYvette/gargamelle
bug-reports: https://github.com/NadiaYvette/gargamelle/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with:
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/gargamelle
  subdir: packages/gargamelle-workflow

library
  exposed-modules:
    Workflow.Synthesis
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    tree-diff >= 0.3 && < 0.5,
    crem >= 0.1 && < 0.2,
    singletons-base >= 3.0 && < 3.6,
    polytropos-core >= 0.1.0.1 && < 0.2,
    gargamelle-core >= 0.1 && < 0.2,
    gargamelle-evidence >= 0.1 && < 0.2,
    gargamelle-effect >= 0.1 && < 0.2,
    gargamelle-persistence >= 0.1 && < 0.2,
    gargamelle-sandbox >= 0.1 && < 0.2,
    gargamelle-sheaf >= 0.1 && < 0.2,
    gargamelle-model >= 0.1 && < 0.2,
    gargamelle-logic >= 0.1 && < 0.2,
    sqlite-simple >= 0.4 && < 0.5,
    beam-core >= 0.10 && < 0.12,
    beam-sqlite >= 0.5 && < 0.8,
    lattices >= 2.2 && < 2.3

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    gargamelle-core >= 0.1 && < 0.2,
    gargamelle-fol >= 0.1 && < 0.2,
    gargamelle-equational >= 0.1 && < 0.2,
    gargamelle-evidence >= 0.1 && < 0.2,
    gargamelle-effect >= 0.1 && < 0.2,
    gargamelle-persistence >= 0.1 && < 0.2,
    gargamelle-sandbox >= 0.1 && < 0.2,
    gargamelle-sheaf >= 0.1 && < 0.2,
    gargamelle-model >= 0.1 && < 0.2,
    gargamelle-logic >= 0.1 && < 0.2,
    gargamelle-workflow,
    hspec >= 2.10 && < 2.12,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    beam-core >= 0.10 && < 0.12,
    beam-sqlite >= 0.5 && < 0.8,
    sqlite-simple >= 0.4 && < 0.5,
    crem >= 0.1 && < 0.2,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    process >= 1.6 && < 1.7,
    tree-diff >= 0.3 && < 0.5,
    lattices >= 2.2 && < 2.3
