cabal-version:       2.2
name:                JuicyPixels-blp
version:             0.3.0.0
synopsis:            BLP format decoder/encoder over JuicyPixels library
description:
  The library provides decoding/encoding functions for BLP1 texture format of Warcraft III game.
  The result is represented in types of [JuicyPixels](http://hackage.haskell.org/package/JuicyPixels) library.

  Please see README.md for detailed description.
homepage:            https://github.com/NCrashed/JuicyPixels-blp#readme
license:             BSD-3-Clause
license-file:        LICENSE
author:              Anton Gushcha
maintainer:          ncrashed@gmail.com
copyright:           2015-2026 Anton Gushcha
category:            Codec, Graphics, Image
build-type:          Simple
extra-doc-files:     README.md, CHANGELOG.md
tested-with:
  GHC == 9.4.8
   || == 9.6.7
   || == 9.8.4
   || == 9.10.3
   || == 9.12.3
   || == 9.14.1

source-repository head
  type:      git
  location:  https://github.com/NCrashed/JuicyPixels-blp.git

common warnings
  ghc-options:         -Wall -Wcompat

library
  import:              warnings
  hs-source-dirs:      src
  exposed-modules:
    Codec.Picture.Blp
    Codec.Picture.Blp.Internal.Convert
    Codec.Picture.Blp.Internal.Data
    Codec.Picture.Blp.Internal.Encoder
    Codec.Picture.Blp.Internal.Parser

  default-language:    Haskell2010
  build-depends:
      base                  >= 4.17   && < 5
    , attoparsec            >= 0.12   && < 0.15
    , binary                >= 0.8    && < 0.10
    , bytestring            >= 0.10   && < 0.13
    , JuicyPixels           >= 3.2    && < 3.4
    , vector                >= 0.10   && < 0.14

  default-extensions:
    BangPatterns
    DeriveGeneric
    MultiWayIf
    OverloadedStrings
    RecordWildCards

executable blp2any
  import:              warnings
  hs-source-dirs:      blp2any
  main-is:             Main.hs
  other-modules:
    Convert
    File
    Statistics
  ghc-options:       -threaded -rtsopts -with-rtsopts=-N
  default-language:    Haskell2010
  build-depends:
      base
    , bytestring
    , containers            >= 0.6    && < 0.9
    , directory             >= 1.2    && < 1.4
    , filepath              >= 1.4    && < 1.6
    , JuicyPixels
    , JuicyPixels-blp
    , optparse-simple       >= 0.0.3  && < 0.2

  default-extensions:
    RecordWildCards

test-suite spec
  import:              warnings
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Main.hs
  other-modules:
    Fixture
  default-language:    Haskell2010
  build-depends:
      base
    , bytestring
    , directory
    , filepath
    , JuicyPixels
    , JuicyPixels-blp
    , tasty                 >= 1.4    && < 1.6
    , tasty-hunit           >= 0.10   && < 0.11

  default-extensions:
    OverloadedStrings
    RecordWildCards
