cabal-version:       2.2
name:                JuicyPixels-blp
version:             0.5.0.0
synopsis:            BLP format decoder/encoder over JuicyPixels library
description:
  Read and write BLP1, the texture format of Warcraft III, with images as
  [JuicyPixels](https://hackage.haskell.org/package/JuicyPixels) types.
  Supports JPEG and paletted content with and without alpha, mipmaps, and
  the non-standard files common in community maps. Includes @blp2any@, a
  converter between BLP and PNG, JPEG, TIFF, GIF and BMP.
  .
  See the README for usage and limitations, and @docs/format.md@ for the
  file format.
homepage:            https://github.com/NCrashed/JuicyPixels-blp#readme
license:             BSD-3-Clause
license-file:        LICENSE
author:              Anton Gushcha
maintainer:          ncrashed@gmail.com
copyright:           2015-2026 Anton Gushcha
category:            Codec, Graphics, Image
build-type:          Simple
extra-doc-files:     README.md, CHANGELOG.md, docs/format.md
tested-with:
  GHC == 9.4.8
   || == 9.6.7
   || == 9.8.4
   || == 9.10.3
   || == 9.12.3
   || == 9.14.1

source-repository head
  type:      git
  location:  https://github.com/NCrashed/JuicyPixels-blp.git

common warnings
  ghc-options:         -Wall -Wcompat

library
  import:              warnings
  hs-source-dirs:      src
  exposed-modules:
    Codec.Picture.Blp
    Codec.Picture.Blp.Internal.Convert
    Codec.Picture.Blp.Internal.Data
    Codec.Picture.Blp.Internal.Encoder
    Codec.Picture.Blp.Internal.Parser

  default-language:    Haskell2010
  build-depends:
      base                  >= 4.17   && < 5
    , attoparsec            >= 0.14.4 && < 0.15
    , binary                >= 0.8.9  && < 0.10
    , bytestring            >= 0.11.5 && < 0.13
    , deepseq               >= 1.4.8  && < 1.6
    , JuicyPixels           >= 3.3.6  && < 3.4
    , vector                >= 0.12.3 && < 0.14

  default-extensions:
    BangPatterns
    DeriveGeneric
    MultiWayIf
    OverloadedStrings
    RecordWildCards

executable blp2any
  import:              warnings
  hs-source-dirs:      blp2any
  main-is:             Main.hs
  other-modules:
    Convert
    File
    Statistics
    Paths_JuicyPixels_blp
  autogen-modules:
    Paths_JuicyPixels_blp
  ghc-options:       -threaded -rtsopts -with-rtsopts=-N
  default-language:    Haskell2010
  build-depends:
      base
    , bytestring
    , containers            >= 0.6    && < 0.9
    , directory             >= 1.3.7  && < 1.4
    , filepath              >= 1.4.2  && < 1.6
    , JuicyPixels
    , JuicyPixels-blp
    , optparse-simple       >= 0.1    && < 0.2
    , transformers          >= 0.5.6  && < 0.7

  default-extensions:
    RecordWildCards

benchmark bench
  import:              warnings
  type:                exitcode-stdio-1.0
  hs-source-dirs:      bench
  main-is:             Main.hs
  default-language:    Haskell2010
  ghc-options:         -rtsopts -with-rtsopts=-A32m
  build-depends:
      base
    , bytestring
    , deepseq
    , JuicyPixels
    , JuicyPixels-blp
    , tasty-bench           >= 0.3    && < 0.5

test-suite spec
  import:              warnings
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Main.hs
  -- No test needs more; a decoder that allocates without bound fails loudly.
  ghc-options:         -rtsopts -with-rtsopts=-M1g
  other-modules:
    Deprecated
    Fixture
    Properties
  default-language:    Haskell2010
  build-depends:
      base
    , bytestring
    , directory
    , filepath
    , JuicyPixels
    , JuicyPixels-blp
    , tasty                 >= 1.4    && < 1.6
    , deepseq
    , QuickCheck            >= 2.14   && < 2.17
    , tasty-hunit           >= 0.10   && < 0.11
    , tasty-quickcheck      >= 0.10.2 && < 0.12

  default-extensions:
    OverloadedStrings
    RecordWildCards
