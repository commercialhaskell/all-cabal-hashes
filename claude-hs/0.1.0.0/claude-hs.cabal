cabal-version: 3.4
name: claude-hs
version: 0.1.0.0
synopsis: Client for the Anthropic Claude Messages API
description: Typed client for the direct Anthropic Messages API.
category: Network
license: MIT
license-file: LICENSE
author: Nadeem Bitar
maintainer: Nadeem Bitar
homepage: https://github.com/shinzui/claude-hs
bug-reports: https://github.com/shinzui/claude-hs/issues
build-type: Simple
tested-with: ghc ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md
  docs/messages-coverage.md

source-repository head
  type: git
  location: https://github.com/shinzui/claude-hs

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options: -Wall
  build-depends: base >=4.21 && <5

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Claude.Batches
    Claude.Client
    Claude.Messages
    Claude.Messages.Features
    Claude.Streaming

  other-modules:
    Claude.Internal.Http
    Claude.Internal.Request
    Claude.Internal.Sse
    Claude.Messages.Usage

  build-depends:
    aeson >=2.2 && <2.4,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.9,
    generic-lens >=2.2 && <2.4,
    http-client >=0.7.18 && <0.8,
    http-client-tls >=0.3.6 && <0.5,
    http-types >=0.12 && <0.13,
    lens >=5.2 && <5.4,
    text >=2.1 && <2.2,
    time >=1.12 && <1.17,
    transformers >=0.6 && <0.7,

executable claude-message-example
  import: common
  hs-source-dirs: example
  main-is: Main.hs
  build-depends:
    bytestring,
    claude-hs,
    text,

test-suite claude-hs-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    BatchesSpec
    FeaturesSpec
    MessagesSpec
    StreamingSpec
    Support.Server

  ghc-options: -threaded
  build-depends:
    aeson,
    bytestring,
    claude-hs,
    containers,
    generic-lens,
    http-types,
    lens,
    text,
    time,
    wai >=3.2 && <3.3,
    warp >=3.3 && <3.6,
