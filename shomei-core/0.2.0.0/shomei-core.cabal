    , async           >=2.2      && <2.3
    , base            >=4.18     && <5
    , bytestring      >=0.11     && <0.13
    , containers      >=0.6      && <0.9
    , effectful       >=2.5      && <2.8
    , effectful-core  >=2.5      && <2.8
    , generic-lens    >=2.2      && <2.4
