cabal-version:      3.0
name:               herald
version:            0.1.0.1
synopsis:           Write sheet music as Haskell code and synthesize it
description:
    Herald synthesizes music from scores written as Haskell code, with named
    pitches, key signatures, checked bars, ties, dynamics and several voices.
    Voices are performed by simple instruments (pure tones, additive, organ
    and a Karplus-Strong harpsichord) in equal temperament or historical
    tunings, and rendered to mono or stereo WAV or played through ffplay.
    Start with the "Herald" module, which re-exports the whole library.
homepage:           https://github.com/joaquin-rossi/herald
bug-reports:        https://github.com/joaquin-rossi/herald/issues
license:            AGPL-3.0-or-later
license-file:       LICENSE
author:             Joaquín Rossi
maintainer:         joaquin@joaquinrossi.net
category:           Sound
build-type:         Simple
tested-with:        GHC ==9.10.3 || ==9.12.4 || ==9.14.1
extra-doc-files:    README.md

source-repository head
    type:     git
    location: https://github.com/joaquin-rossi/herald.git

common common
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wmissing-export-lists
        -Wredundant-constraints
        -Wunused-packages

library
    import:           common
    hs-source-dirs:   src
    exposed-modules:
        Herald
        Herald.Performance
        Herald.Performance.Instrument
        Herald.Score
        Herald.Score.Duration
        Herald.Score.Dynamic
        Herald.Score.Pitch
        Herald.Sound
        Herald.Sound.IO
        Herald.Tuning

    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.12 && <0.13,
        containers >=0.7 && <0.9,
        mtl >=2.3.1 && <2.4,
        process >=1.6.19 && <1.7,
        vector >=0.13.1 && <0.14,

test-suite herald-test
    import:           common
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base,
        bytestring,
        herald,
        tasty >=1.4.2 && <1.6,
        tasty-hunit >=0.10 && <0.11,
        vector,
