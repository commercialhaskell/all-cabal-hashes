-- Developer harness, requiring a provisioned server and a Git/evidence checkout
-- for the complete Python workflow. See docs/RELEASING.md before distribution.
executable mariadb-validation
  import: common-options
  if !flag(validation)
    buildable: False
  default-extensions: OverloadedStrings
  hs-source-dirs: validation/hs
  main-is: Main.hs
  other-modules:
    Validation.Common
    Validation.Protocol
    Validation.Functional
    Validation.Reliability
    Validation.Security
    Validation.CDC
    Validation.Benchmark
    Validation.Supplementary
    Validation.Stage1
    Validation.Stage2
    Validation.Stage3
    Validation.Stage3Bench
    Validation.Stage4
    Validation.Stage4Bench
    Validation.Stage5
    Validation.Stage5Review
    Validation.Stage5Bench
    Validation.Stage6
    Validation.Stage6Bench
    Validation.Stage6Review
    Validation.Stage7
    Validation.Stage7Bench
    Validation.ExternalAuthFixture
    Validation.WireProxy
    Validation.FaultTransport
  build-depends:
    binary, bytestring, containers, filepath >=1.4 && <1.6, io-streams, mariadb-haskell, network, scientific, text, time, tls, vector, zlib, process >=1.6 && <1.7, directory >=1.3 && <1.4
  ghc-options: -threaded -rtsopts -with-rtsopts=-T
