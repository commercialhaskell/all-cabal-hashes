cabal-version:   3.12
name:            effectful-streamly
version:         0.1.0.0
synopsis:        Concurrent Streamly streams in Effectful
description:
  Streamly runs concurrent streams in worker threads, which the default
  unlifting strategy of Effectful refuses. This package makes the
  concurrent combinators of streamly work in Eff: a drop-in replacement
  for Streamly.Data.Stream.Prelude, and the wrapper it is built on.

homepage:        https://github.com/GuillaumedeVolpiano/effectful-streamly
license:         BSD-3-Clause
license-file:    LICENSE
author:          Xavier Dectot
maintainer:      Xavier Dectot <xavier@wheredoibegin.fr>
category:        Control, Streaming, Concurrency
build-type:      Simple
tested-with:     GHC ==9.8.4 || ==9.10.3 || ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://github.com/GuillaumedeVolpiano/effectful-streamly.git

common shared
  default-language: GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies
    DisambiguateRecordFields
    ExplicitNamespaces
    GADTs
    LambdaCase
    MonoLocalBinds
    RoleAnnotations
  ghc-options:
    -Wall -Wcompat -Wredundant-constraints -Wmissing-deriving-strategies
    -Wunused-packages

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Effectful.Streamly
    Effectful.Streamly.Stream

  build-depends:
    , base           >=4.19 && <4.22
    , effectful-core ^>=2.7.1
    , streamly       ^>=0.11.1
    , streamly-core  ^>=0.3.3

test-suite effectful-streamly-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , base
    , effectful-core
    , effectful-streamly
    , streamly
    , streamly-core
    , tasty              ^>=1.5
    , tasty-hunit        ^>=0.10
