cabal-version:      3.0
name:               wec
version:            0.1.0.0
synopsis:           wav echo effect
homepage:           https://github.com/dopamane/wec
license:            MIT
license-file:       LICENSE
author:             dopamane
maintainer:         dwc1295@gmail.com
copyright:          David Cox
category:           Sound
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md

source-repository head
  type: git
  location: https://github.com/dopamane/wec

library
  default-language: Haskell2010
  ghc-options:      -Wall -O2
  hs-source-dirs:   lib
  exposed-modules:  Sound.Echo
  build-depends:    base < 5

executable wec
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded
  hs-source-dirs:   exe
  main-is:          Main.hs
  other-modules:    Paths_wec
  autogen-modules:  Paths_wec
  build-depends:
    base < 5,
    binary,
    bytestring,
    optparse-applicative,
    rap,
    wec

test-suite test
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded
  hs-source-dirs:   test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  build-depends:
    base < 5,
    tasty,
    tasty-hunit,
    wec
