cabal-version: 3.0
name: gargamelle-sandbox
version: 0.1.0.0
synopsis: Bubblewrap namespace sandboxing and resource limit enforcement
description:
  Bubblewrap namespace sandboxing and resource limit enforcement for
  Gargamelle. Provides isolated filesystem views, unshared PID and
  network namespaces, and subprocess fallback execution for safe
  verification.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: System
homepage: https://github.com/NadiaYvette/gargamelle
bug-reports: https://github.com/NadiaYvette/gargamelle/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with:
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/gargamelle
  subdir: packages/gargamelle-sandbox

library
  exposed-modules:
    Sandbox.Effect
    Sandbox.Handler
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    text >= 2.0 && < 2.2,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    process >= 1.6 && < 1.7,
    polytropos-core >= 0.1.0.1 && < 0.2,
    gargamelle-core >= 0.1 && < 0.2

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    gargamelle-sandbox,
    text >= 2.0 && < 2.2,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    hspec >= 2.10 && < 2.12
