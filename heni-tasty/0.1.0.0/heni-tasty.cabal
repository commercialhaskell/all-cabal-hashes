cabal-version: 3.4
name: heni-tasty
version: 0.1.0.0
synopsis: Attempt-bound Tasty evidence for Heni
license: BSD-3-Clause
license-file: LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
copyright: 2026 Nadeem Bitar
category: Testing
build-type: Simple
tested-with: ghc ==9.12.4
homepage: https://github.com/shinzui/heni
bug-reports: https://github.com/shinzui/heni/issues
description: Optional framework reporter for trustworthy named mutation evidence.
extra-doc-files:
  CHANGELOG.md
  README.md

common common
  default-language: GHC2024
  default-extensions:
    DuplicateRecordFields
    OverloadedStrings

  ghc-options: -Wall
  build-depends:
    base >=4.21.2 && <4.22,
    containers >=0.7 && <0.9,
    heni ==0.1.0.0,
    text >=2.1.4 && <2.2,

library
  import: common
  hs-source-dirs: src
  exposed-modules: Test.Heni.Tasty
  build-depends:
    stm >=2.5.3.1 && <2.6,
    tasty >=1.5.5 && <1.6,

executable heni-tasty-fixture
  import: common
  hs-source-dirs: test/fixture
  main-is: Main.hs
  build-depends:
    heni-tasty ==0.1.0.0,
    stm >=2.5.3.1 && <2.6,
    tasty >=1.5.5 && <1.6,
    tasty-hunit >=0.10.2 && <0.11,

  ghc-options: -threaded

test-suite heni-tasty-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    directory >=1.3.10.1 && <1.4,
    filepath >=1.5.5 && <1.6,
    heni-tasty ==0.1.0.0,
    process >=1.6.26.1 && <1.7,
    unix >=2.8.8 && <2.9,

  build-tool-depends:
    heni-cli:heni,
    heni-tasty:heni-tasty-fixture,

  ghc-options: -threaded

source-repository head
  type: git
  location: https://github.com/shinzui/heni.git
  subdir: adapters/heni-tasty
