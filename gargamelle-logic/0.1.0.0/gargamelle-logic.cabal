cabal-version: 3.0
name: gargamelle-logic
version: 0.1.0.0
synopsis: Pure syntax, order theory, and refinement calculi for Gargamelle
description:
  Pure syntax, defunctionalized arrows, order theory, and refinement
  calculi for the Gargamelle institutional synthesis framework.
  Provides Galois connections, behavioral contracts, holes, and MPST
  multiparty session types.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Logic
homepage: https://github.com/NadiaYvette/gargamelle
bug-reports: https://github.com/NadiaYvette/gargamelle/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with:
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/gargamelle
  subdir: packages/gargamelle-logic

library
  exposed-modules:
    Gargamelle.Logic.Signature
    Gargamelle.Logic.Syntax
    Gargamelle.Logic.Defunctionalize
    Gargamelle.Logic.Order
    Gargamelle.Logic.Galois
    Gargamelle.Logic.Contract
    Gargamelle.Logic.Hole
    Gargamelle.Logic.MPST
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.18 && < 5,
    containers >= 0.6 && < 0.9,
    polytropos-core >= 0.1.0.1 && < 0.2,
    lattices >= 2.2 && < 2.3,
    constraints >= 0.14 && < 0.15,
    profunctors >= 5.6 && < 5.7

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.18 && < 5,
    gargamelle-logic,
    polytropos-core >= 0.1.0.1 && < 0.2,
    lattices >= 2.2 && < 2.3,
    constraints >= 0.14 && < 0.15,
    profunctors >= 5.6 && < 5.7,
    hspec >= 2.10 && < 2.12
