cabal-version: 3.0
name: polytropos-mcp
version: 0.1.0.2
synopsis: Model Context Protocol (MCP) server integration for polytropos
description:
  Model Context Protocol (MCP) tool integration and JSON-RPC dispatch for
  <https://hackage.haskell.org/package/polytropos polytropos> open records and variants.

  Synthesizes MCP tool definitions and OpenAPI input schemas directly from
  polytropos open records, and dispatches tool execution requests to open variant
  handlers with O(1) jump table elimination. Includes a stdio transport runner
  for AI coding agents and language models.

  Start at the front door module "Polytropos.MCP" for protocol types,
  tool builders, and worked examples.
license: EUPL-1.2 OR Apache-2.0
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Web, AI
homepage: https://github.com/NadiaYvette/polytropos
bug-reports: https://github.com/NadiaYvette/polytropos/issues
extra-doc-files:
    README.md
  , CHANGELOG.md
build-type: Simple

source-repository head
  type:     git
  location: https://github.com/NadiaYvette/polytropos
  subdir:   packages/polytropos-mcp

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.MCP
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    aeson >= 2.0 && < 2.3,
    bytestring >= 0.10 && < 0.13,
    text >= 1.2 && < 2.2,
    openapi3 >= 3.2 && < 3.3,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2,
    polytropos-aeson >= 0.1 && < 0.2,
    polytropos-openapi3 >= 0.1 && < 0.2

test-suite polytropos-mcp-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -fplugin=Polytropos.Plugin
  build-depends:
    base,
    aeson,
    bytestring,
    text,
    openapi3,
    polytropos-core,
    polytropos-plugin,
    polytropos-aeson,
    polytropos-openapi3,
    polytropos-mcp,
    tasty,
    tasty-hunit
