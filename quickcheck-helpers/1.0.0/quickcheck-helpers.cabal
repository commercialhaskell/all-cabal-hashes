cabal-version: 3.0
name: quickcheck-helpers
version: 1.0.0
synopsis: Helpers for writing shrinkers.
description:
  Provides a way to write shrinkers both concisely and easily, while
  not sacrificing effectiveness.

license: MIT
author: Koz Ross
maintainer: koz@mlabs.city
copyright: (C) MLabs 2026
category: Test
build-type: Simple
tested-with: ghc =={9.8.4, 9.10.3, 9.12.4, 9.14.1}
extra-source-files:
  CHANGELOG.md
  LICENSE.md
  README.md

common lang
  build-depends: base >=4.19.0.0 && <5
  ghc-options:
    -Wmissing-export-lists
    -Wall
    -Wcompat
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wredundant-constraints
    -Wmissing-deriving-strategies
    -Wredundant-bang-patterns

  default-language: Haskell2010

library
  import: lang
  exposed-modules: Test.QuickCheck.Helpers
  build-depends: QuickCheck ^>=2.18.0.0
  hs-source-dirs: src

test-suite tests
  import: lang
  type: exitcode-stdio-1.0
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  main-is: Main.hs
  hs-source-dirs: test
  build-depends:
    QuickCheck,
    quickcheck-helpers,
    tasty ^>=1.5.5,
    tasty-quickcheck ^>=0.11.1,
    tasty-quickcheck-laws ^>=0.0.3,
