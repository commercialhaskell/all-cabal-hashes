cabal-version:   3.12
name:            streamly-websockets
version:         0.1.0.0
synopsis:        WebSocket clients and servers written with Streamly
description:
  WebSockets (RFC 6455) over plain TCP, for clients and for servers. The
  opening handshake goes through streamly-http, frames are read with
  flatparse parsers from the stream of byte arrays of the connection, and
  the messages received are a stream. Pings are answered, fragmented
  messages put together, and the closing handshake done. TLS through a
  transport of the caller; no extension.

homepage:        https://github.com/GuillaumedeVolpiano/streamly-websockets
license:         BSD-3-Clause
license-file:    LICENSE
author:          Xavier Dectot
maintainer:      Xavier Dectot <xavier@wheredoibegin.fr>
category:        Network, Web, Streamly
build-type:      Simple
tested-with:     GHC ==9.8.4 || ==9.10.3 || ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://github.com/GuillaumedeVolpiano/streamly-websockets.git

common shared
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies
    DisambiguateRecordFields
    DuplicateRecordFields
    ExplicitNamespaces
    GADTs
    LambdaCase
    MonoLocalBinds
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    RoleAnnotations

  ghc-options:
    -Wall -Wcompat -Wredundant-constraints -Wmissing-deriving-strategies
    -Wunused-packages

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Streamly.External.Network.WebSocket
    Streamly.External.Network.WebSocket.Frame
    Streamly.External.Network.WebSocket.Handshake
    Streamly.External.Network.WebSocket.Server

  other-modules:   Streamly.External.Network.WebSocket.Connection

  build-depends:
    , base                 >=4.19 && <4.22
    , base64-bytestring    ^>=1.2
    , bytestring           ^>=0.12
    , cryptohash-sha1      ^>=0.11
    , entropy              ^>=0.4
    , flatparse            ^>=0.5
    , network              ^>=3.2
    , stm                  ^>=2.5
    , streamly-bytestring  ^>=0.2.3
    , streamly-core        ^>=0.3.3
    , streamly-flatparse   ^>=0.1
    , streamly-http        ^>=0.1
    , streamly-network-tcp ^>=0.1
    , text                 ^>=2.1

test-suite streamly-websockets-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , async                ^>=2.2
    , base
    , bytestring
    , network
    , stm
    , streamly-bytestring
    , streamly-core
    , streamly-http
    , streamly-websockets
    , tasty                ^>=1.5
    , tasty-hunit          ^>=0.10
    , tasty-quickcheck     ^>=0.11
    , text
    , websockets           ^>=0.13
