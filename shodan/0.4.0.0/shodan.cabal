cabal-version: 2.4
name: shodan
version: 0.4.0.0
license: BSD-3-Clause
license-file: LICENSE
synopsis: A simple Haskell client for the Shodan API
description:
  A small Shodan API client using ordinary records and explicit IO functions.
  Supports API plan information, search result counts, paginated searches,
  and domain DNS information,
  with JSON response types for facet statistics. Includes executable examples
  and local HTTP tests.
category: Network
author: Joonkyu Park
maintainer: vpark45@gmail.com
homepage: https://github.com/nattybear/shodan
bug-reports: https://github.com/nattybear/shodan/issues
tested-with: GHC == 9.8.4
build-type: Simple
extra-source-files: README.md, CHANGELOG.md, .stylish-haskell.yaml

source-repository head
  type: git
  location: https://github.com/nattybear/shodan.git

library
  exposed-modules: Shodan
  hs-source-dirs: src
  build-depends:
    base >= 4.19 && < 5,
    aeson >= 2.1 && < 2.3,
    containers >= 0.6 && < 0.8,
    http-client >= 0.7 && < 0.8,
    http-client-tls >= 0.3 && < 0.4,
    http-types >= 0.12 && < 0.13,
    text >= 2.1 && < 2.2
  default-language: Haskell2010
  ghc-options: -Wall

executable shodan-api-info
  main-is: Main.hs
  hs-source-dirs: examples/api-info
  build-depends:
    base >= 4.19 && < 5,
    shodan,
    text >= 2.1 && < 2.2
  default-language: Haskell2010
  ghc-options: -Wall -threaded

executable shodan-count
  main-is: Main.hs
  hs-source-dirs: examples/count
  build-depends:
    base >= 4.19 && < 5,
    shodan,
    text >= 2.1 && < 2.2
  default-language: Haskell2010
  ghc-options: -Wall -threaded

executable shodan-search
  main-is: Main.hs
  hs-source-dirs: examples/search
  build-depends:
    base >= 4.19 && < 5,
    shodan,
    text >= 2.1 && < 2.2
  default-language: Haskell2010
  ghc-options: -Wall -threaded

executable shodan-domain
  main-is: Main.hs
  hs-source-dirs: examples/domain
  build-depends:
    base >= 4.19 && < 5,
    shodan,
    text >= 2.1 && < 2.2
  default-language: Haskell2010
  ghc-options: -Wall -threaded

test-suite shodan-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules: SearchTests, DnsTests
  hs-source-dirs: test
  build-depends:
    base >= 4.19 && < 5,
    aeson >= 2.1 && < 2.3,
    bytestring >= 0.12 && < 0.13,
    containers >= 0.6 && < 0.8,
    http-client >= 0.7 && < 0.8,
    http-types >= 0.12 && < 0.13,
    shodan,
    text >= 2.1 && < 2.2,
    wai >= 3.2 && < 3.3,
    warp >= 3.3 && < 3.5
  default-language: Haskell2010
  ghc-options: -Wall -threaded
