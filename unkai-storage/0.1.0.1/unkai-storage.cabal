cabal-version: 3.12
name: unkai-storage
version: 0.1.0.1
synopsis: Google Cloud Storage JSON SDK.
homepage: https://github.com/shinzui/unkai
bug-reports: https://github.com/shinzui/unkai/issues
license: MPL-2.0
license-file: LICENSE
author: Brendan Hay, Nadeem Bitar
maintainer: Nadeem Bitar <nadeem@gmail.com>
copyright: Copyright (c) 2015-2025 Brendan Hay, (c) 2026 Nadeem Bitar
category: Google
build-type: Simple
tested-with: ghc ==9.12.4
extra-doc-files: README.md
extra-source-files: src/.gitkeep
description:
    Stores and retrieves potentially large, immutable data objects.
  .
  Generated by @unkai-gen@ from the Google Discovery document.
  .
  This library is compatible with version @v1@
  of the API.
  .
  Labels:
  .
  * Labs

source-repository head
  type: git
  location: https://github.com/shinzui/unkai.git
  subdir: lib/services/unkai-storage

flag field-selectors
  description: Enable record field selectors. When disabled (the default), fields are accessed with generic-lens labels or record dot syntax.
  default: False
  manual: True

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -Wunused-packages
    -Wmissing-deriving-strategies
    -fhide-source-paths
    -funbox-strict-fields

library
  import: common
  hs-source-dirs:
    src
    gen

  if !flag(field-selectors)
    default-extensions: NoFieldSelectors
  exposed-modules:
    Unkai.Storage
    Unkai.Storage.AnywhereCaches.Disable
    Unkai.Storage.AnywhereCaches.Get
    Unkai.Storage.AnywhereCaches.Insert
    Unkai.Storage.AnywhereCaches.List
    Unkai.Storage.AnywhereCaches.Pause
    Unkai.Storage.AnywhereCaches.Resume
    Unkai.Storage.AnywhereCaches.Update
