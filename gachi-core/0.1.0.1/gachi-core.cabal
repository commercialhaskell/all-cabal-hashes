cabal-version: 3.0
name: gachi-core
version: 0.1.0.1
synopsis: Osteological memory representations and lock-free sync for Gachi
description:
  Foundational osteological memory representations and lock-free synchronization
  for the Gachi ecosystem engine. Provides Polytropos-backed osteological data
  structures, atomic rewriting primitives, and concurrent graph traversals.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Data, Concurrency
homepage: https://github.com/NadiaYvette/gachi
bug-reports: https://github.com/NadiaYvette/gachi/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with:
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/gachi
  subdir: packages/gachi-core

library
  exposed-modules:
    Gachi.Core
    Gachi.Core.Atomic
    Gachi.Core.Rewriting
    Gachi.Core.Traversal
    Gachi.Osteology
    Gachi.Osteology.Atomic
    Gachi.Osteology.Polytropos
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    primitive >= 0.8 && < 0.10,
    containers >= 0.6 && < 0.9,
    text >= 2.0 && < 2.2,
    polytropos-core >= 0.1 && < 0.2

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    gachi-core,
    primitive >= 0.8 && < 0.10,
    containers >= 0.6 && < 0.9,
    text >= 2.0 && < 2.2,
    hspec >= 2.10 && < 2.12,
    polytropos-core >= 0.1 && < 0.2
