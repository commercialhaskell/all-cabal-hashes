cabal-version: 3.0
name: gachi-core
version: 0.1.0.0
synopsis: Foundational osteological memory representations and lock-free synchronization
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
build-type: Simple
tested-with:
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

library
  exposed-modules:
    Gachi.Core
    Gachi.Core.Atomic
    Gachi.Core.Rewriting
    Gachi.Core.Traversal
    Gachi.Osteology
    Gachi.Osteology.Atomic
    Gachi.Osteology.Polytropos
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    primitive >= 0.8,
    containers >= 0.6,
    text >= 2.0,
    polytropos-core >= 0.1 && < 0.2

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    gachi-core,
    primitive >= 0.8,
    containers >= 0.6,
    text >= 2.0,
    hspec >= 2.10,
    polytropos-core
