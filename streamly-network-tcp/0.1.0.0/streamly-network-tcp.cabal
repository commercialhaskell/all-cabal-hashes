cabal-version:   3.12
name:            streamly-network-tcp
version:         0.1.0.0
synopsis:        TCP connections as Streamly streams, for clients and servers
description:
  The ground under the Streamly network libraries of this family: opening
  a TCP connection to a host by its name, listening, serving each client
  in a thread of its own, and a transport, the pair of a way to send byte
  arrays and a stream of those received, that protocols are written
  against so that they run over TCP, TLS or anything else.

homepage:        https://github.com/GuillaumedeVolpiano/streamly-network-tcp
license:         BSD-3-Clause
license-file:    LICENSE
author:          Xavier Dectot
maintainer:      Xavier Dectot <xavier@wheredoibegin.fr>
category:        Network, Streamly
build-type:      Simple
tested-with:     GHC ==9.8.4 || ==9.10.3 || ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://github.com/GuillaumedeVolpiano/streamly-network-tcp.git

common shared
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies
    DisambiguateRecordFields
    DuplicateRecordFields
    ExplicitNamespaces
    GADTs
    LambdaCase
    MonoLocalBinds
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    RoleAnnotations

  ghc-options:
    -Wall -Wcompat -Wredundant-constraints -Wmissing-deriving-strategies
    -Wunused-packages

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Streamly.External.Network.TCP
  build-depends:
    , base           >=4.19 && <4.22
    , network        ^>=3.2
    , streamly       ^>=0.11.1
    , streamly-core  ^>=0.3.3

test-suite streamly-network-tcp-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , async                ^>=2.2
    , base
    , bytestring           ^>=0.12
    , network
    , streamly-bytestring  ^>=0.2.3
    , streamly-core
    , streamly-network-tcp
    , tasty                ^>=1.5
    , tasty-hunit          ^>=0.10
