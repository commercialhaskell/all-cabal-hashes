cabal-version: 3.4
name: shikumi-evidence
version: 0.1.0.0
synopsis: Production-evidence optimization and promotion reports for shikumi programs
category: AI
description:
  Provenance-bearing envelopes and a composed driver around the shikumi
  optimizer. A trusted job hands the driver a sealed dataset of production
  evidence, a baseline program artifact, an optimizer with a budget and a
  declared metric policy. The driver optimizes on the training and validation
  splits only, compares baseline and candidate once on the protected holdout
  under recorded or replayed provider responses, and returns a candidate program
  artifact and a comparison report whose conclusion is exactly one of
  @Improved@, @Regressed@, @Inconclusive@ or @Invalid@. Every artifact carries a
  BLAKE3 content digest so a lifecycle owner can verify what a report binds.
  The package decides comparisons only: it never activates a candidate, holds
  no credential and performs no file access.

license: BSD-3-Clause
author: Nadeem Bitar
maintainer: nadeem@gmail.com
build-type: Simple
extra-doc-files: CHANGELOG.md
extra-source-files:
  fixtures/uc7/*.json
  fixtures/uc7/costly/*.json
  fixtures/uc7/good/*.json

common common-options
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies

  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    Shikumi.Evidence
    Shikumi.Evidence.Artifact
    Shikumi.Evidence.Dataset
    Shikumi.Evidence.Digest
    Shikumi.Evidence.Driver
    Shikumi.Evidence.Exposure
    Shikumi.Evidence.Policy
    Shikumi.Evidence.Recording
    Shikumi.Evidence.Report
    Shikumi.Evidence.Source

  other-modules:
    Shikumi.Evidence.Dataset.Internal

  build-depends:
    aeson >=2.2 && <2.3,
    baikai >=0.11.0.0 && <0.12,
    base >=4.20 && <5,
    blake3 >=0.3 && <0.4,
    bytestring >=0.11 && <0.13,
    containers >=0.6 && <0.9,
    effectful >=2.6 && <2.8,
    generic-lens >=2.2 && <2.4,
    lens ^>=5.3,
    shikumi ^>=0.5.1.1,
    shikumi-cache ^>=0.2.1.2,
    shikumi-compile ^>=0.2.2.1,
    shikumi-eval ^>=0.3.1.1,
    shikumi-optimize ^>=0.4.0.0,
    shikumi-trace ^>=0.3.2.1,
    text ^>=2.1,
    time >=1.12 && <1.17,

test-suite shikumi-evidence-test
  import: common-options
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options:
    -threaded
    -with-rtsopts=-N

  other-modules:
    ArtifactSpec
    BindingSpec
    BudgetSpec
    ComparisonSpec
    ConclusionSpec
    DatasetDigestSpec
    DriverGateSpec
    Fixture
    HoldoutIsolationSpec
    LabelSpec
    ReplaySpec
    SplitSpec
    Uc7Spec

  build-depends:
    aeson,
    baikai >=0.11.0.0 && <0.12,
    base,
    bytestring,
    containers,
    effectful,
    filepath,
    generic-lens,
    lens,
    shikumi ^>=0.5.1.1,
    shikumi-cache ^>=0.2.1.2,
    shikumi-compile ^>=0.2.2.1,
    shikumi-eval ^>=0.3.1.1,
    shikumi-evidence ^>=0.1.0.0,
    shikumi-optimize ^>=0.4.0.0,
    shikumi-testing ^>=0.1.0.0,
    shikumi-trace ^>=0.3.2.1,
    tasty,
    tasty-golden,
    tasty-hunit,
    text,
    time,
    vector,
