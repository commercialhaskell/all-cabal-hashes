test-suite papa-test
  type:
                    exitcode-stdio-1.0

  default-language:
                    Haskell2010

  hs-source-dirs:
                    test

  main-is:
                    Main.hs

  build-depends:
                    base >= 4.11 && < 6
                    , papa

  ghc-options:
                    -Wall

  if flag(dev)
    ghc-options:    -Werror

  default-extensions:
                    NoImplicitPrelude

test-suite doctest
  type:
                    exitcode-stdio-1.0

  hs-source-dirs:
                    test

  main-is:
                    Doctest.hs

  build-depends:
                    base >= 4.11 && < 6
                    , process >= 1 && < 2

  build-tool-depends:
                    doctest:doctest >= 0.22 && < 1

  default-language:
                    Haskell2010

  ghc-options:
                    -Wall

  if flag(dev)
    ghc-options:    -Werror
