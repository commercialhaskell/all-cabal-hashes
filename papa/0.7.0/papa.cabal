test-suite hedgehog
  import:           warnings

  type:
                    exitcode-stdio-1.0

  default-language:
                    Haskell2010

  hs-source-dirs:
                    test

  main-is:
                    Main.hs

  other-modules:
                    Agree
                    Composes
                    ComposesUnsafe
                    Deny
                    Properties
                    PropertiesIO
                    PropertiesVector
                    PropertiesAsync
                    PropertiesContainers
                    PropertiesFS
                    PropertiesNumeric
                    PropertiesText
                    Totals

  build-depends:
                    base >= 4.18 && < 5
                    , async
                    , bytestring
                    , containers
                    , deepseq
                    , directory
                    , filepath
                    , hedgehog >= 1.2 && < 2
                    , hedgehog-fn >= 1.0 && < 2
                    , papa
                    , tagged
                    , text
                    , time
                    , transformers
                    , unordered-containers
                    , vector

  ghc-options:
                    -threaded

  default-extensions:
                    NoImplicitPrelude

test-suite inspection
  import:           warnings

  type:
                    exitcode-stdio-1.0

  default-language:
                    Haskell2010

  hs-source-dirs:
                    test

  main-is:
                    Inspection.hs

  build-depends:
                    base >= 4.18 && < 5
                    , inspection-testing >= 0.5 && < 0.7
                    , papa

  default-extensions:
                    NoImplicitPrelude

test-suite doctest
  import:           warnings

  type:
                    exitcode-stdio-1.0

  hs-source-dirs:
                    test

  main-is:
                    Doctest.hs

  build-depends:
                    base >= 4.18 && < 5
                    , process >= 1 && < 2

  build-tool-depends:
                    doctest:doctest >= 0.22 && < 1

  default-language:
                    Haskell2010

benchmark papa-bench
  import:           warnings

  type:
                    exitcode-stdio-1.0

  default-language:
                    Haskell2010

  hs-source-dirs:
                    bench

  main-is:
                    Main.hs

  other-modules:
                    Nub
                    BenchVector
                    Totality
                    Text

  build-depends:
                    base >= 4.18 && < 5
                    , bytestring
                    , containers
                    , criterion >= 1.6 && < 1.7
                    , directory
                    , papa
                    , unordered-containers
                    , vector
                    , text

  ghc-options:
                    -O2

  default-extensions:
                    NoImplicitPrelude
