bug-reports:        https://gitlab.com/system-f/code/papa/issues
build-type:         Simple
extra-doc-files:    changelog.md
tested-with:        GHC == 9.6.7
                  , GHC == 9.8.4
                  , GHC == 9.10.3
                  , GHC == 9.12.4
                  , GHC == 9.14.1

flag dev
  description:      Enable development warnings (-Werror)
  manual:           True
  default:          False

source-repository   head
  type:             git
  location:         git@gitlab.com:system-f/code/papa.git

common warnings
  ghc-options:
                    -Wall -Wcompat -Wincomplete-uni-patterns -Werror=incomplete-patterns

  if flag(dev)
    ghc-options:    -Werror

library
  import:           warnings

  default-language:
                    Haskell2010

  build-depends:
                    base >= 4.18 && < 5
                    , adjunctions >= 4 && < 5
                    , async >= 2.2.5 && < 2.3
                    , bytestring >= 0.11.2 && < 0.13
                    , associative >= 0 && < 1
                    , bifunctors >= 5 && < 7
                    , comonad >= 5 && < 6
                    , containers >= 0.6.0.1 && < 1
                    , contravariant >= 1 && < 2
                    , deepseq >= 1.4 && < 2
                    , directory >= 1.3.8 && < 1.4
                    , distributive >= 0 && < 1
                    , exceptions >= 0.10 && < 0.11
                    , filepath >= 1.4.100 && < 1.6
                    , free >= 5 && < 6
                    , id >= 0 && < 1
                    , lens >= 5.2 && < 6
                    , mtl >= 2 && < 3
                    , one >= 0.0.4 && < 1
                    , polytree >= 0 && < 1
                    , profunctors >= 5 && < 6
                    , selective >= 0 && < 1
                    , semigroupoids >= 5 && < 7
                    , stm >= 2.5 && < 2.6
                    , text >= 2.0.2 && < 2.2
                    , time >= 1.12 && < 1.16
                    , transformers >= 0.5 && < 1
                    , hashable >= 1.4 && < 1.6
                    , primitive >= 0.7 && < 0.10
                    , unordered-containers >= 0.2.19 && < 0.3
                    , vector >= 0.13.2 && < 0.14
                    , witherable >= 0 && < 1

  default-extensions:
                    NoImplicitPrelude

  hs-source-dirs:
                    src

