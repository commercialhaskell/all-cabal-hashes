cabal-version: 3.0
name: shroom-class
version: 0.1.0.0
synopsis: Type-description classes and Template Haskell for shroom
description:
  shroom-class holds the type-description classes of shroom:
  <https://hackage.haskell.org/package/shroom-class/docs/Data-Shroom-Class.html#t:Describable Describable>
  names a type for a model, and
  <https://hackage.haskell.org/package/shroom-class/docs/Data-Shroom-Class.html#t:Surveyable Surveyable>
  adds the properties its values must satisfy, as pure Haskell functions, and
  example values. Template Haskell
  derives
  <https://hackage.haskell.org/package/shroom-class/docs/Data-Shroom-Class.html#t:Describable Describable>
  from Haddock comments and type, constructor and field names, so what a human
  reader sees of a type is the description the
  model reads, and an empty
  <https://hackage.haskell.org/package/shroom-class/docs/Data-Shroom-Class.html#t:Surveyable Surveyable>
  instance does the rest. The package has no prompting runtime and depends on
  no HTTP client and no effect system. It is the base of
  <https://hackage.haskell.org/package/shroom shroom>, which runs prompts, and
  of <https://hackage.haskell.org/package/shroom-baikai shroom-baikai>, which
  connects them to a real model.

category: AI
license: BSD-3-Clause
license-file: LICENSE
author: Manuel Bärenz
maintainer: programming@manuelbaerenz.de
-- copyright:
build-type: Simple
extra-doc-files: CHANGELOG.md
extra-source-files: test/golden/*.golden
tested-with:
  ghc ==9.12

common opts
  ghc-options:
    -Wall
    -haddock
    -Winvalid-haddock

  build-depends:
    aeson ^>=2.2,
    base >=4.20 && <4.22,
    containers >=0.6 && <0.8,
    generics-sop ^>=0.5.1,
    openapi3 ^>=3.2,
    template-haskell >=2.22 && <2.25,
    text >=2.1.2 && <2.2,
    time ^>=1.14,
    universe-base ^>=1.1,

  default-extensions:
    OverloadedStrings
    TypeFamilies

library
  import: opts
  exposed-modules:
    Data.Shroom.Class
    Data.Shroom.Class.TH

  hs-source-dirs: src
  default-language: GHC2024

test-suite shroom-class-test
  import: opts
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  default-language: GHC2024
  build-depends:
    shroom-class,
    tasty >=1.4 && <1.6,
    tasty-golden ^>=2.3,
    tasty-hunit ^>=0.10,
