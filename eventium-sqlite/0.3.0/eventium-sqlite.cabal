    , bytestring >=0.10 && <0.13
    , eventium-core >=0.3.0 && <0.4.0
    , eventium-sql-common >=0.3.0 && <0.4.0
    , eventium-testkit
    , hspec
    , mtl >=2.2 && <2.4
    , persistent >=2.14 && <2.18
    , persistent-sqlite
    , text >=1.2 && <2.2
    , uuid ==1.3.*
  default-language: Haskell2010
