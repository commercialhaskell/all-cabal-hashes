cabal-version:      3.0
name:               cot
version:            0.1.0.0
synopsis:           Commitments of Traders
description:        https://www.cftc.gov/
homepage:           https://github.com/dopamane/cot
license:            MIT
license-file:       LICENSE
author:             dopamane
maintainer:         dwc1295@gmail.com
copyright:          David Cox
category:           Data
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md
data-dir:           data
data-files:         *.txt

source-repository head
  type: git
  location: https://github.com/dopamane/cot

library
  default-language: Haskell2010
  ghc-options:      -Wall -O2
  hs-source-dirs:   lib
  exposed-modules:  Data.COT
  build-depends:
    base < 5,
    megaparsec,
    prettyprinter

executable cot
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded
  hs-source-dirs:   exe
  main-is:          Main.hs
  other-modules:    Paths_cot
  autogen-modules:  Paths_cot
  build-depends:
    base < 5,
    cot,
    megaparsec,
    optparse-applicative,
    prettyprinter

test-suite test
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded
  hs-source-dirs:   test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  other-modules:    Paths_cot
  autogen-modules:  Paths_cot
  build-depends:
    base < 5,
    bytestring,
    cot,
    filepath,
    megaparsec,
    prettyprinter,
    tasty,
    tasty-golden
