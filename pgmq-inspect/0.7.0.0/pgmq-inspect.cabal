cabal-version: 3.4
name: pgmq-inspect
version: 0.7.0.0
synopsis: Embeddable HTTP and WebSocket inspection surface for PGMQ queues
description:
  A sister package to pgmq-hs: an embeddable WAI application and a convenience
  runner that expose read-only queue inspection over HTTP and WebSocket. Queue
  listings, total and visible depth metrics, non-destructive message and archive
  browsing, message lookup by id, topic bindings, routing tests, notification
  throttles, and health probes, with configurable CORS. The core pgmq-hs
  libraries gain no web dependency; this package depends on them, never the
  other way around.

homepage: https://github.com/shinzui/pgmq-hs
license: MIT
license-file: LICENSE
author: Nadeem Bitar
maintainer: Nadeem Bitar
category: Database, Web
build-type: Simple
extra-doc-files: CHANGELOG.md
extra-source-files:
  test/client/*.mjs
  test/fixtures/inspection-role.sql
  test/fixtures/pgmq-1.12.0.sql
  test/golden/*.json

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -fhide-source-paths
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies

library
  import: warnings
  exposed-modules:
    Pgmq.Inspect
    Pgmq.Inspect.Config
    Pgmq.Inspect.Cors
    Pgmq.Inspect.Env
    Pgmq.Inspect.Error
    Pgmq.Inspect.Http
    Pgmq.Inspect.OpenApi
    Pgmq.Inspect.Server
    Pgmq.Inspect.WebSocket
    Pgmq.Inspect.Wire

  other-modules:
    Paths_pgmq_inspect
    Pgmq.Inspect.Budget
    Pgmq.Inspect.Frames
    Pgmq.Inspect.Lifecycle
    Pgmq.Inspect.Listener
    Pgmq.Inspect.Outbox
    Pgmq.Inspect.Refresh

  autogen-modules: Paths_pgmq_inspect
  default-extensions:
    DataKinds
    DeriveGeneric
    DuplicateRecordFields
    GeneralisedNewtypeDeriving
    ImportQualifiedPost
    LambdaCase
    NamedFieldPuns
    OverloadedLabels
    OverloadedStrings
    TypeOperators

  build-depends:
    aeson ^>=2.2,
    async ^>=2.2,
    base >=4.18 && <5,
    bytestring >=0.11 && <0.13,
    containers >=0.6 && <0.8,
    effectful-core ^>=2.6 || ^>=2.7,
    generic-lens ^>=2.2 || ^>=2.3,
    hasql ^>=1.10,
    hasql-pool ^>=1.4,
    hs-opentelemetry-api >=1.0 && <2,
    http-types ^>=0.12,
    lens ^>=5.3,
    network ^>=3.2,
    network-uri ^>=2.6,
    openapi3 ^>=3.2.5,
    pgmq-core >=0.7 && <0.8,
    pgmq-effectful >=0.7 && <0.8,
    pgmq-hasql >=0.7 && <0.8,
    postgresql-libpq >=0.10.1 && <0.12,
    stm >=2.5 && <2.6,
    streaming-commons ^>=0.2,
    text ^>=2.1,
    time ^>=1.14,
    vector ^>=0.13,
    wai ^>=3.2,
    wai-cors ^>=0.2.7,
    wai-websockets ^>=3.0,
    warp ^>=3.4,
    websockets ^>=0.13,

  hs-source-dirs: src
  default-language: GHC2024

executable pgmq-inspect
  import: warnings
  default-language: GHC2024
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  autogen-modules: Paths_pgmq_inspect
  other-modules:
    Paths_pgmq_inspect
    PgmqInspectCli

  default-extensions:
    DeriveGeneric
    DuplicateRecordFields
    ImportQualifiedPost
    OverloadedLabels
    OverloadedStrings

  build-depends:
    async ^>=2.2,
    base >=4.18 && <5,
    generic-lens ^>=2.2 || ^>=2.3,
    hasql ^>=1.10,
    hasql-pool ^>=1.4,
    lens ^>=5.3,
    optparse-applicative ^>=0.19,
    pgmq-inspect >=0.7 && <0.8,
    postgresql-connection-string ^>=0.1,
    text ^>=2.1,

test-suite pgmq-inspect-test
  import: warnings
  default-language: GHC2024
  build-tool-depends: pgmq-inspect:pgmq-inspect >=0.7 && <0.8
  type: exitcode-stdio-1.0
  hs-source-dirs:
    test
    src
    app

  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  autogen-modules: Paths_pgmq_inspect
  other-modules:
    CliSpec
    ConfigSpec
    CorsSpec
    EmbeddingExample
    EphemeralDb
    ErrorSpec
    HttpSpec
    IsolationSpec
    ListenerSpec
    LiveFeedSpec
    OpenApiSpec
    OutboxSpec
    Paths_pgmq_inspect
    Pgmq.Inspect
    Pgmq.Inspect.Budget
    Pgmq.Inspect.Config
    Pgmq.Inspect.Cors
    Pgmq.Inspect.Env
    Pgmq.Inspect.Error
    Pgmq.Inspect.Frames
    Pgmq.Inspect.Http
    Pgmq.Inspect.Lifecycle
    Pgmq.Inspect.Listener
    Pgmq.Inspect.OpenApi
    Pgmq.Inspect.Outbox
    Pgmq.Inspect.Refresh
    Pgmq.Inspect.Server
    Pgmq.Inspect.WebSocket
    Pgmq.Inspect.Wire
    PgmqInspectCli
    PrivilegesSpec
    RawWebSocketSpec
    RefreshSpec
    RootPermissionsSpec
    RouterSpec
    ServerSpec
    SmokeSpec
    TestServer
    WebSocketSpec
    WireGoldenSpec

  default-extensions:
    DataKinds
    DeriveGeneric
    DuplicateRecordFields
    GeneralisedNewtypeDeriving
    ImportQualifiedPost
    LambdaCase
    NamedFieldPuns
    OverloadedLabels
    OverloadedStrings
    TypeOperators

  build-depends:
    aeson,
    async,
    base >=4.18 && <5,
    bytestring,
    case-insensitive,
    containers,
    directory,
    effectful-core ^>=2.6 || ^>=2.7,
    ephemeral-pg >=0.3.1.0,
    generic-lens,
    hasql,
    hasql-pool ^>=1.4,
    hs-opentelemetry-api >=1.0 && <2,
    http-client ^>=0.7,
    http-types,
    lens,
    network,
    network-uri ^>=2.6,
    openapi3 ^>=3.2.5,
    optparse-applicative ^>=0.19,
    pg-migrate,
    pgmq-core >=0.7 && <0.8,
    pgmq-effectful >=0.7 && <0.8,
    pgmq-hasql >=0.7 && <0.8,
    pgmq-migration >=0.7 && <0.8,
    postgresql-connection-string ^>=0.1,
    postgresql-libpq >=0.10.1 && <0.12,
    process,
    random ^>=1.2,
    stm,
    streaming-commons ^>=0.2,
    tasty ^>=1.5,
    tasty-golden ^>=2.3.6,
    tasty-hunit ^>=0.10,
    text,
    time,
    unix,
    vector,
    wai,
    wai-cors ^>=0.2.7,
    wai-websockets ^>=3.0,
    warp,
    websockets,
