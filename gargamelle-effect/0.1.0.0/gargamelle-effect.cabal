cabal-version: 3.0
name: gargamelle-effect
version: 0.1.0.0
synopsis: Penelope polycategorical effect orchestration with Polytropos routers
description:
  Penelope polycategorical effect orchestration layer with Polytropos O(1)
  routers, optics, and fusion for Gargamelle. Provides pure optic dispatch,
  arrow loop handling, strand fusion, and database and sandbox execution
  strands generalizing unary and binary effects.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Control
homepage: https://github.com/NadiaYvette/gargamelle
bug-reports: https://github.com/NadiaYvette/gargamelle/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with:
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/gargamelle
  subdir: packages/gargamelle-effect

library
  exposed-modules:
    Effect.Strand
    Effect.Handlers
    Effect.Rope
    Effect.Strand.Beam
    Gargamelle.Effect
    Gargamelle.Effect.Router
    Gargamelle.Effect.Optics
    Gargamelle.Effect.Fusion
    Gargamelle.Effect.Rope
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints -Wno-unused-imports -fplugin=Polytropos.Plugin
  build-depends:
    base >= 4.14 && < 5,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    primitive >= 0.8 && < 0.10,
    profunctors >= 5.6 && < 5.7,
    kan-extensions >= 5.2 && < 5.3,
    polytropos-core >= 0.1.0.1 && < 0.2,
    polytropos-plugin >= 0.1.0.1 && < 0.2,
    polytropos-profunctors >= 0.1.0.1 && < 0.2,
    gargamelle-core >= 0.1 && < 0.2,
    gargamelle-persistence >= 0.1 && < 0.2,
    penelope-core >= 0.1.0.0 && < 0.2,
    penelope-effects >= 0.1.0.0 && < 0.2,
    penelope-static >= 0.1.0.0 && < 0.2,
    beam-core >= 0.10 && < 0.12,
    beam-sqlite >= 0.5 && < 0.8,
    sqlite-simple >= 0.4 && < 0.5,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    process >= 1.6 && < 1.7

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall -fplugin=Polytropos.Plugin
  build-depends:
    base >= 4.14 && < 5,
    gargamelle-effect,
    gargamelle-core >= 0.1 && < 0.2,
    gargamelle-persistence >= 0.1 && < 0.2,
    polytropos-core >= 0.1.0.1 && < 0.2,
    polytropos-plugin >= 0.1.0.1 && < 0.2,
    polytropos-profunctors >= 0.1.0.1 && < 0.2,
    penelope-core >= 0.1.0.0 && < 0.2,
    penelope-effects >= 0.1.0.0 && < 0.2,
    penelope-static >= 0.1.0.0 && < 0.2,
    primitive >= 0.8 && < 0.10,
    profunctors >= 5.6 && < 5.7,
    kan-extensions >= 5.2 && < 5.3,
    containers >= 0.6 && < 0.9,
    text >= 2.0 && < 2.2,
    hspec >= 2.10 && < 2.12
