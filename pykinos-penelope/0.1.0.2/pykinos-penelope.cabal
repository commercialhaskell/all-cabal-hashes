cabal-version: 3.0
name: pykinos-penelope
version: 0.1.0.2
synopsis: Transient Epoch mutation and lockless MVCC handles for Pykinos
description:
  Penelope effect system integration with Pykinos unboxed data structures,
  providing transient epoch isolation (withTransientEpoch) and lockless
  categorical pushout merges (pushoutMergeMVCC) over divergent transaction branches.
license: EUPL-1.2 OR Apache-2.0
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Concurrency, Control
homepage: https://github.com/NadiaYvette/pykinos
bug-reports: https://github.com/NadiaYvette/pykinos/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with: GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/pykinos
  subdir: packages/pykinos-penelope

library
  exposed-modules:
    Pykinos.Effect.Penelope
    Pukinos.Effect.Penelope
  hs-source-dirs: src
  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wno-unused-imports
  build-depends:
    base >= 4.19 && < 5,
    pykinos-core >= 0.1.0.0 && < 0.2,
    primitive >= 0.9 && < 0.10,
    containers >= 0.6 && < 0.9

test-suite pykinos-penelope-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  default-language: GHC2024
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    base >= 4.19 && < 5,
    pykinos-core >= 0.1.0.0 && < 0.2,
    pykinos-penelope >= 0.1.0.0 && < 0.2,
    primitive >= 0.9 && < 0.10
