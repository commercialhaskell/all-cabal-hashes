cabal-version: 3.0
name: polytropos-optics
version: 0.1.0.2
synopsis: optics-core integration for polytropos open records and variants
description:
  Integration between <https://hackage.haskell.org/package/polytropos polytropos> and the
  <https://hackage.haskell.org/package/optics optics> \/ <https://hackage.haskell.org/package/optics-core optics-core> ecosystem.

  Provides Van Laarhoven lenses for record fields via 'Polytropos.Optics.fieldLens', first-class
  prisms for variant constructors via 'Polytropos.Optics.ctorOptic', and 'Optics.Label.LabelOptic' instances
  allowing @#fieldName@ lens syntax with @OverloadedLabels@.

  Start at the front door module "Polytropos.Optics" for complete documentation,
  usage guidelines, and worked examples.
license: EUPL-1.2 OR Apache-2.0
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Optics, Data
homepage: https://github.com/NadiaYvette/polytropos
bug-reports: https://github.com/NadiaYvette/polytropos/issues
extra-doc-files:
    README.md
  , CHANGELOG.md
build-type: Simple

source-repository head
  type:     git
  location: https://github.com/NadiaYvette/polytropos
  subdir:   packages/polytropos-optics

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.Optics
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    polytropos-core >= 0.1 && < 0.2,
    optics-core >= 0.4 && < 0.5

test-suite polytropos-optics-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -fplugin=Polytropos.Plugin
  build-depends:
    base,
    polytropos-core,
    polytropos-optics,
    polytropos-plugin,
    optics-core,
    tasty,
    tasty-hunit
