cabal-version:      3.0
name:               tone
version:            0.2.0.0
synopsis:           tone synthesizer
homepage:           https://github.com/dopamane/tone
license:            MIT
license-file:       LICENSE
author:             dopamane
maintainer:         dwc1295@gmail.com
copyright:          David Cox
category:           Sound
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md

source-repository head
  type: git
  location: https://github.com/dopamane/tone

library
  default-language: Haskell2010
  ghc-options:      -Wall -O2
  hs-source-dirs:   lib
  exposed-modules:  Sound.Tone
  build-depends:    base < 5

executable tone
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded
  hs-source-dirs:   exe
  main-is:          Main.hs
  other-modules:    Paths_tone
  autogen-modules:  Paths_tone
  build-depends:
    base < 5,
    binary,
    bytestring,
    optparse-applicative,
    rap,
    tone


test-suite test
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded
  hs-source-dirs:   test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  build-depends:
    base < 5,
    tasty,
    tasty-hunit,
    tone
