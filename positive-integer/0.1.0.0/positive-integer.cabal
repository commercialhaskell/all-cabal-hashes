name: positive-integer
version: 0.1.0.0
category: Numeric
synopsis: Type of positive integers.
description: Type of positive integers together with related functions.
build-type: Simple
author: Daniel Casanueva
maintainer: Daniel Casanueva (coding `at` danielcasanueva.eu)
license: MIT
license-file: license
cabal-version: 1.18
extra-doc-files: readme.md

library
  default-language: Haskell2010
  hs-source-dirs: lib
  exposed-modules: Numeric.PositiveInteger
  ghc-options: -Wall
  default-extensions: ImportQualifiedPost
  build-depends: base >= 4.14.0.0 && < 4.22.0.0
