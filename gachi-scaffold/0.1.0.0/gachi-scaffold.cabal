cabal-version: 3.0
name: gachi-scaffold
version: 0.1.0.0
synopsis: Declarative multi-package workspace scaffolding engine for Gachi
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
build-type: Simple
tested-with:
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

library
  exposed-modules:
    Gachi.Scaffold
    Gachi.Scaffold.Types
    Gachi.Scaffold.Markdown
    Gachi.Scaffold.Templates
    Gachi.Scaffold.Engine
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    gachi-core >= 0.1 && < 0.2,
    gachi-schema >= 0.1 && < 0.2,
    polytropos-core >= 0.1 && < 0.2,
    text >= 2.0,
    containers >= 0.6,
    filepath >= 1.4,
    directory >= 1.3

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    gachi-core,
    gachi-schema,
    gachi-scaffold,
    polytropos-core,
    text >= 2.0,
    containers >= 0.6,
    filepath >= 1.4,
    directory >= 1.3,
    process >= 1.6,
    time >= 1.9,
    hspec >= 2.10
