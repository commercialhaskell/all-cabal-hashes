cabal-version: 3.0
name: gachi-scaffold
version: 0.1.0.1
synopsis: Declarative multi-package workspace scaffolding engine for Gachi
description:
  Declarative multi-package workspace scaffolding engine for Gachi.
  Generates Hackage-compliant multi-package repositories, cabal
  configurations, physical verification gates, git hooks, and documentation
  skeletons.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Development
homepage: https://github.com/NadiaYvette/gachi
bug-reports: https://github.com/NadiaYvette/gachi/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with:
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/gachi
  subdir: packages/gachi-scaffold

library
  exposed-modules:
    Gachi.Scaffold
    Gachi.Scaffold.Types
    Gachi.Scaffold.Markdown
    Gachi.Scaffold.Templates
    Gachi.Scaffold.Engine
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    gachi-core >= 0.1 && < 0.2,
    gachi-schema >= 0.1 && < 0.2,
    polytropos-core >= 0.1 && < 0.2,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    filepath >= 1.4 && < 1.6,
    directory >= 1.3 && < 1.4

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    gachi-core,
    gachi-schema,
    gachi-scaffold,
    polytropos-core >= 0.1 && < 0.2,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    filepath >= 1.4 && < 1.6,
    directory >= 1.3 && < 1.4,
    process >= 1.6 && < 1.7,
    time >= 1.9 && < 1.16,
    hspec >= 2.10 && < 2.12
