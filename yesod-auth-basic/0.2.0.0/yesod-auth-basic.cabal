
name:                yesod-auth-basic
version:             0.2.0.0
license:             BSD3
license-file:        LICENSE
extra-doc-files:     README.md, CHANGELOG.md
author:              Christopher Reichert
maintainer:          creichert07@gmail.com
copyright:           (c) 2015, Christopher Reichert
category:            Web
build-type:          Simple
cabal-version:       2.0
synopsis:            HTTP Basic authentication for Yesod
description:
 HTTP Basic authentication with an application-supplied credential checker
 and request-local caching of successful and failed authentication results.
 .
 See the documentation for Yesod.Auth.Http.Basic for usage examples.
 Route authorization and HTTP challenges are handled by the application.


source-repository head
  type:     git
  location: https://github.com/creichert/yesod-auth-basic.git


library
  exposed-modules:     Yesod.Auth.Http.Basic
  ghc-options:         -Wall
  default-language:    Haskell2010
  build-depends:       base               >= 4.14 && < 5
                     , base64-bytestring
                     , bytestring
                     , text
                     , yesod
                     , wai
                     , word8

test-suite spec
  type:                exitcode-stdio-1.0
  main-is:             Spec.hs
  hs-source-dirs:      test/
  other-modules:       YesodAuthHttpBasicSpec
  ghc-options:         -Wall -threaded
  default-language:    Haskell2010
  build-tool-depends:  hspec-discover:hspec-discover
  build-depends:       base                 >= 4.14 && < 5
                     , base64-bytestring
                     , bytestring
                     , yesod
                     , yesod-auth-basic
                     , yesod-test
                     , hspec                >= 1.3
                     , text
