cabal-version:      3.0
name:               zim-to-markdown
version:            0.3.0.3
synopsis:           Converts Zim wiki pages to Markdown and back.
description:
    A command line converter between Zim wiki markup and Markdown.

    It converts single pages and whole notebooks in both directions,
    copies notebook assets, preserves the folder structure, and resolves
    internal links.

    Zim metadata headers are removed and heading levels are normalized
    for Markdown output.
homepage:           https://github.com/Tralen/zim-to-markdown
bug-reports:        https://github.com/Tralen/zim-to-markdown/issues
license:            BSD-3-Clause
license-file:       LICENSE
author:             Tunai Raiol <dev@tralen.cc>
maintainer:         Tralen <dev@tralen.cc>
copyright:          2026 Tunai Raiol
category:           Text
build-type:         Simple
tested-with:        GHC ==9.6.7 || ==9.14.1
extra-doc-files:    CHANGELOG.md
                    README.md
                    docs/architecture.md
                    docs/cli.md
                    docs/conversion.md
                    docs/domain.md
                    docs/releasing.md
                    docs/roadmap.md
                    docs/versioning.md

source-repository head
    type:     git
    location: https://github.com/Tralen/zim-to-markdown.git

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Werror
        -Widentities
        -Wincomplete-patterns
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints

library
    exposed-modules:
        ZimToMarkdown.Converter
        ZimToMarkdown.Domain
        ZimToMarkdown.Inline
        ZimToMarkdown.Links
        ZimToMarkdown.Markdown
        ZimToMarkdown.Notebook
        ZimToMarkdown.Options
        ZimToMarkdown.Paths
        ZimToMarkdown.Table
        ZimToMarkdown.Version
        ZimToMarkdown.Zim
    hs-source-dirs:   src
    other-modules:    Paths_zim_to_markdown
    autogen-modules:  Paths_zim_to_markdown
    build-depends:
        base        >=4.18 && <5,
        containers  >=0.6  && <0.9,
        filepath    >=1.4  && <1.6,
        text        >=2.0  && <2.2
    default-language: GHC2021
    default-extensions: OverloadedStrings

executable zim-to-markdown
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:
        base              >=4.18 && <5,
        bytestring        >=0.11 && <0.13,
        containers        >=0.6  && <0.9,
        directory         >=1.3  && <1.4,
        filepath          >=1.4  && <1.6,
        text              >=2.0  && <2.2,
        zim-to-markdown
    default-language: GHC2021
    default-extensions: OverloadedStrings
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite zim-to-markdown-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    other-modules:    Paths_zim_to_markdown
    autogen-modules:  Paths_zim_to_markdown
    build-depends:
        base              >=4.18 && <5,
        containers        >=0.6  && <0.9,
        directory         >=1.3  && <1.4,
        filepath          >=1.4  && <1.6,
        text              >=2.0  && <2.2,
        zim-to-markdown
    default-language: GHC2021
    default-extensions: OverloadedStrings
