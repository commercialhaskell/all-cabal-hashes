cabal-version: 3.0
name: kenshou-diagnose
version: 0.1.0.0
synopsis: Leak and stall diagnostics for Kenshou scenarios
description: Offline leak verdicts, live stall capture, profiling recipes, and diagnostic self-tests.
license: BSD-3-Clause
license-file: LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
homepage: https://github.com/shinzui/kenshou
bug-reports: https://github.com/shinzui/kenshou/issues
category: Testing
build-type: Simple
extra-doc-files: CHANGELOG.md
tested-with: ghc >=9.12 && <9.13
extra-source-files:
  test/fixtures/run-leaking/**/*.csv
  test/fixtures/run-leaking/**/*.json
  test/fixtures/run-stalled/**/*.json
  test/fixtures/series/*.csv
  test/fixtures/snapshots/*.json
  test/golden/*.json
  test/golden/*.txt

flag ghc-debug
  description: Enable the optional ghc-debug socket stub
  default: False
  manual: True

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  default-language: GHC2024
  default-extensions:
    BlockArguments
    DuplicateRecordFields
    ImportQualifiedPost
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kenshou.Diagnose
    Kenshou.Diagnose.Context
    Kenshou.Diagnose.Document
    Kenshou.Diagnose.Leak
    Kenshou.Diagnose.Leak.MajorGcProbe
    Kenshou.Diagnose.LockGraph
    Kenshou.Diagnose.Pool
    Kenshou.Diagnose.Postgres
    Kenshou.Diagnose.Profile
    Kenshou.Diagnose.Profile.EventlogGuard
    Kenshou.Diagnose.Profile.GhcDebug
    Kenshou.Diagnose.Progress
    Kenshou.Diagnose.Render
    Kenshou.Diagnose.SelfTest
    Kenshou.Diagnose.SelfTest.Leak
    Kenshou.Diagnose.SelfTest.Stall
    Kenshou.Diagnose.Series
    Kenshou.Diagnose.Series.Catalog
    Kenshou.Diagnose.Stall
    Kenshou.Diagnose.Stall.Classify
    Kenshou.Diagnose.Stall.Types
    Kenshou.Diagnose.Stats
    Kenshou.Diagnose.Threads

  build-depends:
    aeson >=2.2 && <2.3,
    async >=2.2 && <2.3,
    base >=4.21 && <4.22,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.8,
    directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6,
    hasql >=1.10 && <1.11,
    hasql-pool >=1.4 && <1.5,
    kenshou-core ^>=0.1.0.0,
    kenshou-measure ^>=0.1.0.0,
    process >=1.6 && <1.7,
    splitmix >=0.1 && <0.2,
    stm >=2.5 && <2.6,
    text >=2.1 && <2.2,
    time >=1.14 && <1.15,
    unix >=2.8 && <2.9,
    uuid >=1.3 && <1.4,
    vector >=0.13 && <0.14,

  if flag(ghc-debug)
    cpp-options: -DWITH_GHC_DEBUG
    build-depends: ghc-debug-stub ==0.8.0.0

    if !os(osx)
      extra-libraries: stdc++

test-suite kenshou-diagnose-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules:
    Kenshou.Diagnose.LeakSpec
    Kenshou.Diagnose.ProfileSpec
    Kenshou.Diagnose.RenderSpec
    Kenshou.Diagnose.StallSpec
    Kenshou.Diagnose.StatsSpec

  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -with-rtsopts=-T

  build-depends:
    aeson,
    async,
    base >=4.21 && <4.22,
    bytestring,
    containers,
    directory >=1.3 && <1.4,
    filepath,
    hasql,
    hspec >=2.11 && <2.12,
    kenshou-core ^>=0.1.0.0,
    kenshou-diagnose,
    temporary,
    text,
    time >=1.14 && <1.15,
    unix >=2.8 && <2.9,
    vector,

source-repository head
  type: git
  location: https://github.com/shinzui/kenshou.git
