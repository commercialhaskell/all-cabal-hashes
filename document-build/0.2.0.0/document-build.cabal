-- The build file, build.hs, which is a cabal script that each document project
-- runs. Building it here checks that it compiles.
executable document-build
  main-is:
                    build.hs

  default-language:
                    Haskell2010

  build-depends:
                      base              >= 4.18      && < 5
                    , document-build
                    , filepath          >= 1.4.301.0 && < 1.6
                    , mtl               >= 2.3.1     && < 2.4

  ghc-options:
                    -Wall
                    -Wcompat
                    -Wincomplete-uni-patterns
                    -Werror=incomplete-patterns

  hs-source-dirs:
                    .

test-suite hedgehog
  type:
                    exitcode-stdio-1.0

  main-is:
                    hedgehog_tests.hs

  other-modules:
                    BuildTests
                    Gens
                    Laws
                    OpticsTests
                    OutputTests

  default-language:
                    Haskell2010

  build-depends:
                      base              >= 4.18      && < 5
                    , aeson             >= 2.2.3     && < 2.4
                    , bytestring        >= 0.11.5.4  && < 0.13
                    , containers        >= 0.6.7     && < 0.9
                    , document-build
                    , hedgehog          >= 1.2       && < 2
                    , hedgehog-fn       >= 1.1       && < 2
                    , lens              >= 5.2.1     && < 6
                    , text              >= 2.0.2     && < 2.2
                    , time              >= 1.12.2    && < 2

  ghc-options:
                    -Wall
                    -threaded

  hs-source-dirs:
                    test

test-suite doctest
  type:
                    exitcode-stdio-1.0

  if !flag(doctest)
    buildable:      False

  main-is:
                    doctest_tests.hs

  default-language:
                    Haskell2010

  build-depends:
                      base    >= 4.18     && < 5
                    , process >= 1.6.19.0 && < 2
                    , document-build

  ghc-options:
                    -Wall
                    -threaded

  hs-source-dirs:
                    test

benchmark bench
  type:
                    exitcode-stdio-1.0

  main-is:
                    Main.hs

  default-language:
                    Haskell2010

  build-depends:
                      base       >= 4.18     && < 5
                    , bytestring >= 0.11.5.4 && < 0.13
                    , criterion  >= 1.6.2.0  && < 2
                    , filepather
                    , lens       >= 5.2.1    && < 6
                    , mtl        >= 2.3.1    && < 2.4
                    , text       >= 2.0.2    && < 2.2
                    , document-build

  ghc-options:
                    -Wall
                    -O2

  hs-source-dirs:
                    bench
