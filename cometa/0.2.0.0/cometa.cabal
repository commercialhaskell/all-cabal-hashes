cabal-version: 3.0
name: cometa
version: 0.2.0.0
synopsis: Idiomatic Haskell bindings to cardano-c
description:
  Haskell-owned Cardano values with transaction construction, signing, script
  evaluation and provider interfaces backed by cardano-c. Includes a
  Blockfrost provider.
license: Apache-2.0
license-file: LICENSE
author: Biglup Labs
maintainer: angel.castillob@protonmail.com
category: Blockchain
homepage: https://github.com/Biglup/cometa.hs
bug-reports: https://github.com/Biglup/cometa.hs/issues
build-type: Simple
extra-source-files:
  test/fixtures/providers/*.json
  test/fixtures/providers/README.md
  README.md
  examples/README.md
  CODING_CONVENTIONS.md
  AGENTS.md
  tools/*.py
  cbits/*.h
  .hlint.yaml
  .clang-format
  .readthedocs.yaml
  assets/*.png
  native/cardano-c.ref
  native/NOTICE
  native/*.json
  native/licenses/*.txt
  docs/requirements.txt
  docs/userguide/*.md
  docs/userguide/conf.py
  docs/userguide/_static/*.css
  docs/development/*.md
  test/Fixtures/*.md
  test/package-consumer/*.hs
  test/package-consumer/*.cabal
  test/valgrind/*.supp
  test/release/*.py

source-repository head
  type: git
  location: https://github.com/Biglup/cometa.hs.git

flag system-cardano-c
  description: Link an installed cardano-c instead of the bundled source package.
  default: False
  manual: True

common language
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates

library core
  import: language
  visibility: private
  hs-source-dirs: internal
  exposed-modules:
    Cometa.Internal.Failure
    Cometa.Internal.Callback
    Cometa.Internal.Provider
    Cometa.Internal.FFI.Provider
    Cometa.Internal.FFI.Native
    Cometa.Internal.Ownership
    Cometa.Internal.Hex
    Cometa.Internal.FFI.Cbor
    Cometa.Internal.FFI.Reencode
    Cometa.Internal.Transaction
    Cometa.Internal.FFI.Transaction
    Cometa.Internal.SigningKey
    Cometa.Internal.FFI.SigningKey
    Cometa.Internal.FFI.Ed25519Values
    Cometa.Internal.FFI.Bip32
    Cometa.Internal.FFI.Bip39
    Cometa.Internal.Bip39
    Cometa.Internal.PasswordCrypto
    Cometa.Internal.FFI.PasswordCrypto
    Cometa.Internal.KeyHandler
    Cometa.Internal.FFI.KeyHandler
    Cometa.Internal.Bip32PrivateKey
    Cometa.Internal.FFI.Script
    Cometa.Internal.FFI.Runtime
    Cometa.Internal.FFI.ProviderRuntime
    Cometa.Internal.FFI.CoinSelection
    Cometa.Internal.FFI.Evaluation
    Cometa.Internal.FFI.NativeEvaluation
    Cometa.Internal.FFI.Building
    Cometa.Internal.FFI.ParameterUpdate
    Cometa.Internal.FFI.Inspection
    Cometa.Internal.FFI.Cip8
    Cometa.Internal.FFI.SubTransactionBuilder
    Cometa.Internal.FFI.ContextualTransaction
    Cometa.Internal.FFI.TransactionBuilder
  build-depends:
    base >=4.18 && <4.22,
    bytestring >=0.11 && <0.13,
    text >=2.0 && <2.2
  if flag(system-cardano-c)
    extra-libraries: cardano-c
    if os(linux) || os(osx)
      extra-libraries: m, pthread
  else
    build-depends: cardano-c-clib ==0.1.1.0
  c-sources:
    cbits/cometa_provider.c
    cbits/cometa_cbor.c
    cbits/cometa_reencode.c
    cbits/cometa_transaction.c
    cbits/cometa_signing_key.c
    cbits/cometa_ed25519_values.c
    cbits/cometa_key_handler.c
    cbits/cometa_bip32.c
    cbits/cometa_bip39.c
    cbits/cometa_password_crypto.c
    cbits/cometa_script.c
    cbits/cometa_runtime.c
    cbits/cometa_provider_runtime.c
    cbits/cometa_parameters.c
    cbits/cometa_inspection.c
    cbits/cometa_cip8.c
    cbits/cometa_coin_selection.c
    cbits/cometa_evaluation.c
    cbits/cometa_native_evaluation.c
    cbits/cometa_building.c
    cbits/cometa_sub_transaction_builder.c
    cbits/cometa_contextual_transaction.c
    cbits/cometa_transaction_builder.c
  include-dirs: cbits
  includes: cometa_provider.h
  cc-options: -std=c11 -Wall -Wextra

