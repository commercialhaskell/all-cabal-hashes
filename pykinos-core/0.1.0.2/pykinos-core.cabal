cabal-version: 3.0
name: pykinos-core
version: 0.1.0.2
synopsis: Unboxed SIMD Roaring Bitmaps, ART IntMap, B+ and FAST search trees
description:
  Cache-conscious, unboxed, blocked data structures for high-performance
  algebraic evaluation, AST indexing, and transactional memory in Haskell.

  Named from Greek πυκινός / πυκνός (close, compact, solid; cf. Homer, Iliad
  15.529 'πυκινὸς θώρηξ' and Dionysius of Halicarnassus 'τὸ πυκνόν'), pykinos
  eliminates boxed pointer chains in favour of flat, cache-line aligned
  primitive memory arrays.

  Provides two-tier SIMD Roaring bitmaps, 4-tier Adaptive Radix Trees (ART),
  unboxed B+ trees, FAST search tree accelerators, Swiss Tables, and dynamic
  hidden classes.
license: EUPL-1.2 OR Apache-2.0
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Data, Data Structures
homepage: https://github.com/NadiaYvette/pykinos
bug-reports: https://github.com/NadiaYvette/pykinos/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with: GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/pykinos
  subdir: packages/pykinos-core

library
  exposed-modules:
    Pykinos.Bitset.Roaring
    Pykinos.IntMap.ART
    Pykinos.Tree.BPlus
    Pykinos.Tree.FAST
    Pykinos.Mutable.SwissTable
    Pykinos.Schema.HiddenClass
    Pukinos.Bitset.Roaring
    Pukinos.IntMap.ART
    Pukinos.Tree.BPlus
    Pukinos.Tree.FAST
  hs-source-dirs: src
  default-language: GHC2024
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wno-unused-imports
  build-depends:
    base >= 4.19 && < 5,
    primitive >= 0.9 && < 0.10,
    containers >= 0.6 && < 0.9,
    text >= 2.0 && < 2.2

test-suite pykinos-core-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  default-language: GHC2024
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    base >= 4.19 && < 5,
    pykinos-core >= 0.1.0.0 && < 0.2,
    primitive >= 0.9 && < 0.10,
    containers >= 0.6 && < 0.9,
    text >= 2.0 && < 2.2
