cabal-version: 3.12
-- SPDX-FileCopyrightText: 2026 Progmasoft <support@progmasoft.com>
-- SPDX-License-Identifier: MPL-2.0 WITH AdditionRef-Progmasoft-Exception-1.1
name: tala-core
version: 0.1.0
synopsis: Tala Core and CorePrep models, verification, and wire codecs
description:
    The Core and CorePrep intermediate languages of Tala: their models,
    desugaring into them, optimization, verification and binary codecs.
    .
    This is an implementation package of the Tala compiler. Its modules may
    change in any release; tools should depend on tala-tooling instead.
    .
    The source is also offered under the Progmasoft Linking Exception 1.1
    (LICENSE-EXCEPTION), an additional permission to MPL-2.0 for works that
    combine this package with independent code.
license: MPL-2.0
license-files:
    LICENSE
    LICENSE-EXCEPTION
author: Progmasoft
maintainer: support@progmasoft.com
homepage: https://tala.run/
bug-reports: https://github.com/Progmasoft/tala/issues
category: Language, Compiler
tested-with: GHC ==9.10.3
build-type: Simple

library
    exposed-modules:
        Progmasoft.Tala.Core
        Progmasoft.Tala.Core.Artifact
        Progmasoft.Tala.Core.CorePrep
        Progmasoft.Tala.Core.CorePrep.Verifier
        Progmasoft.Tala.Core.CorePrep.Wire
        Progmasoft.Tala.Core.CorePrep.Wire.Decode
        Progmasoft.Tala.Core.CorePrep.Wire.Encode
        Progmasoft.Tala.Core.CorePrep.Wire.Format
        Progmasoft.Tala.Core.Monomorphization
        Progmasoft.Tala.Core.Optimizer
        Progmasoft.Tala.Core.Optimizer.IntegerFacts
        Progmasoft.Tala.Core.Scalar
        Progmasoft.Tala.Core.Specialization
        Progmasoft.Tala.Core.Symbols
        Progmasoft.Tala.Core.Template
        Progmasoft.Tala.Core.Verifier
        Progmasoft.Tala.Core.Wire
        Progmasoft.Tala.Desugarer
        Progmasoft.Tala.Desugarer.Boundary
        Progmasoft.Tala.Desugarer.Branching
        Progmasoft.Tala.Desugarer.Captures
        Progmasoft.Tala.Desugarer.Effects
        Progmasoft.Tala.Desugarer.Handing
        Progmasoft.Tala.Desugarer.Laziness
        Progmasoft.Tala.Desugarer.Sequencing
        Progmasoft.Tala.Desugarer.Symbols
        Progmasoft.Tala.Desugarer.Workers
    other-modules:
        Progmasoft.Tala.Core.Optimizer.Analysis
        Progmasoft.Tala.Core.Optimizer.Constant
        Progmasoft.Tala.Core.Optimizer.ControlFlow
        Progmasoft.Tala.Core.Optimizer.EffectInference
        Progmasoft.Tala.Core.Optimizer.Floating
        Progmasoft.Tala.Core.Optimizer.Inline
        Progmasoft.Tala.Core.Optimizer.Liveness
        Progmasoft.Tala.Core.Optimizer.Pipeline
        Progmasoft.Tala.Core.Optimizer.Types
        Progmasoft.Tala.Core.Monomorphization.Discovery
        Progmasoft.Tala.Core.Monomorphization.Graph
        Progmasoft.Tala.Core.Monomorphization.Types
    hs-source-dirs: src
    build-depends:
        base >=4.20 && <4.23,
        bytestring >=0.12 && <0.14,
        containers >=0.7 && <0.9,
        filepath >=1.5 && <1.6,
        mtl >=2.3 && <2.4,
        tala-syntax >=0.1.0 && <0.2
    default-language: GHC2024

benchmark core-benches
    type: exitcode-stdio-1.0
    main-is: Main.hs
    hs-source-dirs: Benches
    build-depends:
        base >=4.20 && <4.23,
        criterion >=1.6.4 && <1.7,
        deepseq >=1.5 && <1.6,
        tala-core >=0.1.0 && <0.2,
        tala-syntax >=0.1.0 && <0.2
    default-language: GHC2024
    ghc-options: -threaded -rtsopts

source-repository head
    type: git
    location: https://github.com/Progmasoft/tala
    subdir: Talac/Haskell/Core
