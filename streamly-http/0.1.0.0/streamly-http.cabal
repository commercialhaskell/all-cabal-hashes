cabal-version:   3.12
name:            streamly-http
version:         0.1.0.0
synopsis:        A small HTTP/1.1 client written with Streamly
description:
  An HTTP/1.1 client over plain TCP. The response head is read with
  flatparse parsers and the body is a stream of byte arrays, whether it is
  delimited by @Content-Length@, by the chunked transfer coding or by the
  end of the connection. Waits and sizes are limited; sessions and clients
  keep connections from one request to the next. No TLS and no redirects
  here: requests also go over a transport of the caller, which is how
  streamly-http-tls adds both.

homepage:        https://github.com/GuillaumedeVolpiano/streamly-http
license:         BSD-3-Clause
license-file:    LICENSE
author:          Xavier Dectot
maintainer:      Xavier Dectot <xavier@wheredoibegin.fr>
category:        Network, Web, Streamly
build-type:      Simple
tested-with:     GHC ==9.8.4 || ==9.10.3 || ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://github.com/GuillaumedeVolpiano/streamly-http.git

common shared
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies
    DisambiguateRecordFields
    DuplicateRecordFields
    ExplicitNamespaces
    GADTs
    LambdaCase
    MonoLocalBinds
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    RoleAnnotations

  ghc-options:
    -Wall -Wcompat -Wredundant-constraints -Wmissing-deriving-strategies
    -Wunused-packages

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Streamly.External.Network.HTTP
    Streamly.External.Network.HTTP.URL
    Streamly.External.Network.HTTP.Wire

  build-depends:
    , base                 >=4.19 && <4.22
    , bytestring           ^>=0.12
    , containers           >=0.6.7 && <0.8
    , flatparse            ^>=0.5
    , network              ^>=3.2
    , streamly-bytestring  ^>=0.2.3
    , streamly-core        ^>=0.3.3
    , streamly-flatparse   ^>=0.1
    , streamly-network-tcp ^>=0.1

test-suite streamly-http-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , async                ^>=2.2
    , base
    , bytestring
    , network
    , streamly-bytestring
    , streamly-core
    , streamly-http
    , tasty                ^>=1.5
    , tasty-hunit          ^>=0.10
    , tasty-quickcheck     ^>=0.11
