cabal-version:      3.0
name:               vehicle
version:            0.1.0.0
synopsis:           Standard Classification for Space Launch & Reentry Vehicles
description:        ASTM F3388-23
homepage:           https://github.com/dopamane/vehicle
license:            MIT
license-file:       LICENSE
author:             dopamane
maintainer:         dwc1295@gmail.com
copyright:          David Cox
category:           Data
build-type:         Simple
extra-doc-files:    CHANGELOG.md
                    README.md

source-repository head
  type: git
  location: https://github.com/dopamane/vehicle

library
  default-language: Haskell2010
  ghc-options:      -Wall -O2
  hs-source-dirs:   lib
  exposed-modules:  Data.Vehicle
  build-depends:
    base < 5,
    binary,

executable vhcl
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded
  hs-source-dirs:   exe
  main-is:          Main.hs
  other-modules:    Paths_vehicle
  autogen-modules:  Paths_vehicle
  build-depends:
    base < 5,
    binary,
    bytestring,
    optparse-applicative,
    vehicle

test-suite test
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded
  hs-source-dirs:   test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  build-depends:
    base < 5,
    binary,
    hedgehog,
    tasty,
    tasty-hedgehog,
    vehicle
