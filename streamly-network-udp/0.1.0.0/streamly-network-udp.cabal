cabal-version:   3.12
name:            streamly-network-udp
version:         0.1.0.0
synopsis:        UDP datagrams as Streamly streams
description:
  UDP sockets for Streamly, over the network package: the datagrams
  received are a stream, each with its sender; datagrams are sent one by
  one or through a fold. With the broadcast option and, for IPv4, multicast
  groups.

homepage:        https://github.com/GuillaumedeVolpiano/streamly-network-udp
license:         BSD-3-Clause
license-file:    LICENSE
author:          Xavier Dectot
maintainer:      Xavier Dectot <xavier@wheredoibegin.fr>
category:        Network, Streamly
build-type:      Simple
tested-with:     GHC ==9.8.4 || ==9.10.3 || ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://github.com/GuillaumedeVolpiano/streamly-network-udp.git

common shared
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies
    DisambiguateRecordFields
    DuplicateRecordFields
    ExplicitNamespaces
    GADTs
    LambdaCase
    MonoLocalBinds
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    RoleAnnotations

  ghc-options:
    -Wall -Wcompat -Wredundant-constraints -Wmissing-deriving-strategies
    -Wunused-packages

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Streamly.External.Network.UDP
  other-modules:   Streamly.External.Network.UDP.Constants
  build-depends:
    , base                 >=4.19 && <4.22
    , network              ^>=3.2
    , streamly-bytestring  ^>=0.2.3
    , streamly-core        ^>=0.3.3

test-suite streamly-network-udp-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , base
    , bytestring            ^>=0.12
    , network
    , streamly-bytestring
    , streamly-core
    , streamly-network-udp
    , tasty                 ^>=1.5
    , tasty-hunit           ^>=0.10
