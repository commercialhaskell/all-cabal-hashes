cabal-version: 3.0
name: polytropos-cbor
version: 0.1.0.2
synopsis: Binary CBOR serialization for polytropos open records and variants
description:
  Binary CBOR serialization and deserialization for <https://hackage.haskell.org/package/polytropos polytropos> open records
  and variants via <https://hackage.haskell.org/package/cborg cborg> and <https://hackage.haskell.org/package/serialise serialise>.

  Records serialize as an array length header followed by sequential flat payload
  encodings; variants serialize as an integer constructor tag followed by active payload
  fields. Eliminates intermediate tree allocations and boxing overhead entirely.

  Start at the front door module "Polytropos.CBOR" for complete documentation,
  binary encoding formats, and worked examples.
license: EUPL-1.2 OR Apache-2.0
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Codec, Binary
homepage: https://github.com/NadiaYvette/polytropos
bug-reports: https://github.com/NadiaYvette/polytropos/issues
extra-doc-files:
    README.md
  , CHANGELOG.md
build-type: Simple

source-repository head
  type:     git
  location: https://github.com/NadiaYvette/polytropos
  subdir:   packages/polytropos-cbor

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.CBOR
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    cborg >= 0.2 && < 0.3,
    serialise >= 0.2 && < 0.3,
    bytestring >= 0.10 && < 0.13,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2

test-suite polytropos-cbor-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -fplugin=Polytropos.Plugin
  build-depends:
    base,
    cborg,
    serialise,
    bytestring,
    polytropos-core,
    polytropos-cbor,
    polytropos-plugin,
    tasty,
    tasty-hunit
