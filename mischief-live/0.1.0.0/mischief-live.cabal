    -- mischief-assets ^>=0.1,
    -- mischief-input ^>=0.1,
    -- mischief-math ^>=0.1,
    -- mischief-render ^>=0.1,

  -- Directories containing source files.
  hs-source-dirs: examples/simple/live
  -- Base language which the package is written in.
  default-language: GHC2024

