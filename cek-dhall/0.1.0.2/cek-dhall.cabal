cabal-version: 3.0
name: cek-dhall
version: 0.1.0.2
synopsis: Domain package for cek-dhall
description:
  Domain package for cek-dhall for the cek ecosystem.
license: EUPL-1.2 OR Apache-2.0
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Development
homepage: https://github.com/NadiaYvette/cek
bug-reports: https://github.com/NadiaYvette/cek/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with: GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/cek
  subdir: packages/cek-dhall

library
  exposed-modules:
    Cek.Dhall
  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
  ghc-options: -Wall -Wcompat -Wredundant-constraints -threaded
  build-depends:
    base >= 4.14 && < 5,
    cek-dhall,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    hspec >= 2.10 && < 2.12
