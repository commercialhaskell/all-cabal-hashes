name:           eventium-memory
version:        0.1.0
synopsis:       In-memory implementations for eventium
description:    Eventium-memory provides in-memory implementations of event stores, read models, and projection caches
                for the Eventium event sourcing framework. This package is ideal for development, testing, and prototyping
                event-sourced applications without requiring external dependencies like databases. All data is stored in
                STM-based concurrent data structures for thread-safe access.
category:       Database,Eventsourcing
stability:      experimental
homepage:       https://github.com/aleks-sidorenko/eventium#readme
bug-reports:    https://github.com/aleks-sidorenko/eventium/issues
maintainer:     Alexander Sidorenko
license:        MIT
license-file:   LICENSE.md
build-type:     Simple
extra-source-files:
    CHANGELOG.md
    README.md

source-repository head
  type: git
  location: https://github.com/aleks-sidorenko/eventium

library
  exposed-modules:
      Eventium.ProjectionCache.Memory
      Eventium.ReadModel.Memory
      Eventium.Store.Memory
  other-modules:
      Paths_eventium_memory
  hs-source-dirs:
      src
  ghc-options: -Wall
  build-depends:
      base >=4.9 && <5
    , containers >=0.6 && <0.8
    , eventium-core
    , mtl >=2.2 && <2.4
    , safe >=0.3 && <0.4
    , stm >=2.5 && <2.6
  default-language: Haskell2010

