    build-depends:
        atomic-file-ops
          ^>= 0.3.0.0
      , binary
          >= 0.8.7.0  && < 0.11
      , containers
          >= 0.6.2.1  && < 0.9
      , distributive
          ^>= 0.6
      , finite-typelits
          >= 0.1.4.2  && < 0.3
      , generic-monoid
          ^>= 0.1.0.0
      , ghc-typelits-knownnat
          ^>= 0.8.2
      , ghc-typelits-natnormalise
          ^>= 0.9.0
      , half
          ^>= 0.3
      , lens
          >= 4.18     && < 5.4
      , mtl
          >= 2.2.2    && < 2.4
      , split
          >= 0.2.3.3  && < 0.3
      , template-haskell
          >= 2.15     && < 2.25
      , text-short
          >= 0.1.4    && < 0.2
      , transformers
          >= 0.5.6.2  && < 0.7
      , tree-view
          ^>= 0.5
      , typelits-witnesses
          >= 0.2.3    && < 0.5
      , variant
          ^>= 1.0.1
      , vector
          >= 0.12.0.3 && < 0.14
      , vector-sized
          >= 1.4.0.0  && < 1.7

    if flag(sop)
        build-depends:
          , generics-sop
              >= 0.4 && < 0.5.2
          , sop-core
              >= 0.4 && < 0.5.1

    default-language:
        Haskell2010

    default-extensions:
        NoStarIsType

    ghc-options:
        -Wall
        -Wcompat
        -fno-warn-orphans
        -fno-warn-unticked-promoted-constructors
        -fno-warn-unused-do-bind
        -fwarn-missing-local-signatures
        -fwarn-incomplete-uni-patterns
        -fwarn-missing-deriving-strategies

    if impl(ghc >= 9.14)
      ghc-options:
        -Wno-pattern-namespace-specifier

test-suite fir-tests

    import: common, test

    type:
      detailed-0.9

    hs-source-dirs:
      test

    test-module:
      CabalTests

    other-modules:
        Test
      , Tests
      , Folders

    build-depends:
        fir
      , Cabal
          >= 3.0.0.0 && < 3.17

    default-language:
        Haskell2010
