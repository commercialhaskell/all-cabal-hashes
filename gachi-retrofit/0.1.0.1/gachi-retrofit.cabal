cabal-version: 3.0
name: gachi-retrofit
version: 0.1.0.1
synopsis: Codebase retrofitting engine and repository inspector for Gachi
description:
  Static analysis of arbitrary target checkouts: detects language stacks,
  build systems, existing tests, documentation gaps relative to
  DOC_STRATEGY.md, Git hook attribution conformance, and physical
  verification readiness ('gachi retrofit').
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Development
homepage: https://github.com/NadiaYvette/gachi
bug-reports: https://github.com/NadiaYvette/gachi/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with:
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/gachi
  subdir: packages/gachi-retrofit

library
  exposed-modules:
    Gachi.Retrofit
    Gachi.Retrofit.Diagnostic
    Gachi.Retrofit.Overlay
    Gachi.Retrofit.Pipeline
    Gachi.Retrofit.QualityGate
    Gachi.Retrofit.Report
    Gachi.Retrofit.Types
  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
    ScopedTypeVariables
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    bytestring >= 0.10 && < 0.13,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    process >= 1.6 && < 1.7,
    polytropos-core >= 0.1.0.1 && < 0.2,
    penelope-core >= 0.1.0.0 && < 0.2,
    penelope-effects >= 0.1.0.0 && < 0.2,
    gargamelle-core >= 0.1.0.0 && < 0.2,
    gargamelle-effect >= 0.1.0.0 && < 0.2,
    gargamelle-sandbox >= 0.1.0.0 && < 0.2,
    gachi-core >= 0.1 && < 0.2,
    gachi-schema >= 0.1 && < 0.2,
    gachi-scaffold >= 0.1 && < 0.2,
    gachi-sync >= 0.1 && < 0.2

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
    ScopedTypeVariables
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints
    -threaded
  build-depends:
    base >= 4.14 && < 5,
    gachi-retrofit,
    gachi-core >= 0.1 && < 0.2,
    gachi-schema >= 0.1 && < 0.2,
    gachi-scaffold >= 0.1 && < 0.2,
    gachi-sync >= 0.1 && < 0.2,
    bytestring >= 0.10 && < 0.13,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    process >= 1.6 && < 1.7,
    polytropos-core >= 0.1.0.1 && < 0.2,
    penelope-core >= 0.1.0.0 && < 0.2,
    penelope-effects >= 0.1.0.0 && < 0.2,
    gargamelle-core >= 0.1.0.0 && < 0.2,
    gargamelle-effect >= 0.1.0.0 && < 0.2,
    gargamelle-sandbox >= 0.1.0.0 && < 0.2,
    time >= 1.9 && < 1.16,
    hspec >= 2.10 && < 2.12
