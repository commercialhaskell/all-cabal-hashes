cabal-version: 3.0
name: gachi-retrofit
version: 0.1.0.0
synopsis: Non-destructive codebase retrofitting engine and diagnostic repository inspector for Gachi
description:
  Static analysis of arbitrary target checkouts: detects language stacks, build systems,
  existing tests, documentation gaps relative to DOC_STRATEGY.md, Git hook attribution
  conformance, and physical verification readiness ('gachi retrofit').
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Development, Tools
build-type: Simple
tested-with:
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

library
  exposed-modules:
    Gachi.Retrofit
    Gachi.Retrofit.Diagnostic
    Gachi.Retrofit.Overlay
    Gachi.Retrofit.QualityGate
    Gachi.Retrofit.Report
    Gachi.Retrofit.Types
  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
    ScopedTypeVariables
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    bytestring >= 0.10,
    text >= 2.0,
    containers >= 0.6,
    directory >= 1.3,
    filepath >= 1.4,
    process >= 1.6,
    gachi-core >= 0.1,
    gachi-schema >= 0.1,
    gachi-scaffold >= 0.1,
    gachi-sync >= 0.1

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  default-extensions:
    OverloadedStrings
    DerivingStrategies
    ScopedTypeVariables
  ghc-options:
    -Wall
    -Wcompat
    -Wredundant-constraints
    -threaded
  build-depends:
    base >= 4.14 && < 5,
    gachi-retrofit,
    gachi-core,
    gachi-schema,
    gachi-scaffold,
    gachi-sync,
    bytestring >= 0.10,
    text >= 2.0,
    containers >= 0.6,
    directory >= 1.3,
    filepath >= 1.4,
    process >= 1.6,
    time >= 1.9,
    hspec >= 2.10
