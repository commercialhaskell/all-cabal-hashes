cabal-version: 3.0
name: gargamelle-equational
version: 0.1.0.0
synopsis: Equational logic institution and presheaf DPO rewriting for Gargamelle
description:
  Equational logic institution and presheaf double-pushout (DPO)
  categorical rewriting engine for Gargamelle. Provides algebraic term
  rewriting, confluence checking, and categorical rule composition.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Logic
homepage: https://github.com/NadiaYvette/gargamelle
bug-reports: https://github.com/NadiaYvette/gargamelle/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with:
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/gargamelle
  subdir: packages/gargamelle-equational

library
  exposed-modules:
    Equational
    Gargamelle.Equational.DPO
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat
  build-depends:
    base >= 4.18 && < 5,
    containers >= 0.6 && < 0.9,
    proarrow >= 0.2 && < 0.3,
    gargamelle-core >= 0.1 && < 0.2

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.18 && < 5,
    containers >= 0.6 && < 0.9,
    proarrow >= 0.2 && < 0.3,
    gargamelle-equational,
    gargamelle-core >= 0.1 && < 0.2,
    hspec >= 2.10 && < 2.12
