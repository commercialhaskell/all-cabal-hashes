cabal-version: 3.0
name:          gb-sprite
version:       0.5.1.0
stability:     experimental
synopsis:      Pure Haskell 2D raster graphics engine
description:
  A pure Haskell 2D raster graphics engine for procedurally
  generating sprites, animations, and visual effects. Drawing
  primitives, transforms, compositing with blend modes, image
  filters, procedural noise, isometric projection, sprite sheets,
  bitmap text, color grading, and dithering — no external image
  libraries. Export to BMP and PNG natively.

license:       BSD-3-Clause
license-file:  LICENSE
author:        Devon Tomlin
maintainer:    devon.tomlin@novavero.ai
category:      Graphics
build-type:    Simple
tested-with:   GHC ==9.8.4
extra-doc-files: README.md CHANGELOG.md
homepage:      https://github.com/Gondola-Bros-Entertainment/gb-sprite
bug-reports:   https://github.com/Gondola-Bros-Entertainment/gb-sprite/issues

source-repository head
  type:     git
  location: https://github.com/Gondola-Bros-Entertainment/gb-sprite.git

library
  exposed-modules:
    GBSprite.Adjust
    GBSprite.Animation
    GBSprite.BMP
    GBSprite.Canvas
    GBSprite.Color
    GBSprite.Compose
    GBSprite.Dither
    GBSprite.Draw
    GBSprite.Export
    GBSprite.Filter
    GBSprite.Gradient
    GBSprite.Import
    GBSprite.Isometric
    GBSprite.NineSlice
    GBSprite.Noise
    GBSprite.Palette
    GBSprite.PNG
    GBSprite.Sheet
    GBSprite.Sprite
    GBSprite.Text
    GBSprite.Tilemap
    GBSprite.Transform
    GBSprite.VFX

  hs-source-dirs:  src
  build-depends:
    base        >=4.18 && <5,
    bytestring  >=0.11 && <0.13,
    zlib        >=0.6  && <0.8

  default-language: Haskell2010
  ghc-options:      -Wall -Wcompat
  default-extensions:
    BangPatterns

test-suite gb-sprite-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  build-depends:
    base        >=4.18 && <5,
    bytestring  >=0.11 && <0.13,
    directory   >=1.3  && <1.4,
    gb-sprite

  default-language: Haskell2010
  ghc-options:      -Wall -Wcompat
  default-extensions:
    BangPatterns
