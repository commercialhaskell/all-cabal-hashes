cabal-version: 3.0
name: gargamelle-model
version: 0.1.0.0
synopsis: Runtime models and proof-carrying satisfaction for Gargamelle
description:
  Observable runtime models, free verifier ASTs, and proof-carrying
  satisfaction structures for Gargamelle. Provides functorial state
  interpretation, satisfaction testing, and categorical model
  validation.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Logic
homepage: https://github.com/NadiaYvette/gargamelle
bug-reports: https://github.com/NadiaYvette/gargamelle/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with:
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/gargamelle
  subdir: packages/gargamelle-model

library
  exposed-modules:
    Gargamelle.Model.Satisfaction
    Gargamelle.Model.Structure
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.18 && < 5,
    containers >= 0.6 && < 0.9,
    contravariant >= 1.5 && < 1.6,
    profunctors >= 5.6 && < 5.7,
    indexed-profunctors >= 0.1 && < 0.2,
    constraints >= 0.14 && < 0.15,
    lattices >= 2.2 && < 2.3,
    polytropos-core >= 0.1.0.1 && < 0.2,
    gargamelle-logic >= 0.1 && < 0.2

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.18 && < 5,
    gargamelle-model,
    gargamelle-logic >= 0.1 && < 0.2,
    polytropos-core >= 0.1.0.1 && < 0.2,
    contravariant >= 1.5 && < 1.6,
    lattices >= 2.2 && < 2.3,
    hspec >= 2.10 && < 2.12
