cabal-version:      2.2
name:               sauna-vs-gym-cost
version:            0.1.0
synopsis:           Cost-per-session math for home recovery gear
description:
  A home sauna or cold plunge is a gear price, a usage habit, and an
  electricity line. These functions spread the gear price over the
  sessions a habit accrues, add the electricity per session,
  and count the visits until the gear beats a per-visit alternative
  like a gym membership. The break-even count goes infinite when the
  alternative costs less than the electricity alone.
  .
  Companion to HackedSelf, which prices home recovery gear by
  cost-per-session math. Three pure functions on Doubles, no
  dependencies beyond base.
license:            MIT
author:             Poket Dev
maintainer:         hello@poketdev.com
homepage:           https://hackedself.com
bug-reports:        https://github.com/scrapertweeter3-prog/sauna-vs-gym-cost-hs/issues
copyright:          2026 Poket Dev LLC
category:           Math
build-type:         Simple
extra-doc-files:    README.md
                  , CHANGELOG.md

source-repository head
  type:     git
  location: https://github.com/scrapertweeter3-prog/sauna-vs-gym-cost-hs

library
  exposed-modules:  SaunaVsGym.Cost
  hs-source-dirs:   src
  build-depends:    base >=4 && <5
  default-language: Haskell2010
  ghc-options:      -Wall
