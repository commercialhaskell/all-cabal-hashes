cabal-version: 3.0
name: hoare
synopsis: Simple tools for communicating sequential processes
description:
    Hoare was right—many concurrent programs can be simply expressed
    as a series of concurrent actors (threads) consuming and producing
    messages. Haskell provides uniquely great tools (green threads and STM)
    for doing so. This package provides:

    - Functions for using bounded STM types like
      `TBQueue` and `TMVar` as /channels/ between threads.

    - A /closeable/ @TBCQueue@ and @TCSlot@ for programs where the input ends.

    - A "split" API on top of the above, using newtypes to distinguish
      the producer side from the consumer side.

    - Some wrappers to gather metrics (items produced/consumed, wait times).
      This API is experimental and unstable.
version: 0.2.0.0
license: Zlib
license-file: LICENSE.txt
author: Matt Kline
maintainer: matt@bitbashing.io
category: Concurrency
build-type: Simple
tested-with: GHC==9.12.4

source-repository head
    type:     git
    location: https://github.com/mrkline/hoare

common shared
    ghc-options: -Weverything
                 -Wno-all-missed-specialisations
                 -Wno-implicit-prelude
                 -Wno-missed-specialisations
                 -Wno-missing-export-lists
                 -Wno-missing-import-lists
                 -Wno-missing-kind-signatures
                 -Wno-missing-local-signatures
                 -Wno-missing-poly-kind-signatures
                 -Wno-missing-role-annotations
                 -Wno-missing-safe-haskell-mode
                 -Wno-safe
                 -Wno-type-defaults
                 -Wno-unsafe
                 -threaded
                 -fno-ignore-asserts
    default-language: GHC2024
    default-extensions: OverloadedRecordDot

library
    import: shared
    exposed-modules: Control.Concurrent.Channel
                     Control.Concurrent.Channel.Endless
                     Control.Concurrent.Channel.Endless.Split
                     Control.Concurrent.Channel.Metrics
                     Control.Concurrent.Channel.Overwrite
                     Control.Concurrent.Channel.Split
                     Control.Concurrent.Channel.Try
                     Control.Concurrent.TBCQueue
                     Control.Concurrent.TCSlot

    hs-source-dirs: lib
    build-depends: base >=4.20 && < 5,
                   async >= 2.2 && < 3,
                   clock >= 0.8.4 && < 0.9,
                   deepseq >= 1.5 && < 2,
                   stm >= 2.5 && < 3,
