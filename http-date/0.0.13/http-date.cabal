cabal-version:      2.0
name:               http-date
version:            0.0.13
license:            BSD3
license-file:       LICENSE
maintainer:         Kazu Yamamoto <kazu@iij.ad.jp>
author:             Kazu Yamamoto <kazu@iij.ad.jp>
tested-with:        GHC ==9.2 || ==9.4 || ==9.6 || ==9.8 || ==9.10 || ==9.12
synopsis:           HTTP Date parser/formatter
description:        Fast parser and formatter for HTTP Date
category:           Network, Web
build-type:         Simple
extra-doc-files:    ChangeLog.md

source-repository head
    type:     git
    location: https://github.com/kazu-yamamoto/http-date.git

library
    exposed-modules:  Network.HTTP.Date
    other-modules:
        Network.HTTP.Date.Converter
        Network.HTTP.Date.Formatter
        Network.HTTP.Date.Types
        Network.HTTP.Date.Parser

    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base >=4.16 && <5,
        attoparsec >=0.13 && <0.15,
        bytestring >=0.11 && <0.13,
        time >=1.11 && <1.17

test-suite spec
    type:               exitcode-stdio-1.0
    main-is:            Spec.hs
    build-tool-depends: hspec-discover:hspec-discover
    hs-source-dirs:     test
    other-modules:
        DateSpec
        Model

    default-language:   Haskell2010
    ghc-options:        -Wall
    build-depends:
        base,
        bytestring,
        hspec,
        http-date,
        time

benchmark bench
    type:             exitcode-stdio-1.0
    main-is:          Bench.hs
    hs-source-dirs:   bench test
    other-modules:    Model
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base,
        bytestring,
        criterion,
        http-date,
        time
