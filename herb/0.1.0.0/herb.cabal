cabal-version:   3.0
name:            herb
version:         0.1.0.0
synopsis:        Accessible format for structured data serialization
description:
  Serialization of data structures to a Prolog-like Herbrandt-universum-style
  universal format, useful for type-tagged things and various intermediate
  representations of program code. The text representation is very simple,
  allowing interoperability with various minimalistic programming systems.

homepage:        https://gitlab.com/exaexa/herb
bug-reports:     https://gitlab.com/exaexa/herb/-/issues
license:         BSD-2-Clause
license-file:    LICENSE
author:          Mirek Kratochvil
maintainer:      Mirek Kratochvil <exa.exa@gmail.com>
copyright:       (c) 2024-2025 Mirek Kratochvil
category:        Text, Serialization
build-type:      Simple
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://gitlab.com/exaexa/herb.git

common warnings
  ghc-options: -Wall

library
  import:           warnings
  exposed-modules:
    Data.Herb
    Data.Herb.Instances
    Data.Herb.Parser
    Data.Herb.Pretty

  build-depends:
    , attoparsec  ^>=0.14
    , base        >=4.17  && <4.22
    , pretty      ^>=1.1
    , text        >=2     && <2.2

  hs-source-dirs:   .
  default-language: Haskell2010

executable herb-format
  import:           warnings
  main-is:          Main.hs
  autogen-modules:  Paths_herb
  other-modules:    Paths_herb
  build-depends:
    , base                  >=4.17 && <4.22
    , herb
    , optparse-applicative  >=0.17 && <0.19
    , pretty                ^>=1.1
    , text                  >=2    && <2.2

  hs-source-dirs:   herb-format
  default-language: Haskell2010

test-suite test
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  default-language: Haskell2010
  build-depends:
    , base        >=4.17   && <4.22
    , herb
    , hspec       >=2.10   && <3
    , QuickCheck  >=2.14.0
