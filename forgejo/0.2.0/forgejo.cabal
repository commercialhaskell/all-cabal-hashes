cabal-version:       2.2
name:                forgejo
version:             0.2.0
synopsis:            forgejo query library and cli
description:
        A simple Forgejo/Gitea forge query library and cli tool.
license:             BSD-3-Clause
license-file:        LICENSE
author:              Jens Petersen <juhpetersen@gmail.com>
maintainer:          Jens Petersen <juhpetersen@gmail.com>
copyright:           2026  Jens Petersen <juhpetersen@gmail.com>
category:            Web
homepage:            https://github.com/juhp/forgejo-hs
bug-reports:         https://github.com/juhp/forgejo-hs/issues
build-type:          Simple
extra-doc-files:     README.md
                     ChangeLog.md
tested-with:         GHC == 8.10.7
                      || == 9.0.2
                      || == 9.2.8
                      || == 9.4.8
                      || == 9.6.7
                      || == 9.8.4
                      || == 9.10.3
                      || == 9.12.4

source-repository head
  type:                git
  location:            https://github.com/juhp/forgejo-hs.git

executable forgejo-tool
  main-is:             Main.hs
  other-modules:       Paths_forgejo
  autogen-modules:     Paths_forgejo
  hs-source-dirs:      app
  build-depends:       base < 5,
                       forgejo,
                       simple-cmd >= 0.1.4,
                       simple-cmd-args,
                       text
  default-language:    Haskell2010
  ghc-options:         -Wall
  if impl(ghc >= 8.0)
    ghc-options:       -Wcompat
                       -Widentities
                       -Wincomplete-uni-patterns
                       -Wincomplete-record-updates
                       -Wredundant-constraints
  if impl(ghc >= 8.2)
    ghc-options:       -fhide-source-paths
  if impl(ghc >= 8.4)
    ghc-options:       -Wmissing-export-lists
                       -Wpartial-fields
  if impl(ghc >= 8.10)
    ghc-options:       -Wunused-packages

library
  build-depends:       base < 5,
                       bytestring,
                       extra,
                       gitea-api,
                       http-client,
                       http-client-tls,
                       text
  default-language:    Haskell2010
  exposed-modules:     Gitea.Forgejo
  hs-source-dirs:      src

  ghc-options:         -Wall
  if impl(ghc >= 8.0)
    ghc-options:       -Wcompat
                       -Widentities
                       -Wincomplete-uni-patterns
                       -Wincomplete-record-updates
                       -Wredundant-constraints
  if impl(ghc >= 8.2)
    ghc-options:       -fhide-source-paths
  if impl(ghc >= 8.4)
    ghc-options:       -Wmissing-export-lists
                       -Wpartial-fields
  if impl(ghc >= 8.10)
    ghc-options:       -Wunused-packages
