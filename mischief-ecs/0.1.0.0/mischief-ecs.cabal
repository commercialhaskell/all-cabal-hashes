  -- Import common warning flags.
  import: warnings
  -- Modules exported by the library.
  exposed-modules:
    Mischief.ECS
    Mischief.ECS.App
    Mischief.ECS.App.Plugins
    Mischief.ECS.App.Schedules
    Mischief.ECS.App.SystemConfig
