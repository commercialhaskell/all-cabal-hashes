cabal-version:   3.12
name:            streamly-network-tls
version:         0.1.0.0
synopsis:        TLS connections as Streamly streams
description:
  TLS for Streamly, over the tls package, for clients and for servers: a
  connection whose received bytes are a stream of arrays, and whose sent
  bytes go through a function or a fold. A client checks the server
  against the certificates of the system, or against certificates of your
  own; a server presents its certificate. It knows nothing of the
  protocols carried: a connection gives a transport, for streamly-http
  (HTTPS), for streamly-websockets (secure WebSockets) or for anything
  else.

homepage:        https://github.com/GuillaumedeVolpiano/streamly-network-tls
license:         BSD-3-Clause
license-file:    LICENSE
author:          Xavier Dectot
maintainer:      Xavier Dectot <xavier@wheredoibegin.fr>
category:        Network, Streamly
build-type:      Simple
tested-with:     GHC ==9.8.4 || ==9.10.3 || ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  test/fixtures/README.md
  test/fixtures/localhost-cert.pem
  test/fixtures/localhost-key.pem

source-repository head
  type:     git
  location: https://github.com/GuillaumedeVolpiano/streamly-network-tls.git

common shared
  default-language:   GHC2021
  default-extensions:
    DataKinds
    DerivingStrategies
    DisambiguateRecordFields
    DuplicateRecordFields
    ExplicitNamespaces
    GADTs
    LambdaCase
    MonoLocalBinds
    NoFieldSelectors
    OverloadedRecordDot
    OverloadedStrings
    RoleAnnotations

  ghc-options:
    -Wall -Wcompat -Wredundant-constraints -Wmissing-deriving-strategies
    -Wunused-packages

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Streamly.External.Network.TLS
  build-depends:
    , base                 >=4.19 && <4.22
    , bytestring           ^>=0.12
    , crypton-x509-store   ^>=1.10
    , crypton-x509-system  ^>=1.10
    , network              ^>=3.2
    , streamly-bytestring  ^>=0.2.3
    , streamly-core        ^>=0.3.3
    , streamly-network-tcp ^>=0.1
    , tls                  ^>=2.5

test-suite streamly-network-tls-test
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , async                 ^>=2.2
    , base
    , bytestring
    , network
    , streamly-bytestring
    , streamly-core
    , streamly-network-tls
    , tasty                 ^>=1.5
    , tasty-hunit           ^>=0.10
    , tls
