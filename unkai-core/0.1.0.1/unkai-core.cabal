cabal-version: 3.12
name: unkai-core
version: 0.1.0.1
synopsis: Core data types and functionality for Unkai libraries.
description:
  Core data types, functionality and serialisation primitives shared by
  the generated Unkai Google Cloud service libraries.
  .
  The external interface of this library is stable with respect to the
  downstream Unkai libraries only, and is not intended for use outside them.

homepage: https://github.com/shinzui/unkai
bug-reports: https://github.com/shinzui/unkai/issues
license: MPL-2.0
license-file: LICENSE
author: Brendan Hay, Nadeem Bitar
maintainer: Nadeem Bitar <nadeem@gmail.com>
copyright: Copyright (c) 2015-2025 Brendan Hay, (c) 2026 Nadeem Bitar
category: Google
build-type: Simple
tested-with: ghc ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/shinzui/unkai.git
  subdir: lib/unkai-core

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wredundant-constraints
    -Wunused-packages
    -Wmissing-export-lists
    -Wpartial-fields
    -Wmissing-deriving-strategies
    -fhide-source-paths
    -funbox-strict-fields

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    Unkai.Data.Base64
    Unkai.Data.JSON
    Unkai.Data.Time
    Unkai.Prelude
    Unkai.Types

  build-depends:
    aeson ^>=2.2,
    attoparsec ^>=0.14,
    base >=4.21 && <5,
    base64 ^>=1.0,
    bytestring ^>=0.12,
    case-insensitive ^>=1.2,
    dlist ^>=1.0,
    exceptions ^>=0.10,
    hashable >=1.4 && <1.6,
    http-api-data ^>=0.6,
    http-client ^>=0.7,
    http-media ^>=0.8,
    http-types ^>=0.12,
    lens ^>=5.3,
    resourcet ^>=1.3,
    scientific ^>=0.3,
    servant ^>=0.20.1,
    streamly-core ^>=0.3,
    text ^>=2.1,
    time >=1.12 && <1.15,
    unordered-containers ^>=0.2.20,

test-suite unkai-core-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    aeson,
    base >=4.21 && <5,
    tasty ^>=1.5,
    tasty-hunit,
    text,
    unkai-core,
