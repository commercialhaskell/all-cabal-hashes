cabal-version: 3.12
name: clickhouse-migrate-cli
version: 0.1.0.0
synopsis: Reusable administrative CLI for ClickHouse migrations
description:
  Reusable administrative CLI for ClickHouse migrations.
  Application-owned configuration, coordination, rendering and exit policy.

license: BSD-3-Clause
license-file: LICENSE
author: shinzui
maintainer: shinzui@users.noreply.github.com
category: Database
build-type: Simple
extra-doc-files:
  CHANGELOG.md
  README.md

data-files: test/golden/*.json
tested-with: ghc ==9.12.4

source-repository head
  type: git
  location: https://github.com/shinzui/clickhouse-migrate.git
  subdir: clickhouse-migrate-cli

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall
    -Werror=incomplete-patterns

  build-depends:
    aeson >=2.2.4.1 && <2.4,
    base >=4.21 && <4.22,
    bytestring >=0.12.2 && <0.13,
    clickhouse-migrate ==0.1.*,
    containers >=0.7 && <0.9,
    optparse-applicative >=0.18.1 && <0.20,
    text >=2.1 && <2.2,

library
  import: common
  hs-source-dirs: src
  exposed-modules:
    ClickHouseMigrate.CLI
    ClickHouseMigrate.CLI.AdoptionFile
    ClickHouseMigrate.CLI.Handler
    ClickHouseMigrate.CLI.Parser
    ClickHouseMigrate.CLI.Render.Json
    ClickHouseMigrate.CLI.Render.Text
    ClickHouseMigrate.CLI.Types

test-suite clickhouse-migrate-cli-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends: clickhouse-migrate-cli
  other-modules: Paths_clickhouse_migrate_cli
  autogen-modules: Paths_clickhouse_migrate_cli
