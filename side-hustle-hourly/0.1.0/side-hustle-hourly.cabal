cabal-version:      2.2
name:               side-hustle-hourly
version:            0.1.0
synopsis:           True hourly rate math for side hustles and gig work
description:
  The rate a gig actually pays: the platform cut and job costs come off
  the gross first, and the net divides by hours that include the unpaid
  admin work around the paid ones. Two gigs compare on that rate, and
  the gap between them is the per-hour price of picking the wrong one.
  .
  Companion to Extra Hustles, which prices gig work by its effective
  hourly rate after hidden costs. Three pure functions on Doubles, no
  dependencies beyond base.
license:            MIT
author:             Poket Dev
maintainer:         hello@poketdev.com
homepage:           https://extrahustles.com
bug-reports:        https://github.com/scrapertweeter3-prog/side-hustle-hourly-hs/issues
copyright:          2026 Poket Dev LLC
category:           Math
build-type:         Simple
extra-doc-files:    README.md
                  , CHANGELOG.md

source-repository head
  type:     git
  location: https://github.com/scrapertweeter3-prog/side-hustle-hourly-hs

library
  exposed-modules:  SideHustle.Hourly
  hs-source-dirs:   src
  build-depends:    base >=4 && <5
  default-language: Haskell2010
  ghc-options:      -Wall
