source-repository head
  type: git
  location: https://gitlab.com/dpwiz/box-nd

flag assertions
  description: Keep the engine's internal assertions. A failed one stops the process with a trap.
  manual: True
  default: False

flag double-precision
  description: Store world positions as doubles (the engine's large world mode). Every package in a build shares this setting.
  manual: True
  default: False

