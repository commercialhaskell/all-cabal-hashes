    main-is:          Main.hs
    other-modules:
        Test.IR.Pretty
        Test.IR.Builder
        Test.EDSL.Ops
        Test.ModuleBuilder
        Test.Autograd.Grad
        Test.Autograd.Rules
        Test.Runtime.EndToEnd
