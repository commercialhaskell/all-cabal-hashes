cabal-version:      3.0
name:               sqitch-plan
version:            0.1.0.0
synopsis:           Parse and render sqitch.plan files
description:
  A parser and renderer for the plan files of
  <https://sqitch.org sqitch>, the database change manager. It reads the
  whole format (pragmas, changes with dependencies, tags, notes, comments
  and reworks), keeps each entry's line number, and writes a parsed plan
  back byte for byte.

homepage:           https://github.com/kronor-io/sqitch-plan
bug-reports:        https://github.com/kronor-io/sqitch-plan/issues
license:            MIT
license-file:       LICENSE
author:             José Lorenzo Rodríguez
maintainer:         lorenzo@kronor.io
copyright:          2026 Kronor
category:           Database
build-type:         Simple
tested-with:        GHC ==9.10.3 || ==9.12.4 || ==9.14.1
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  test/fixtures/*.changes
  test/fixtures/*.plan
  test/fixtures/*.tags

source-repository head
  type:     git
  location: https://github.com/kronor-io/sqitch-plan

-- The package sets its own extensions and warnings rather than relying on
-- a cabal.project to supply them.
common language
  default-language:   GHC2024
  default-extensions:
    BlockArguments
    DuplicateRecordFields
    LambdaCase
    OverloadedRecordDot
    OverloadedStrings

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
    -Wunused-packages

library
  import:          language
  hs-source-dirs:  src
  exposed-modules:
    Sqitch.Plan
    Sqitch.Plan.Parse
    Sqitch.Plan.Render
    Sqitch.Plan.Types

  build-depends:
    , base        >=4.20 && <5
    , containers  >=0.6  && <0.9
    , text        >=2.0  && <2.2
    , time        >=1.12 && <1.16

test-suite sqitch-plan-test
  import:         language
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  other-modules:  Properties
  build-depends:
    , base
    , hedgehog        >=1.4  && <1.8
    , process         >=1.6  && <1.7
    , sqitch-plan
    , tasty           >=1.4  && <1.6
    , tasty-hedgehog  >=1.4  && <1.5
    , tasty-hunit     >=0.10 && <0.11
    , text
    , time
