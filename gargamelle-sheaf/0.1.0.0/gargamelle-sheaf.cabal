cabal-version: 3.0
name: gargamelle-sheaf
version: 0.1.0.0
synopsis: Cellular sheaves and Store comonad diffusion for fault localization
description:
  Cellular sheaves, Store comonad diffusion, and homological fault
  localization for Gargamelle. Provides cell complexes, sheaf cohomology,
  harmonic diffusion, and algebraic topology algorithms for invariant
  localization.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Math
homepage: https://github.com/NadiaYvette/gargamelle
bug-reports: https://github.com/NadiaYvette/gargamelle/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with:
  GHC == 9.6.7,
  GHC == 9.8.4,
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/gargamelle
  subdir: packages/gargamelle-sheaf

library
  exposed-modules:
    Gargamelle.Sheaf
    Gargamelle.Sheaf.Complex
    Gargamelle.Sheaf.Diffusion
    Gargamelle.Sheaf.Cohomology
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.18 && < 5,
    containers >= 0.6 && < 0.9,
    comonad >= 5.0 && < 5.1,
    lattices >= 2.2 && < 2.3,
    profunctors >= 5.6 && < 5.7,
    gargamelle-logic >= 0.1 && < 0.2,
    gargamelle-model >= 0.1 && < 0.2,
    gargamelle-core >= 0.1 && < 0.2,
    proarrow >= 0.2 && < 0.3

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.18 && < 5,
    gargamelle-sheaf,
    gargamelle-logic >= 0.1 && < 0.2,
    gargamelle-model >= 0.1 && < 0.2,
    gargamelle-core >= 0.1 && < 0.2,
    containers >= 0.6 && < 0.9,
    lattices >= 2.2 && < 2.3,
    comonad >= 5.0 && < 5.1,
    proarrow >= 0.2 && < 0.3,
    hspec >= 2.10 && < 2.12
