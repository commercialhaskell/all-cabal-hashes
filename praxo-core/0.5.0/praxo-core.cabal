cabal-version: 2.4
name: praxo-core
version: 0.5.0
synopsis: Embeddable MIT-licensed agent framework for Haskell
description: Native agent loop with tools, policy hooks, typed events, memory,
             checkpoints, context budgets, middleware, JSON Schema validation,
             and plugin manifest parsing for the PRAXO-CORE agent framework.
category: Development
maintainer: AxisVela <releases@axisvela.com>
homepage: https://axisvela.github.io/praxo-core/
bug-reports: https://github.com/axisvela/praxo-core/issues
license: MIT
license-file: LICENSE
author: AxisVela
build-type: Simple
extra-source-files: README.md, REGISTRY.md, llms.txt, llms.md, SETUP.md,
                    api/0.1.0.txt, api/0.2.0.txt, run-tests.py, api-snapshot.py

source-repository head
  type: git
  location: https://github.com/axisvela/praxo-core

library
  hs-source-dirs: src
  exposed-modules: Praxo.Agent, Praxo.Json, Praxo.ToolCall, Praxo.JsonSchema, Praxo.Pattern, Praxo.Plugin, Praxo.Runtime, Praxo.Middleware, Praxo.Wire, Praxo.OpenAICompatible, Praxo.Anthropic, Praxo.Gemini, Praxo.Harmovela, Praxo.Mcp, Praxo.Otel, Praxo.Retriever, Praxo.Delegation
  build-depends: base >=4.14 && <5, containers >=0.6 && <0.9
  default-language: Haskell2010
  ghc-options: -Wall

executable praxo-haskell-conformance
  hs-source-dirs: conformance
  main-is: Main.hs
  build-depends: base >=4.14 && <5, praxo-core
  default-language: Haskell2010
  ghc-options: -Wall

test-suite wire-tests
  type: exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is: Main.hs
  build-depends: base >=4.14 && <5, praxo-core
  default-language: Haskell2010
  ghc-options: -Wall
