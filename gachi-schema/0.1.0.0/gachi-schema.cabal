cabal-version: 3.0
name: gachi-schema
version: 0.1.0.0
synopsis: Declarative Dhall schemas and polytropos-dhall deserializers for Gachi
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
build-type: Simple
tested-with:
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

library
  exposed-modules:
    Gachi.Schema
    Gachi.Schema.Project
    Gachi.Schema.Dhall
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    gachi-core >= 0.1 && < 0.2,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-dhall >= 0.1 && < 0.2,
    dhall >= 1.42 && < 1.43,
    text >= 2.0,
    containers >= 0.6

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    gachi-core,
    gachi-schema,
    polytropos-core,
    polytropos-dhall,
    dhall,
    text >= 2.0,
    containers >= 0.6,
    hspec >= 2.10
