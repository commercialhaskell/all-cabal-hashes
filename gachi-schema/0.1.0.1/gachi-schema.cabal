cabal-version: 3.0
name: gachi-schema
version: 0.1.0.1
synopsis: Declarative Dhall schemas and polytropos-dhall deserializers for Gachi
description:
  Declarative Dhall schemas, project configuration models, and
  polytropos-dhall deserializers for Gachi. Provides schema validation,
  typed project manifests, and standardization configuration loaders.
license: EUPL-1.2
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Development
homepage: https://github.com/NadiaYvette/gachi
bug-reports: https://github.com/NadiaYvette/gachi/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with:
  GHC == 9.10.3,
  GHC == 9.12.4,
  GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/gachi
  subdir: packages/gachi-schema

library
  exposed-modules:
    Gachi.Schema
    Gachi.Schema.Project
    Gachi.Schema.Dhall
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    gachi-core >= 0.1 && < 0.2,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-dhall >= 0.1 && < 0.2,
    dhall >= 1.42 && < 1.43,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    gachi-core,
    gachi-schema,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-dhall >= 0.1 && < 0.2,
    dhall >= 1.42 && < 1.43,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    hspec >= 2.10 && < 2.12
