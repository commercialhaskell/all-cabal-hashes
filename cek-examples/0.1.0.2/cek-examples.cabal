cabal-version: 3.0
name: cek-examples
version: 0.1.0.2
synopsis: Umbrella showcase suite of mini-interpreters for CEK abstract machines
description:
  Showcase mini-interpreters (Scheme, Prolog/Mercury, 1ML) demonstrating
  automatic Generic1 dissection, O(1) continuation capture, and MergeMorph3 sealing.

  Notice: This umbrella package aggregates the standalone example packages
  @cek-scheme@, @cek-mercury@, and @cek-oneml@ for testing and demonstration.
license: EUPL-1.2 OR Apache-2.0
license-file: LICENSE
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Language, Compilers/Interpreters
homepage: https://github.com/NadiaYvette/cek
bug-reports: https://github.com/NadiaYvette/cek/issues
extra-doc-files:
  README.md
  CHANGELOG.md
build-type: Simple
tested-with: GHC == 9.14.1

source-repository head
  type: git
  location: https://github.com/NadiaYvette/cek
  subdir: packages/cek-examples

library
  reexported-modules:
    Cek.Scheme,
    Cek.Mercury,
    Cek.OneML,
    Cek.Examples.Scheme,
    Cek.Examples.Mercury,
    Cek.Examples.OneML
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.18 && < 5,
    cek-scheme >= 0.1.0.0 && < 0.2,
    cek-mercury >= 0.1.0.0 && < 0.2,
    cek-oneml >= 0.1.0.0 && < 0.2

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints -threaded
  build-depends:
    base >= 4.18 && < 5,
    cek-core >= 0.1.0.0 && < 0.2,
    cek-pykinos >= 0.1.0.0 && < 0.2,
    pykinos-core >= 0.1.0.0 && < 0.2,
    cek-examples >= 0.1.0.0 && < 0.2,
    primitive >= 0.9 && < 0.10,
    hspec >= 2.10 && < 2.12
