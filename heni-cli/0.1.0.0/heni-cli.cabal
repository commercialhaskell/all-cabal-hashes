cabal-version: 3.4
name: heni-cli
version: 0.1.0.0
synopsis: Command line interface to trustworthy deliberate mutation testing
description:
  Validate manifests, run checked mutations, and render portable
  Heni evidence through the shared library runner.

homepage: https://github.com/shinzui/heni
bug-reports: https://github.com/shinzui/heni/issues
license: BSD-3-Clause
license-file: LICENSE
author: Nadeem Bitar
maintainer: nadeem@gmail.com
copyright: 2026 Nadeem Bitar
category: Testing
build-type: Simple
tested-with: ghc ==9.12.4
extra-doc-files:
  CHANGELOG.md
  README.md

data-files: test/corpus/*.json

source-repository head
  type: git
  location: https://github.com/shinzui/heni.git
  subdir: heni-cli

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options:
    -Wall
    -Wcompat

  build-depends:
    aeson >=2.3.2 && <2.4,
    base >=4.21.2 && <4.22,
    bytestring >=0.12.2 && <0.13,
    containers >=0.7 && <0.9,
    directory >=1.3.10.1 && <1.4,
    filepath >=1.5.5 && <1.6,
    heni ==0.1.0.0,
    text >=2.1.4 && <2.2,

executable heni
  import: common
  hs-source-dirs: app
  main-is: Main.hs
  other-modules:
    Heni.Cli
    Paths_heni_cli

  autogen-modules: Paths_heni_cli
  ghc-options: -threaded

test-suite heni-cli-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs:
    test
    app

  main-is: Main.hs
  other-modules:
    Heni.Cli
    Paths_heni_cli

  autogen-modules: Paths_heni_cli
  build-depends:
    process >=1.6.26.1 && <1.7,
    unix >=2.8.8 && <2.9,

  build-tool-depends:
    heni:heni-fixture,
    heni-cli:heni,

  ghc-options: -threaded
