cabal-version: 3.12
name: clickhouse-migrate-embed
version: 0.1.0.0
synopsis: Compile-time embedding for ClickHouse migration definitions
description:
  Compile-time embedding for ClickHouse migration definitions.
  Validated public APIs with explicit application-owned configuration and scope.

license: BSD-3-Clause
license-file: LICENSE
author: shinzui
maintainer: shinzui@users.noreply.github.com
category: Database
build-type: Simple
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  test/fixtures/*.cabal
  test/fixtures/*.hs
  test/fixtures/component/*.json
  test/fixtures/component/sql/*.sql
  test/scripts/*.py

tested-with: ghc ==9.12.4

source-repository head
  type: git
  location: https://github.com/shinzui/clickhouse-migrate.git
  subdir: clickhouse-migrate-embed

common common
  default-language: GHC2024
  default-extensions:
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

  ghc-options: -Wall
  build-depends:
    aeson >=2.2.4.1 && <2.4,
    base >=4.21 && <4.22,
    bytestring >=0.12.2 && <0.13,
    clickhouse-migrate ==0.1.*,
    containers >=0.7 && <0.9,
    directory >=1.3.10 && <1.4,
    filepath >=1.5.4 && <1.6,
    template-haskell >=2.23 && <2.24,
    text >=2.1 && <2.2,

library
  import: common
  hs-source-dirs: src
  exposed-modules: ClickHouseMigrate.Embed
  other-modules: ClickHouseMigrate.Embed.Manifest

test-suite clickhouse-migrate-embed-test
  import: common
  type: exitcode-stdio-1.0
  hs-source-dirs:
    test
    src

  main-is: Main.hs
  other-modules:
    ClickHouseMigrate.Embed
    ClickHouseMigrate.Embed.Manifest

executable clickhouse-migrate-embed-build
  import: common
  hs-source-dirs:
    build-driver
    src

  main-is: Main.hs
  other-modules: ClickHouseMigrate.Embed.Manifest
  build-depends:
    cryptohash-sha256 >=0.11.102.1 && <0.12,
    process >=1.6.25 && <1.7,
